// definitions needed when working with sequences

// computer the sum of all elements in a sequence recursively
function sum_rec(xs: Seq[Int]): Int 
  decreases |xs|
{  
  |xs| == 0
    ? 0
    : xs[0] + sum_rec(xs[1..])
}

// determines the maximum of two numbers
function max(a: Int, b: Int): Int
  decreases a, b
{
    a > b ? a : b
}

// determines the minimum of two numbers
function min(a: Int, b: Int): Int
  decreases a, b
{
  a < b ? a : b
}

// determines the minimum between three numbers
function min3(a: Int, b: Int, c: Int): Int
  decreases a, b, c
{
  min(min(a, b), c)
}
