    ensures MergeSort(xs) == MergeSort2(xs)
    decreases length(xs)
{
    let len == (length(xs)) in 
    xs.isNil ? unit()
                :
                (len >= 2) ? let splitL == (getLeft(Split(xs, length(xs) / 2))) in
                                let splitR == (getRight(Split(xs, length(xs) / 2))) in
