function lemmaMergeOrdered(xs: List[Int], ys: List[Int]): Unit
    requires Ordered(xs) && Ordered(ys)
    ensures Ordered(Merge(xs, ys))
    decreases xs, ys
{
    xs.isNil ? unit() 
        : 
