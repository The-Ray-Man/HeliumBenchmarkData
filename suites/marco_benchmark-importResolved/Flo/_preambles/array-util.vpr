// Copy a[src..src+len] to b[dst..dst+len]
method arr_copy(a: Array, b: Array, src: Int, dst: Int, len: Int)
  requires array_K(a) && array_K(b)
  requires 0 <= src && src <= src + len && src + len <= length(a)
  requires 0 <= dst && dst <= dst + len && dst + len <= length(b)
  ensures array_K(a) && array_K(b)
  ensures map_K_of_array(a) == old(map_K_of_array(a))
  ensures map_K_of_array(b) == map_K_copy(old(map_K_of_array(b)), map_K_of_array(a), src, dst, len)
/*{
