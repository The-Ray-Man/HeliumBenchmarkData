field val_K: IMap[Int,K]
define array_K(a)
  acc(array_rep(a).val_K)

define acc_K(a, i)
  acc(array_rep(a).val_K) && 0 <= i && i < length(a)

define unchanged_array_K(a)
  array_rep(a).val_K == old(array_rep(a).val_K)

function map_K_of_array(a: Array): IMap[Int,K]
  requires array_K(a)
  ensures result == array_rep(a).val_K

function read_K(a: Array, i: Int): K
  requires acc_K(a, i)
  ensures result == select(map_K_of_array(a), i)

method write_K(a: Array, i: Int, v: K)
  requires acc_K(a, i)
  ensures acc_K(a, i) && map_K_of_array(a) == store(old(map_K_of_array(a)), i, v)

function set_of_map_K(m: IMap[Int,K], i: Int, j: Int): Set[K] // removed postcondition (which called function recursively)
  requires i <= j
  ensures forall j1: Int :: i <= j1 && j1 < j ==> select(m, j1) in result
{
  i < j ? Set(select(m, i)) union set_of_map_K(m, i + 1, j) : Set()
}
