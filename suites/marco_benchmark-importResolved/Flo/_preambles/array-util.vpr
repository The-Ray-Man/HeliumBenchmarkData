      extend_right(m, i, j - 1);
      //assert sorted_Map_K_seg(m, i, j - 1);
      not_in_sorted_seg(m, i, j - 1, k);
    } else {
      if (lt(k, select(m, i))) {
        not_in_sorted_seg(m, i + 1, j, k);    
      }
    }
  }
}*/

function map_K_shift(m: IMap[Int,K], src: Int, dst: Int, len: Int): IMap[Int,K]
  ensures len <= 0 ? result == m : forall i: Int :: {select(result, i)} 
  //{select(m, i)} // matching loop: select(m,i) generates select(m, src + (i - dst))
    select(result, i) == (i < dst || dst + len <= i ? select(m, i) : select(m, src + (i - dst)))

