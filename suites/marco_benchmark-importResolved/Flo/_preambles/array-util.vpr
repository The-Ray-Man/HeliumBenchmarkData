method in_set_of_map_K_k(m: IMap[Int,K], i: Int, j: Int, k: Int)
  requires i <= j
  ensures i <= k && k < j ==> select(m, k) in set_of_map_K(m, i, j)
/*{
  if (i < j) {
    in_set_of_map_K_k(m, i + 1, j, k);
  }
}*/

method set_of_map_K_split(m: IMap[Int,K], i: Int, j: Int, k: Int)
  requires i <= j && j <= k
  ensures set_of_map_K(m, i, k) == set_of_map_K(m, i, j) union set_of_map_K(m, j, k)
/*{
  if (j < k) {
    extend_right(m, i, j);
    set_of_map_K_split(m, i, j + 1, k);
  }
}*/

method set_of_map_K_equal(m1: IMap[Int,K], m2: IMap[Int,K], i1: Int, i2: Int, len: Int)
  requires len >= 0
  requires forall j: Int :: {select(m1, j)} i1 <= j && j < i1 + len ==> select(m1, j) == select(m2, j + (i2 - i1))
  ensures set_of_map_K(m1, i1, i1 + len) == set_of_map_K(m2, i2, i2 + len)
/*{
  if (0 < len) {
    set_of_map_K_equal(m1, m2, i1 + 1, i2 + 1, len - 1);
  }
}*/

method frame_set_of_map_K(m: IMap[Int,K], i: Int, j: Int, i1: Int, k: K)
  requires i <= j
  ensures (i1 < i || j <= i1) ==> set_of_map_K(m, i, j) == set_of_map_K(store(m, i1, k), i, j)
/*{
  if (i < j) {
    frame_set_of_map_K(m, i + 1, j, i1, k);
  }
}*/

function sorted_Map_K_seg(m: IMap[Int,K], i: Int, j: Int): Bool
  ensures result == (forall i1: Int, i2: Int :: {select(m, i1), select(m, i2)}
    i <= i1 && i1 < i2 && i2 < j ==> lt(select(m, i1), select(m, i2)))



method not_in_sorted_seg(m: IMap[Int,K], i: Int, j: Int, k: K)
  requires sorted_Map_K_seg(m, i, j)
  ensures i > j || (lt(k, select(m, i)) || lt(select(m, j - 1), k) ==> !(k in set_of_map_K(m, i, j)))
/*{
