function map_K_copy(m1: IMap[Int,K], m2: IMap[Int,K], src: Int, dst: Int, len: Int): IMap[Int,K]
  ensures forall i: Int :: {select(result, i)} select(result, i) == (dst <= i && i < dst + len ? select(m2, src + (i - dst)) : select(m1, i))


define sorted_array_prefix(a, len)
  array_K(a) && 0 <= len && len <= length(a) && sorted_Map_K_seg(map_K_of_array(a), 0, len)

function set_of_array(a: Array, i: Int, j: Int): Set[K]
  requires i <= j
  requires array_K(a) && 0 <= i && j <= length(a)
  ensures result == set_of_map_K(map_K_of_array(a), i, j)


function map_K_find(m: IMap[Int,K], i: Int, j: Int, k: K): Int
  requires i <= j
  requires sorted_Map_K_seg(m, i, j)
  ensures i <= result && result <= j
  ensures select(m, result) == k || result == j || lt(k, select(m, result))
  ensures i < result ==> lt(select(m, result - 1), k)
  ensures result + 1 < j ==> lt(k, select(m, result + 1))
/*{
  i < j && lt(select(m, i), k) ? map_K_find(m, i + 1, j, k) : i
}*/

method map_K_find_content_set(m: IMap[Int,K], i: Int, j: Int, idx: Int, k: K)
  requires i <= j
  requires sorted_Map_K_seg(m, i, j)
  requires idx == map_K_find(m, i, j, k)
  ensures !(k in set_of_map_K(m, i, idx))
  ensures idx + 1 <= j ==> !(k in set_of_map_K(m, idx + 1, j))
/*{
