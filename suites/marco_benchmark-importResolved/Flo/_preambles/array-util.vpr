      invariant 0 <= dst && dst <= dst + len && dst + len <= length(a)
      invariant -1 <= i && i < len
      invariant MapEqual(map_Ref_shift(am, src + i + 1, dst + i + 1, len - i - 1), map_Ref_of_array(a))
