
domain List[T] {
  function nil() : List[T]
  function cons(t:T, l:List[T]) : List[T]
  // no injectivity/surjectivity needed? For now, the property below seems enough:

  function remove(l:List[T], t:T) : List[T]

  axiom remove_nils {
    forall t:T :: {remove(nil(),t)} remove(nil(),t) == nil()
  }

  axiom remove_cons {
    forall s:T, l:List[T], t:T :: {remove(cons(s,l),t)} remove(cons(s,l),t) == (s==t ? l : (cons(s,remove(l,t)) : List[T]))// note: we assume lists without duplicates / removal of first occurrence only
  }

  axiom diffconstructors {
      forall t:T, l:List[T] :: {cons(t,l)} nil() != cons(t,l)
  }
}
