method arr_init(a: Array, len: Int, k: K)
  requires array_K(a)
  requires 0 <= len && len <= length(a)
  ensures array_K(a)
  ensures forall i: Int :: {select(map_K_of_array(a), i)} 0 <= i && i < len ==> read_K(a, i) == k
