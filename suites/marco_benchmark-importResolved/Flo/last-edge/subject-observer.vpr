method map_K_delete_content_set(m: IMap[Int,K], m1: IMap[Int,K], len: Int, new_len: Int, idx: Int, k: K)
  requires 0 <= len
  requires sorted_Map_K_seg(m, 0, len)
  requires idx == map_K_find(m, 0, len, k)
  requires !(k in set_of_map_K(m, 0, len)) ==> new_len == len && m1 == m
  requires k in set_of_map_K(m, 0, len) ==> new_len == len - 1 && m1 == map_K_shift(m, idx + 1, idx, len - (idx + 1))
  ensures set_of_map_K(m1, 0, new_len) == set_of_map_K(m, 0, len) setminus Set(k)
