    invariant array_K(a) && array_K(b)
    invariant 0 <= i && i <= len
    invariant 0 <= src && src <= src + len && src + len <= length(a)
    invariant 0 <= dst && dst <= dst + len && dst + len <= length(b)
    invariant map_K_of_array(a) == ma
    invariant MapEqual(map_K_of_array(b), map_K_copy(mb, ma, src, dst, i))
  {
    var m1: IMap[Int,K] := map_K_of_array(b);
    var tmp: K := read_K(a, src + i);
    write_K(b, dst + i, tmp);
    assert MapEqual(map_K_of_array(b), store(m1, dst + i, tmp));
    i := i + 1;
  }
}*/

// Find key `k` in sorted array segment `a[0..len]` using binary search
method arr_find(a: Array, len: Int, k: K)
  returns (found: Bool, idx: Int)
  requires sorted_array_prefix(a, len)
  requires 0 <= len && len <= length(a)
  ensures sorted_array_prefix(a, len)
  ensures map_K_of_array(a) == old(map_K_of_array(a))
  // what we actually care about
  ensures idx == map_K_find(map_K_of_array(a), 0, len, k)
  ensures found == (k in set_of_map_K(map_K_of_array(a), 0, len))
/*{
  var am: IMap[Int,K] := map_K_of_array(a);
  var lo: Int := 0;
  var hi: Int := len;
  
  while (hi != lo)
    invariant sorted_array_prefix(a, len)
    invariant map_K_of_array(a) == am
    // what we actually care about
    invariant 0 <= lo && lo <= hi && hi <= len && len <= length(a)
    invariant hi == len || read_K(a, lo) == k || lt(k, read_K(a, hi))
    invariant 0 < lo ==> lt(read_K(a, lo - 1), k)
    invariant hi < len - 1 ==> lt(k, read_K(a, hi + 1))
  {
    var mid: Int := (hi + lo) / 2;
    var cmp: Int;
    cmp := compare(k, read_K(a, mid));
    if (cmp < 0) {
      hi := mid;      // look in first half
    } elseif (cmp > 0) {
      lo := mid + 1;    // look in second half
    } else {
      // found it
      hi := mid;
      lo := mid;
    }
  }
  
  idx := lo;
  
  found := idx != len && le(read_K(a, lo), k)

  map_K_find_in_set(map_K_of_array(a), 0, len, k);
}*/

// Given a sorted array segment `a[0..len]`,
// insert `k` into `a[0..len+1]` while preserving sortedness.
// If `k` is already contained in `a[0..len]`, then do not modify `a`.
method arr_insert(a: Array, k: K, len: Int)
  returns (idx: Int, new_len: Int)
  requires sorted_array_prefix(a, len)
  requires len < length(a)
  ensures sorted_array_prefix(a, new_len)
  ensures idx == map_K_find(old(map_K_of_array(a)), 0, len, k)
  ensures k in set_of_map_K(old(map_K_of_array(a)), 0, len) ==> new_len == len && map_K_of_array(a) == old(map_K_of_array(a))
  ensures !(k in set_of_map_K(old(map_K_of_array(a)), 0, len)) ==> new_len == len + 1
            && map_K_of_array(a) == store(map_K_shift(old(map_K_of_array(a)), idx, idx + 1, len - idx), idx, k)
  ensures read_K(a, idx) == k
/*{
  // find position for insertion
  var i: Int;
  var found: Bool;
  found, i := arr_find(a, len, k);

  map_K_find_in_set(map_K_of_array(a), 0, len, k);
  
  // k already in C?
  if (found) {
    new_len := len;
  } else {
  
    arr_shift(a, i, i + 1, len - i);

    var ms: IMap[Int,K] := map_K_of_array(a);
  
    write_K(a, i, k);

    new_len := len + 1;

  }
  idx := i;

}*/

// Given a sorted array segment `a[0..len]`,
// delete `k` from the segment while preserving sortedness.
// If `k` is already contained in `a[0..len]`, then do not modify `a`.
method arr_delete(a: Array, k: K, len: Int)
  returns (new_len: Int, idx: Int)
  requires sorted_array_prefix(a, len)
  requires len <= length(a)
  ensures sorted_array_prefix(a, new_len)
  ensures idx == map_K_find(old(map_K_of_array(a)), 0, len, k)
  ensures !(k in set_of_map_K(old(map_K_of_array(a)), 0, len)) ==> new_len == len && map_K_of_array(a) == old(map_K_of_array(a))
  ensures k in set_of_map_K(old(map_K_of_array(a)), 0, len) ==> new_len == len - 1
            && map_K_of_array(a) == map_K_shift(old(map_K_of_array(a)), idx + 1, idx, len - (idx + 1))
/*{
  // find position for insertion
  var found: Bool;
  found, idx := arr_find(a, len, k);

  map_K_find_in_set(map_K_of_array(a), 0, len, k);
  
  // k !in C?
  if (!found) {
    new_len := len;
  } else {
  
    // shift array entries a[i+1..len] by 1 entry to the left 
    arr_shift(a, idx + 1, idx, len - (idx + 1));
  
    new_len := len - 1;
  }
}*/


field val_Ref: IMap[Int,Ref]
define array_Ref(a)
  acc(array_rep(a).val_Ref)

define acc_Ref(a, i)
  acc(array_rep(a).val_Ref) && 0 <= i && i < length(a)


define unchanged_array_Ref(a)
  array_rep(a).val_Ref == old(array_rep(a).val_Ref)

function map_Ref_of_array(a: Array): IMap[Int,Ref]
  requires array_Ref(a)
  ensures result == array_rep(a).val_Ref

function read_Ref(a: Array, i: Int): Ref
  requires acc_Ref(a, i)
  ensures result == select(map_Ref_of_array(a), i)

method write_Ref(a: Array, i: Int, v: Ref)
  requires acc_Ref(a, i)
  ensures acc_Ref(a, i) && map_Ref_of_array(a) == store(old(map_Ref_of_array(a)), i, v)

function set_of_map_Ref(m: IMap[Int,Ref], i: Int, j: Int): Set[Ref]
  requires i <= j
//  ensures result == (i < j ? Set(select(m, i)) union set_of_map_Ref(m, i + 1, j) : Set())
{
  i < j ? Set(select(m, i)) union set_of_map_Ref(m, i + 1, j) : Set()
}

function map_Ref_shift(m: IMap[Int,Ref], src: Int, dst: Int, len: Int): IMap[Int,Ref]
  //ensures len <= 0 ? result == m : forall i: Int :: {select(result, i)} {select(m, i)} select(result, i) == (i < dst || dst + len <= i ? select(m, i) : select(m, src + (i - dst)))
         

function map_Ref_copy(m1: IMap[Int,Ref], m2: IMap[Int,Ref], src: Int, dst: Int, len: Int): IMap[Int,Ref]
  //ensures forall i: Int :: {select(result, i)} select(result, i) == (dst <= i && i < dst + len ? select(m2, src + (i - dst)) : select(m1, i))

// Shift a[src..src+len] to a[dst..dst+len]
method arr_shift_Ref(a: Array, src: Int, dst: Int, len: Int)
  requires array_Ref(a)
  requires 0 <= src && src <= src + len && src + len <= length(a) 
  requires 0 <= dst && dst <= dst + len && dst + len <= length(a)
  ensures array_Ref(a)
  ensures map_Ref_of_array(a) == map_Ref_shift(old(map_Ref_of_array(a)), src, dst, len)
/*{
  var am: IMap[Int,Ref] := map_Ref_of_array(a);
  if (src < dst) {
    var i: Int := len - 1;
    
    while (i >= 0) 
      invariant array_Ref(a)
      invariant src < dst
      invariant 0 <= src && src <= src + len && src + len <= length(a)
      invariant 0 <= dst && dst <= dst + len && dst + len <= length(a)
      invariant -1 <= i && i < len
      invariant MapEqual(map_Ref_shift(am, src + i + 1, dst + i + 1, len - i - 1), map_Ref_of_array(a))
    {
      var tmp: Ref := read_Ref(a, src + i);
      write_Ref(a, dst + i, tmp);
      i := i - 1;
    }
  } elseif (src > dst) {
    var i: Int := 0;
    while (i < len)
      invariant array_Ref(a)
      invariant src > dst
      invariant 0 <= src && src <= src + len && src + len <= length(a)
      invariant 0 <= dst && dst <= dst + len && dst + len <= length(a)
      invariant 0 <= i && i <= len 
      invariant MapEqual(map_Ref_shift(am, src, dst, i), map_Ref_of_array(a))
    {
      var tmp: Ref := read_Ref(a, src + i);
      write_Ref(a, dst + i, tmp);
      i := i + 1;
    }
  }
  assert MapEqual(map_Ref_of_array(a), map_Ref_shift(am, src, dst, len))
}*/
 
// Copy a[src..src+len] to b[dst..dst+len]
method arr_copy_Ref(a: Array, b: Array, src: Int, dst: Int, len: Int)
  requires array_Ref(a) && array_Ref(b)
  requires 0 <= src && src <= src + len && src + len <= length(a)
  requires 0 <= dst && dst <= dst + len && dst + len <= length(b)
  ensures array_Ref(a) && array_Ref(b)
  ensures map_Ref_of_array(a) == old(map_Ref_of_array(a))
  ensures map_Ref_of_array(b) == map_Ref_copy(old(map_Ref_of_array(b)), map_Ref_of_array(a), src, dst, len)
