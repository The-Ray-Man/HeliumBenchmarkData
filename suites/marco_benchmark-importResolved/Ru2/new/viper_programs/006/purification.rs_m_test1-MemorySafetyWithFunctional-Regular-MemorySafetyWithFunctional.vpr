  function destructor$Snap$Bool$$value(value: Snap$Bool): Bool 
  
  function snapshot_equality$Snap$Bool$(left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas): Bool 
  
  function valid$Snap$Bool(_0: Snap$Bool): Bool 
  
