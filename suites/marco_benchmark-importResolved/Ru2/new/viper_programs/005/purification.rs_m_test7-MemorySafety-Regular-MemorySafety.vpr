domain Snap$Bool  {
  
  function constructor$Snap$Bool$(value: Bool): Snap$Bool 
  
  function destructor$Snap$Bool$$value(value: Snap$Bool): Bool 
  
  function snapshot_equality$Snap$Bool$(left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas): Bool 
  
  function valid$Snap$Bool(_0: Snap$Bool): Bool 
  
  function to_bytes$Bool(snapshot: Snap$Bool): Bytes 
  
  function from_bytes$Bool(bytes: Bytes): Snap$Bool 
  
  function constructor$Snap$Bool$EqCmp_I32(left: Snap$I32, right: Snap$I32): Snap$Bool 
  
  function destructor$Snap$Bool$EqCmp_I32$left(value: Snap$Bool): Snap$I32 
  
  function destructor$Snap$Bool$EqCmp_I32$right(value: Snap$Bool): Snap$I32 
  
  function snapshot_equality$Snap$Bool$EqCmp_I32(left: Snap$Bool, right: Snap$Bool,
  gas$: FunctionGas): Bool 
  
  function constructor$Snap$Bool$Not_Bool(argument: Snap$Bool): Snap$Bool 
  
  function destructor$Snap$Bool$Not_Bool$argument(value: Snap$Bool): Snap$Bool 
  
  function snapshot_equality$Snap$Bool$Not_Bool(left: Snap$Bool, right: Snap$Bool,
  gas$: FunctionGas): Bool 
  
  axiom constructor$Snap$Bool$$top_down_injectivity_axiom {
    (forall value: Snap$Bool ::
      { valid$Snap$Bool(value) }
      { constructor$Snap$Bool$(destructor$Snap$Bool$$value(value)) }
      valid$Snap$Bool(value) ==>
      value == constructor$Snap$Bool$(destructor$Snap$Bool$$value(value)))
  }
  
  // Used to trigger extensionality for snapshots that contain Viper sequences.
  axiom constructor$Snap$Bool$$snapshot_equality_axiom {
    (forall left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas ::
      { snapshot_equality$Snap$Bool$(left, right, function_gas_level$(gas$)) }
      snapshot_equality$Snap$Bool$(left, right, gas$) ==
      snapshot_equality$Snap$Bool$(left, right, function_gas_level$(gas$)) &&
      (snapshot_equality$Snap$Bool$(left, right, gas$) == (left == right) &&
      snapshot_equality$Snap$Bool$(left, right, gas$) ==
      (destructor$Snap$Bool$$value(left) ==
      destructor$Snap$Bool$$value(right))))
  }
  
  axiom Snap$Bool$$validity_axiom_bottom_up_alternative {
    (forall value: Bool ::
      { valid$Snap$Bool(constructor$Snap$Bool$(value)) }
      valid$Snap$Bool(constructor$Snap$Bool$(value)))
  }
  
  // Used to trigger extensionality for snapshots that contain Viper sequences.
  axiom constructor$Snap$Bool$EqCmp_I32$snapshot_equality_axiom {
    (forall left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas ::
      { snapshot_equality$Snap$Bool$EqCmp_I32(left, right, function_gas_level$(gas$)) }
      snapshot_equality$Snap$Bool$EqCmp_I32(left, right, gas$) ==
      snapshot_equality$Snap$Bool$EqCmp_I32(left, right, function_gas_level$(gas$)) &&
      (snapshot_equality$Snap$Bool$EqCmp_I32(left, right, gas$) ==
      (left == right) &&
      snapshot_equality$Snap$Bool$EqCmp_I32(left, right, gas$) ==
      (destructor$Snap$Bool$EqCmp_I32$left(left) ==
      destructor$Snap$Bool$EqCmp_I32$left(right) &&
      destructor$Snap$Bool$EqCmp_I32$right(left) ==
      destructor$Snap$Bool$EqCmp_I32$right(right))))
  }
  
  axiom EqCmp_I32$simplification_axiom {
    (forall left_const: Int, right_const: Int ::
      { constructor$Snap$Bool$EqCmp_I32(constructor$Snap$I32$(left_const), constructor$Snap$I32$(right_const)) }
      valid$Snap$I32(constructor$Snap$I32$(left_const)) &&
      valid$Snap$I32(constructor$Snap$I32$(right_const)) ==>
      constructor$Snap$Bool$EqCmp_I32(constructor$Snap$I32$(left_const), constructor$Snap$I32$(right_const)) ==
      constructor$Snap$Bool$(left_const == right_const))
  }
  
  axiom EqCmp_I32$eval_axiom {
    (forall left_snap: Snap$I32, right_snap: Snap$I32 ::
      { destructor$Snap$Bool$$value(constructor$Snap$Bool$EqCmp_I32(left_snap,
      right_snap)) }
      destructor$Snap$Bool$$value(constructor$Snap$Bool$EqCmp_I32(left_snap,
      right_snap)) ==
      (destructor$Snap$I32$$value(left_snap) ==
      destructor$Snap$I32$$value(right_snap)))
  }
  
  // Used to trigger extensionality for snapshots that contain Viper sequences.
  axiom constructor$Snap$Bool$Not_Bool$snapshot_equality_axiom {
    (forall left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas ::
      { snapshot_equality$Snap$Bool$Not_Bool(left, right, function_gas_level$(gas$)) }
      snapshot_equality$Snap$Bool$Not_Bool(left, right, gas$) ==
      snapshot_equality$Snap$Bool$Not_Bool(left, right, function_gas_level$(gas$)) &&
      (snapshot_equality$Snap$Bool$Not_Bool(left, right, gas$) ==
      (left == right) &&
      snapshot_equality$Snap$Bool$Not_Bool(left, right, gas$) ==
      (destructor$Snap$Bool$Not_Bool$argument(left) ==
      destructor$Snap$Bool$Not_Bool$argument(right))))
  }
  
  axiom Not_Bool$simplification_axiom {
    (forall constant: Bool ::
      { constructor$Snap$Bool$Not_Bool(constructor$Snap$Bool$(constant)) }
      valid$Snap$Bool(constructor$Snap$Bool$(constant)) ==>
      constructor$Snap$Bool$Not_Bool(constructor$Snap$Bool$(constant)) ==
      constructor$Snap$Bool$(!constant))
  }
  
  axiom Not_Bool$eval_axiom {
    (forall value: Snap$Bool ::
      { destructor$Snap$Bool$$value(constructor$Snap$Bool$Not_Bool(value)) }
      destructor$Snap$Bool$$value(constructor$Snap$Bool$Not_Bool(value)) ==
      !destructor$Snap$Bool$$value(value))
  }
  
  axiom constructor$Snap$Bool$$bottom_up_injectivity_axiom$value {
    (forall value: Bool ::
      { constructor$Snap$Bool$(value) }
      destructor$Snap$Bool$$value(constructor$Snap$Bool$(value)) == value)
  }
  
  axiom Snap$Bool$Bool$to_bytes_injective {
    (forall snapshot: Snap$Bool ::
      { to_bytes$Bool(snapshot) }
      snapshot == from_bytes$Bool(to_bytes$Bool(snapshot)))
  }
}

