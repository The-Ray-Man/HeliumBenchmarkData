function MemoryBlock$bytes(address: Address, size: Snap$Usize): Bytes
  requires acc(MemoryBlock(address, size), wildcard)


function snap_owned_non_aliased$Bool(place: PlaceOption, address: Address): Snap$Bool
  requires acc(OwnedNonAliased$Bool(place, address), wildcard)
  ensures valid$Snap$Bool(result)
  ensures (unfolding acc(OwnedNonAliased$Bool(place, address), wildcard) in
      MemoryBlock$bytes(address, constructor$Snap$Usize$(1)) ==
      to_bytes$Bool(result))


function snap_owned_non_aliased$Tuple$(place: PlaceOption, address: Address): Snap$Tuple$
  requires acc(OwnedNonAliased$Tuple$(place, address), wildcard)
  ensures valid$Snap$Tuple$(result)
  ensures (unfolding acc(OwnedNonAliased$Tuple$(place, address), wildcard) in
      true)


function snap_owned_non_aliased$U32(place: PlaceOption, address: Address): Snap$U32
  requires acc(OwnedNonAliased$U32(place, address), wildcard)
  ensures valid$Snap$U32(result)
  ensures (unfolding acc(OwnedNonAliased$U32(place, address), wildcard) in
      MemoryBlock$bytes(address, constructor$Snap$Usize$(4)) ==
      to_bytes$U32(result))


@qpresource()
predicate OwnedNonAliased$U32(place: PlaceOption, address: Address) {
  acc(MemoryBlock(address, constructor$Snap$Usize$(4)), write)
}

@qpresource()
predicate OwnedNonAliased$Bool(place: PlaceOption, address: Address) {
  acc(MemoryBlock(address, constructor$Snap$Usize$(1)), write)
}

@qpresource()
predicate OwnedNonAliased$Tuple$(place: PlaceOption, address: Address) {
  acc(MemoryBlock(address, PaddingSize$Tuple$$()), write)
}

