  axiom constructor$Snap$Bool$GtCmp_U32$snapshot_equality_axiom {
    (forall left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas ::
      { snapshot_equality$Snap$Bool$GtCmp_U32(left, right, function_gas_level$(gas$)) }
