      (snapshot_equality$Snap$Bool$GtCmp_U32(left, right, gas$) ==
      (left == right) &&
      snapshot_equality$Snap$Bool$GtCmp_U32(left, right, gas$) ==
      (destructor$Snap$Bool$GtCmp_U32$left(left) ==
      destructor$Snap$Bool$GtCmp_U32$left(right) &&
      destructor$Snap$Bool$GtCmp_U32$right(left) ==
      destructor$Snap$Bool$GtCmp_U32$right(right))))
  }
  
  axiom GtCmp_U32$simplification_axiom {
    (forall left_const: Int, right_const: Int ::
      { constructor$Snap$Bool$GtCmp_U32(constructor$Snap$U32$(left_const), constructor$Snap$U32$(right_const)) }
      valid$Snap$U32(constructor$Snap$U32$(left_const)) &&
