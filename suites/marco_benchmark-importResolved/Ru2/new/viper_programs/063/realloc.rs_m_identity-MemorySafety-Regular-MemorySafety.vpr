domain Address  {
  
  function field_address$$struct$m_Vec$$$f$ptr(_0: Address): Address 
  
  function field_address$$struct$m_Vec$$$f$cap(_0: Address): Address 
  
  function field_address$$struct$m_Vec$$$f$len(_0: Address): Address 
  
  function null_address$(): Address 
  
  function address_constructor$(_0: Allocation, _1: Int, _2: Snap$Usize): Address 
  
  function get_allocation$(_0: Address): Allocation 
  
  function get_index$(_0: Address, _1: Snap$Usize): Int 
  
  function address_range_contains$(_0: Address, _1: Int, _2: Int, _3: Snap$Usize,
  _4: Address): Bool 
  
  function offset_address$(_0: Address, _1: Int, _2: Snap$Usize): Address 
  
  axiom address_constructor$injectivity1 {
    (forall allocation: Allocation, index: Int, element_size: Snap$Usize ::
      { address_constructor$(allocation, index, element_size) }
      get_allocation$(address_constructor$(allocation, index, element_size)) ==
      allocation &&
      get_index$(address_constructor$(allocation, index, element_size), element_size) ==
      index)
  }
  
  axiom address_constructor$injectivity2 {
    (forall address: Address, index: Int, element_size: Snap$Usize ::
      { address_constructor$(get_allocation$(address), index, element_size) }
      get_index$(address, element_size) == index ==>
      address_constructor$(get_allocation$(address), index, element_size) ==
      address)
  }
  
  axiom address_range_contains$definition {
    (forall base_address: Address, start_index: Int, end_index: Int, element_size: Snap$Usize,
    checked_address: Address ::
      { address_range_contains$(base_address, start_index, end_index, element_size,
      checked_address) }
      address_range_contains$(base_address, start_index, end_index, element_size,
      checked_address) ==
      (get_allocation$(base_address) == get_allocation$(checked_address) &&
      get_index$(base_address, element_size) + start_index <=
      get_index$(checked_address, element_size) &&
      get_index$(checked_address, element_size) <
      get_index$(base_address, element_size) + end_index))
  }
  
  axiom offset_address$definition {
    (forall address: Address, offset: Int, element_size: Snap$Usize ::
      { offset_address$(address, offset, element_size) }
      offset_address$(address, offset, element_size) ==
      address_constructor$(get_allocation$(address), get_index$(address, element_size) +
      offset, element_size))
  }
}

