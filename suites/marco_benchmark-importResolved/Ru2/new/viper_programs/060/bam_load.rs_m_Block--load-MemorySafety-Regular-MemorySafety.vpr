    (forall address: Address, index: Int, element_size: Snap$Usize ::
      { address_constructor$(get_allocation$(address), index, element_size) }
      get_index$(address, element_size) == index ==>
      address_constructor$(get_allocation$(address), index, element_size) ==
      address)
  }
  
