domain ArithmeticWrappers  {
  
  function mul_wrapper$(_0: Int, _1: Int): Int 
  
  function add_wrapper$(_0: Int, _1: Int): Int 
  
  axiom mul_wrapper$commutativity {
    (forall left: Int, right: Int ::
      { mul_wrapper$(left, right) }
      mul_wrapper$(left, right) == mul_wrapper$(right, left))
  }
  
  axiom mul_wrapper$zero {
    (forall value: Int ::
      { mul_wrapper$(0, value) }
      { mul_wrapper$(value, 0) }
      mul_wrapper$(0, value) == 0 && mul_wrapper$(value, 0) == 0)
  }
  
  axiom mul_wrapper$non_negative_range {
    (forall common: Int, a: Int, b: Int ::
      { mul_wrapper$(common, a), mul_wrapper$(common, b) }
      0 < common ==>
      a <= b ==> mul_wrapper$(common, a) <= mul_wrapper$(common, b))
  }
  
  axiom mul_wrapper$positive_increases {
    (forall a: Int, b: Int ::
      { mul_wrapper$(a, b) }
      0 < a && 0 < b ==> a < mul_wrapper$(a, b) && b < mul_wrapper$(a, b))
  }
  
  axiom add_wrapper$definition {
    (forall left: Int, right: Int ::
      { add_wrapper$(left, right) }
      add_wrapper$(left, right) == left + right)
  }
}

