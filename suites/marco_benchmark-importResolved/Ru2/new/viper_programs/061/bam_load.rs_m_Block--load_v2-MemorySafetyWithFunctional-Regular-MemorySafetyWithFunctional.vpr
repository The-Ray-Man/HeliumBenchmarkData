      constructor$Snap$Bool$EqCmp_Usize(destructor$Snap$struct$m_Vecu8$$$f$len(destructor$Snap$ref$Shared$struct$m_Vecu8$$$target_current(_1)),
      constructor$Snap$Usize$(0)) &&
      valid$Snap$Bool(m_Vecu8$$is_empty$(_1, function_gas_level$(gas$))))) &&
