    (forall value: Snap$Bool ::
      { valid$Snap$Bool(value) }
      { constructor$Snap$Bool$(destructor$Snap$Bool$$value(value)) }
      valid$Snap$Bool(value) ==>
      value == constructor$Snap$Bool$(destructor$Snap$Bool$$value(value)))
