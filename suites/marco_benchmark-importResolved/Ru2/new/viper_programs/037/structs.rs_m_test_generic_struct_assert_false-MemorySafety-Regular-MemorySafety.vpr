  axiom constructor$Snap$Bool$$snapshot_equality_axiom {
    (forall left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas ::
      { snapshot_equality$Snap$Bool$(left, right, function_gas_level$(gas$)) }
      snapshot_equality$Snap$Bool$(left, right, gas$) ==
      snapshot_equality$Snap$Bool$(left, right, function_gas_level$(gas$)) &&
      (snapshot_equality$Snap$Bool$(left, right, gas$) == (left == right) &&
      snapshot_equality$Snap$Bool$(left, right, gas$) ==
      (destructor$Snap$Bool$$value(left) ==
      destructor$Snap$Bool$$value(right))))
  }
  
  axiom Snap$Bool$$validity_axiom_bottom_up_alternative {
    (forall value: Bool ::
      { valid$Snap$Bool(constructor$Snap$Bool$(value)) }
      valid$Snap$Bool(constructor$Snap$Bool$(value)))
  }
  
  axiom constructor$Snap$Bool$$bottom_up_injectivity_axiom$value {
    (forall value: Bool ::
      { constructor$Snap$Bool$(value) }
      destructor$Snap$Bool$$value(constructor$Snap$Bool$(value)) == value)
  }
}

