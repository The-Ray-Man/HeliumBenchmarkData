domain ParamTypVariant  {
  
  axiom s_Param_typ_variant {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      (s_Param_typ(p).iss_UInt_u128_type ==> p.ismake_generic_s_UInt_u128) &&
      (s_Param_typ(p).iss_Bool_type ==> p.ismake_generic_s_Bool) &&
      ((s_Param_typ(p).iss_UInt_u64_type ==> p.ismake_generic_s_UInt_u64) &&
      ((s_Param_typ(p).iss_core$col$$col$mem$col$$col$MaybeUninit_type ==>
      p.ismake_generic_s_core$col$$col$mem$col$$col$MaybeUninit) &&
      (s_Param_typ(p).iss_Buffer_type ==> p.ismake_generic_s_Buffer))) &&
      ((s_Param_typ(p).iss_0_Tuple_type ==> p.ismake_generic_s_0_Tuple) &&
      ((s_Param_typ(p).iss_Str_type ==> p.ismake_generic_s_Str) &&
      (s_Param_typ(p).iss_UInt_usize_type ==> p.ismake_generic_s_UInt_usize)) &&
      ((s_Param_typ(p).iss_Slice_type ==> p.ismake_generic_s_Slice) &&
      ((s_Param_typ(p).iss_Array_type ==> p.ismake_generic_s_Array) &&
      (s_Param_typ(p).iss_UInt_u8_type ==> p.ismake_generic_s_UInt_u8)))) &&
      ((s_Param_typ(p).iss_core$col$$col$ops$col$$col$RangeFrom_type ==>
      p.ismake_generic_s_core$col$$col$ops$col$$col$RangeFrom) &&
      (s_Param_typ(p).iss_Ref_mutable_type ==>
      p.ismake_generic_s_Ref_mutable) &&
