import "../_preambles/Maps.vpr"
import "../_preambles/Lists.vpr"
import "../_preambles/flows-new.vpr"


/* -------------------- Example specific flows setup -------------------- */

// Product of two natural numbers
domain FlowDom {
  function pc1(f : FlowDom) : Int
  function pc2(f : FlowDom) : Int
  axiom positive {
    forall p: FlowDom :: pc1(p) >= 0 && pc2(p) >= 0
  }

  function fdEq(p1: FlowDom, p2:FlowDom) : Bool 
  axiom fdEqDef {
    forall p1: FlowDom, p2:FlowDom :: {fdEq(p1,p2)}
      fdEq(p1, p2) == (pc1(p1) == pc1(p2) && pc2(p1) == pc2(p2))
  }
  axiom fdEqDef2 {
    forall p1: FlowDom, p2:FlowDom :: {fdEq(p1,p2)}
      fdEq(p1, p2) ==> p1 == p2
  }

  // Added by frontend: same for all domains
  function fdLeq(p1: FlowDom, p2:FlowDom) : Bool 
  function fdLeqWitness(p1:FlowDom, p2:FlowDom) : FlowDom // unique, due to cancellativity
  axiom fdLeqImplied {
    forall p1:FlowDom, p2:FlowDom :: {fdLeq(p1,p2)} 
      fdLeq(p1,p2) ==> fdPlus(p1,fdLeqWitness(p1,p2)) == p2
  }
  axiom fdLeqImplies {
    forall p1:FlowDom, p2:FlowDom :: {fdPlus(p1,p2)}
      fdLeqWitness(p1,fdPlus(p1,p2)) == p2 && fdLeq(p1,fdPlus(p1,p2))
  }

  function fdPlus(p1: FlowDom, p2:FlowDom) : FlowDom
  axiom fdPlusDef {
    forall p1: FlowDom, p2:FlowDom :: {fdPlus(p1,p2)}
      pc1(fdPlus(p1,p2)) == pc1(p1) + pc1(p2)
      && pc2(fdPlus(p1,p2)) == pc2(p1) + pc2(p2)
  }

  function fdZero() : FlowDom
  axiom fdZeroDef {
    pc1(fdZero()) == 0 && pc2(fdZero()) == 0
  }

  // Some useful flow domain elements
  function fdOneZero() : FlowDom
  axiom fdOneZeroDef {
    pc1(fdOneZero()) == 1 && pc2(fdOneZero()) == 0
  }
  function fdZeroOne() : FlowDom
  axiom fdZeroOneDef {
    pc1(fdZeroOne()) == 0 && pc2(fdZeroOne()) == 1
  }
  function fdOneOne() : FlowDom
  axiom fdOneOneDef {
    pc1(fdOneOne()) == 1 && pc2(fdOneOne()) == 1
  }

  // Some useful flow domain endomorphisms
  function mapIdZero() : IMap[FlowDom, FlowDom]
  axiom mapIdZeroDef {
    forall p: FlowDom :: {select(mapIdZero(), p)}
      pc1(select(mapIdZero(), p)) == pc1(p) && pc2(select(mapIdZero(), p)) == 0
  }
  function mapZeroId() : IMap[FlowDom, FlowDom]
  axiom mapZeroIdDef {
    forall p: FlowDom :: {select(mapZeroId(), p)}
      pc1(select(mapZeroId(), p)) == 0 && pc2(select(mapZeroId(), p)) == pc2(p)
  }
  function mapId() : IMap[FlowDom, FlowDom]
  axiom mapIdDef {
    forall p: FlowDom :: {select(mapId(), p)}
      select(mapId(), p) == p
  }
} 


// The fields of a node
field next: Ref
field fnext: Ref
field mark: Bool

define nodeSpatial(x) acc(x.next) && acc(x.fnext) && acc(x.mark)
define hrepUnchanged(x) x.next == old(x.next)
  && x.fnext == old(x.fnext) && x.mark == old(x.mark)


// Definition of a node and good condition:

function edge_fn(x:Ref, y:Ref) : IMap[FlowDom,FlowDom]
  requires nodeSpatial(x)
{
  y == null ? constMap(fdZero())
    : (y == x.next && y != x.fnext ? mapIdZero()
      : (y != x.next && y == x.fnext ? mapZeroId()
        : (y == x.next && y == x.fnext ? mapId() : constMap(fdZero()))))
}


// These are the invariants that say this structure is a Harris list
define harrisInv(mh, fh, I) 
  intValid(I) && mh in dom(I) && fh in dom(I)
  // Global inflow constraints:
  && Iinf(I, mh) == fdOneZero() && Iinf(I, fh) == fdZeroOne()
  && (forall x: Ref :: {x in dom(I), Iinf(I, x)} 
    (x in dom(I) && x != mh && x != fh) ==> Iinf(I, x) == fdZero())
  // Data structure is closed
  && (forall x: Ref :: {x in dom(I), trig_gfe(x, x.next)}
    x in dom(I) && x.next != null && trig_gfe(x, x.next) ==> x.next in dom(I))
  && (forall x: Ref :: {x in dom(I), trig_gfe(x, x.fnext)}
    x in dom(I) && x.fnext != null && trig_gfe(x, x.fnext) ==> x.fnext in dom(I))
  // All nodes in one of the lists
  && (forall x: Ref :: {x in dom(I)} x in dom(I)
    ==> (fdEq(Iinf(x.intf, x), fdOneZero()) || fdEq(Iinf(x.intf, x), fdZeroOne())
      || fdEq(Iinf(x.intf, x), fdOneOne())))
  // All nodes on free list are marked (contrapositive for brevity)
  && (forall x: Ref :: {x in dom(I), x.mark} x in dom(I)
    ==> (!x.mark ==> Iinf(x.intf, x) == fdOneZero()))
  // No self-edges
  && (forall x: Ref :: {x.next, x in dom(I)} x in dom(I) ==> x.next != x)
  && (forall x: Ref :: {x.fnext, x in dom(I)} x in dom(I) ==> x.fnext != x)


/* -------------------- Actual methods -------------------- */


// Helper function to create and initialize new node
method alloc(i: FlowDom, X: Set[Ref]) returns (x: Ref, X1: Set[Ref])
  requires X == Set[Ref]()
  ensures X1 == Set(x)
  ensures forall z: Ref :: {z in X1} z in X1 ==> node(z)
  ensures fdEq(Iinf(x.intf, x), i)
    && (forall y: Ref :: Iout(x.intf, y) == fdZero())
  ensures intLeq(intCompSet(Set[Ref]()), intCompSet(Set(x)))
{
  x := new(*)
  x.next := null
  x.fnext := null
  x.intf := interface(singMap(x, i, fdZero()), constMap(fdZero()), Set(x))
  X1 := Set(x)
  _lemma_prove_intValid(x)
  _lemma_prove_intLeq(intCompSet(Set[Ref]()), intCompSet(Set(x)))
}


// Create a new node and insert it after l
method insert(l: Ref, mh: Ref, fh: Ref, X: Set[Ref]) returns (X1: Set[Ref])
  requires forall x: Ref :: {x in X} x in X ==> node(x)
  requires harrisInv(mh, fh, intCompSet(X))
  requires l in X && pc1(Iinf(l.intf, l)) == 1 && !l.mark
  ensures forall x: Ref :: {x in X1} x in X1 ==> node(x)
  ensures harrisInv(mh, fh, intCompSet(X1))
{
  // ---- Flows set-up:
  var FP : Set[Ref] := X

  var dirty : Set[Ref]
  var dirtyList : List[Ref]

  var edge_fns: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]
  var edge_fns_new: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]

  var infs_small: IMap[Ref, FlowDom]
  var infs_small_new: IMap[Ref, FlowDom]
  var inf_D: IMap[Ref, FlowDom]

  _pre_code(FP)

  // ---- Actual code:
  
  var n: Ref
  var Y: Set[Ref]
  var Y1: Set[Ref]
  Y := Set[Ref]()

  label pre_alloc_call

  n, Y1 := alloc(fdZero(), Y)

  // ---- Post method call:

  var FP1: Set[Ref]
  _post_method_call(FP, FP1, Y, Y1, pre_alloc_call)

  // ---- Flows set-up again after method call:

  _pre_code(FP1)

  // ---- Actual code:

  _field_read(l, l.next)
  var r: Ref := l.next

  _make_dirty(l)
  l.next := n;

  _make_dirty(n)
  n.next := r;
  n.fnext := null;
  n.mark := false;

  // ---- Post code sync:
  _post_code_sync_EA(FP1)

  X1 := FP1
}


// Mark a node as logically deleted
method delete(l: Ref, mh: Ref, fh: Ref, X: Set[Ref])
  requires forall x: Ref :: {x in X} x in X ==> node(x)
  requires harrisInv(mh, fh, intCompSet(X))
  requires l in X && pc1(Iinf(l.intf, l)) == 1 && !l.mark
  ensures forall x: Ref :: {x in X} x in X ==> node(x)
  ensures harrisInv(mh, fh, intCompSet(X))
{
  // ---- Flows set-up:
  var FP : Set[Ref] := X

  var dirty : Set[Ref]
  var dirtyList : List[Ref]

  var edge_fns: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]
  var edge_fns_new: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]

  var infs_small: IMap[Ref, FlowDom]
  var infs_small_new: IMap[Ref, FlowDom]
  var inf_D: IMap[Ref, FlowDom]

  _pre_code(FP)

  // ---- Actual code:
  
  // Added based on field reads to trigger global flow eqn
  _make_dirty(l)
  l.mark := true;

  // ---- Post code sync:
  _post_code_sync_EA(FP)
}


method traverse(mh: Ref, fh: Ref, X: Set[Ref])
  requires forall x: Ref :: {x in X} x in X ==> node(x)
  requires harrisInv(mh, fh, intCompSet(X))
  ensures forall x: Ref :: {x in X} x in X ==> node(x)
  ensures harrisInv(mh, fh, intCompSet(X))
{
  // ---- Flows set-up:
  var FP : Set[Ref] := X

  var dirty : Set[Ref]
  var dirtyList : List[Ref]

  var edge_fns: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]
  var edge_fns_new: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]

  var infs_small: IMap[Ref, FlowDom]
  var infs_small_new: IMap[Ref, FlowDom]
  var inf_D: IMap[Ref, FlowDom]

  _pre_code(FP)

  // ---- Actual code:

  var l: Ref := mh
  var r: Ref

  _field_read(l, l.next)
  r := l.next

  var nond: Bool
  nond := nondet()
  while (nond && r != null)
    invariant forall x: Ref :: {x in X} x in X ==> node(x)
    invariant harrisInv(mh, fh, intCompSet(X))
    invariant l in X && pc1(Iinf(l.intf, l)) == 1
    invariant r == l.next && (r != null ==> r in X && pc1(Iinf(r.intf, r)) == 1)
  {
    _assume_global_invs(FP)

    l := r

    _field_read(l, l.next)
    r := l.next

    nond := nondet()
  }

  // Check that we can now call either insert or delete:
  assert (forall x: Ref :: {x in X} x in X ==> node(x))
    && harrisInv(mh, fh, intCompSet(X))
    && l in X && pc1(Iinf(l.intf, l)) == 1
  if (r != null) {
    assert (forall x: Ref :: {x in X} x in X ==> node(x))
      && harrisInv(mh, fh, intCompSet(X))
      && l in X && l.next in X
  }
}