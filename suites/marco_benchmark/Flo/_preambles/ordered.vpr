domain K {
  function lt(x: K, y: K): Bool
  
  function bottom(): K

  function top(): K

  axiom bottomIsSmallest {
    forall a: K :: !lt(a, bottom())
  }

  axiom topIsLargest {
    forall a: K :: !lt(top(), a)
  }

  axiom nontrivialDomain {
    bottom() != top()
  }

  axiom ltIrreflexive {
    forall a: K :: !lt(a, a)
  }

  axiom ltTotal {
    forall a: K, b: K :: !lt(a, b) || !lt(b, a)
  }

  axiom ltAntisymmetric {
    forall a: K, b: K :: 
      lt(a, b) || lt(b, a) || a == b
  }

  axiom ltTransitive {
    forall a: K, b: K, c: K :: 
      lt(a, b) && lt(b, c) ==> lt(a, c)
  }

  function le(a: K, b: K): Bool 
  
  axiom leDef {
    forall a: K, b: K :: {le(a, b)} 
      le(a, b) == (lt(a, b) || a == b)
  }

  function compare(a: K, b: K): Int
  
  axiom compareDef {
    forall a: K, b: K :: {compare(a, b)} 
      compare(a, b) == (a == b ? 0 : (lt(a, b) ? -1 : 1))
  }
}