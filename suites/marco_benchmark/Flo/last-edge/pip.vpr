import "../_preambles/Maps.vpr"
import "../_preambles/Lists.vpr"
import "../_preambles/flows-new.vpr"


/* -------------------- Flow Domain definitions -------------------- */

// Message domain is multisets of non-negative integers, used for priorities
domain FlowDom {
  function fd(i : Multiset[Int]) : FlowDom
    
  function pr(f : FlowDom) : Multiset[Int]
  axiom injective {
      forall m : Multiset[Int] :: {fd(m)} pr(fd(m)) == m
  }

  // rename fdX -> mX or msgX
  function fdEq(p1: FlowDom, p2:FlowDom) : Bool 
  axiom fdEqImplies {
    forall p1: FlowDom, p2:FlowDom :: {fdEq(p1,p2)}
      fdEq(p1,p2) ==> (p1 == p2)
  }

  axiom fdEqImplied {
    forall p1: FlowDom, p2:FlowDom :: {fdEq(p1,p2)}
      (pr(p1) == pr(p2)) ==> fdEq(p1,p2) 
  }

  // Added by frontend: same for all domains
  function fdLeq(p1: FlowDom, p2:FlowDom) : Bool 
  function fdLeqWitness(p1:FlowDom, p2:FlowDom) : FlowDom // unique, due to cancellativity
  axiom fdLeqImplied {
    forall p1:FlowDom, p2:FlowDom :: {fdLeq(p1,p2)} 
      fdLeq(p1,p2) ==> fdPlus(p1,fdLeqWitness(p1,p2)) == p2
  }
  axiom fdLeqImplies {
    forall p1:FlowDom, p2:FlowDom :: {fdPlus(p1,p2)}
      fdLeqWitness(p1,fdPlus(p1,p2)) == p2 && fdLeq(p1,fdPlus(p1,p2))
  }
  // Domain specific axiom:
  axiom fdLeqDef {
    forall p1: FlowDom, p2:FlowDom :: {fdLeq(p1,p2)}
      fdLeq(p1,p2) == (pr(p1) subset pr(p2))
  }

  function fdPlus(p1: FlowDom, p2:FlowDom) : FlowDom
  axiom fdPlusDef {
    forall p1: FlowDom, p2:FlowDom :: {fdPlus(p1,p2)}
      fdPlus(p1,p2) == fd(pr(p1) union pr(p2))
  }

  function fdZero() : FlowDom
  axiom fdZeroDef {
    fdZero() == fd(Multiset[Int]())
  }
}

// The fields of a node:
field parent: Ref
field current_prio: Int
field default_prio: Int
field priorities: Multiset[Int]

define nodeSpatial(x)
  acc(x.parent) && acc(x.current_prio) && acc(x.default_prio) && acc(x.priorities)
define hrepUnchanged(x)
  x.parent == old(x.parent) && x.current_prio == old(x.current_prio)
  && x.default_prio == old(x.default_prio) && x.priorities == old(x.priorities)

// Definition of a node and good condition:

function ms_max(m: Multiset[Int]): Int 
  ensures forall i: Int :: (i in m) > 0 ==> result >= i
  ensures m == Multiset[Int]() ? result == 0 : (result in m) > 0

function max(x: Int, y: Int): Int
  ensures x > y ? result == x : result == y
{
  x > y ? x : y
}

function edge_fn(x: Ref, y: Ref) : IMap[FlowDom, FlowDom]
  requires nodeSpatial(x)
{
  (x != y && x.parent != null && x.parent == y) ?
    constMap(fd(Multiset(x.current_prio))) : constMap(fdZero())
}

function correct_priorities(x: Ref, from: Int, to: Int): Multiset[Int]
  requires nodeSpatial(x)
  ensures result == (to > 0 ? x.priorities union Multiset(to) : x.priorities) setminus Multiset(from)
{
  (to > 0 ? x.priorities union Multiset(to) : x.priorities) setminus Multiset(from)
}

define nodeInvIntermediate(I, y, from, to)
  intValid(I)
  // priorities are strictly positive
  && (forall x: Ref :: {x in dom(I)} x in dom(I) ==> x.default_prio > 0)
  && (forall x: Ref, i: Int :: {x in dom(I), i in x.priorities} x in dom(I) && (i in x.priorities) > 0 ==> i > 0)
  // local priorities are consistent with inflow 
  && (forall x: Ref :: {Iinf(x.intf, x), x in dom(I)} x in dom(I)
      ==> fd(y == x ? correct_priorities(x, from, to) : x.priorities) == Iinf(x.intf, x) )
  // x.current_prio is maximal priority of x and predecessors
  && (forall x: Ref :: {x in dom(I)} x in dom(I)
      ==> x.current_prio == max(ms_max(x.priorities), x.default_prio) )
  // No self loops
  && (forall x: Ref :: {x in dom(I), x.parent} x in dom(I) ==> x.parent != x)
  // Data structure is closed
  && (forall x: Ref :: {x in dom(I)} x in dom(I) && x.parent != null
    ==> x.parent in dom(I))

define nodeInv(I) nodeInvIntermediate(I, null, 0, 0)

method updatePriorities(this: Ref, from: Int, to: Int, X: Set[Ref]) 
  requires forall x: Ref :: {x in X} x in X ==> node(x)
  requires this in X //&& (from in this.priorities) > 0
  requires nodeInvIntermediate(intCompSet(X), this, from, to)
  ensures forall x: Ref :: {x in X} x in X ==> node(x)
  ensures nodeInv(intCompSet(X))
{
  // ---- Flows set-up:
  var FP : Set[Ref] := X

  var dirty : Set[Ref]
  var dirtyList : List[Ref]

  var edge_fns: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]
  var edge_fns_new: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]

  var infs_small: IMap[Ref, FlowDom]
  var infs_small_new: IMap[Ref, FlowDom]
  var inf_D: IMap[Ref, FlowDom]

  _pre_code(FP)

  // ---- Actual code:
  
  assert dom(intCompSet(X)) == X
  
  if (from != to) {
    var old_prio: Int := this.current_prio

    if (to > 0) {
      _make_dirty(this)
      this.priorities := this.priorities union Multiset(to)
    }

    _make_dirty(this)
    this.priorities := this.priorities setminus Multiset(from)
    
    _make_dirty(this)
    this.current_prio := max(ms_max(this.priorities), this.default_prio)

    _field_read(this, this.parent)
    _make_dirty(this.parent)

    // ---- Post code sync:
    _post_code_sync(FP, pre_sync)

    // ---- Continue with actual code:

    if (this.current_prio != old_prio && this.parent != null) {
      assert pr(Iinf(this.parent.intf, this.parent)) == this.parent.priorities union Multiset(this.current_prio) setminus Multiset(old_prio)
      updatePriorities(this.parent, old_prio, this.current_prio, X)
    } 
  } else {
    test(this.priorities, to)
    // oddly the following assert can't be proven without the call to test
    //assert this.priorities == (this.priorities union Multiset(to)) setminus Multiset(to)
    //assert this.priorities == (this.priorities union Multiset(to)) setminus Multiset(from)
    assert this.priorities == old(correct_priorities(this, from, to))
  }
}

method test(m: Multiset[Int], x: Int) 
  ensures m == (m union Multiset(x)) setminus Multiset(x)
{ }

method aquire(this: Ref, r: Ref, X: Set[Ref])
  requires forall x: Ref :: {x in X} x in X ==> node(x)
  requires this in X && r in X && this != r && this.parent == null
  requires nodeInv(intCompSet(X))
  ensures forall x: Ref :: {x in X} x in X ==> node(x)
  ensures nodeInv(intCompSet(X))
{
  // ---- Flows set-up:
  var FP : Set[Ref] := X

  var dirty : Set[Ref]
  var dirtyList : List[Ref]

  var edge_fns: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]
  var edge_fns_new: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]

  var infs_small: IMap[Ref, FlowDom]
  var infs_small_new: IMap[Ref, FlowDom]
  var inf_D: IMap[Ref, FlowDom]

  _pre_code(FP)

  // ---- Actual code:

  assert dom(intCompSet(X)) == X

  _field_read(r, r.parent)
  if (r.parent == null) {
    _make_dirty(r)
    r.parent := this
    
    _make_dirty(r.parent)

    // ---- Post code sync:
    {
      _post_code_sync(FP, pre_sync1)
    }

    // ---- Continue with actual code:

    assert pr(Iinf(this.intf, this)) == pr(old(Iinf(this.intf, this))) union Multiset(r.current_prio)
    lemma_sub_not_contains(pr(Iinf(this.intf, this)), 0)
    assert fd(correct_priorities(this, 0, r.current_prio)) == Iinf(this.intf, this) 

    updatePriorities(this, 0, r.current_prio, X)
  } else {
    _make_dirty(this)
    this.parent := r

    _make_dirty(this.parent)

    // ---- Post code sync:
    {
      _post_code_sync(FP, pre_sync3)
    }

    // ---- Continue with actual code:

    assert pr(Iinf(r.intf, r)) == pr(old(Iinf(r.intf, r))) union Multiset(this.current_prio)
    lemma_sub_not_contains(pr(Iinf(r.intf, r)), 0)
    assert fd(correct_priorities(r, 0, this.current_prio)) == Iinf(r.intf, r) 

    updatePriorities(r, 0, this.current_prio, X)
  }
}

method release(this: Ref, r: Ref, X: Set[Ref])
  requires forall x: Ref :: {x in X} x in X ==> node(x)
  requires this in X && r in X 
  requires nodeInv(intCompSet(X))
  ensures forall x: Ref :: {x in X} x in X ==> node(x)
  ensures nodeInv(intCompSet(X))
{
  // ---- Flows set-up:
  var FP : Set[Ref] := X

  var dirty : Set[Ref]
  var dirtyList : List[Ref]

  var edge_fns: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]
  var edge_fns_new: IMap[Ref, IMap[Ref, IMap[FlowDom, FlowDom]]]

  var infs_small: IMap[Ref, FlowDom]
  var infs_small_new: IMap[Ref, FlowDom]
  var inf_D: IMap[Ref, FlowDom]

  _pre_code(FP)

  // ---- Actual code:

  assert dom(intCompSet(X)) == X

  _field_read(r, r.parent)
  if (r.parent == this) {
    _make_dirty(r)
    r.parent := null
    
    _make_dirty(this)

    // ---- Post code sync:
    _post_code_sync(FP, pre_sync)

    // ---- Continue with actual code:

    assert pr(Iinf(this.intf, this)) == pr(old(Iinf(this.intf, this))) setminus Multiset(r.current_prio)
    assert fd(correct_priorities(this, r.current_prio, 0)) == Iinf(this.intf, this) 
    updatePriorities(this, r.current_prio, 0, X)
  }
}


method lemma_sub_not_contains(m: Multiset[Int], x: Int)
  requires (x in m) <= 0
  ensures m setminus Multiset(x) == m
{ }