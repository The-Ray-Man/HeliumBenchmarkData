  axiom Not_Bool$eval_axiom {
    (forall value: Snap$Bool ::
      { destructor$Snap$Bool$$value(constructor$Snap$Bool$Not_Bool(value)) }
      destructor$Snap$Bool$$value(constructor$Snap$Bool$Not_Bool(value)) ==
      !destructor$Snap$Bool$$value(value))
