  unfold acc(OwnedNonAliased$struct$m_E$(source_place, source_address), write)
  memory_block_split$struct$m_E$(target_address, write)
  memory_block_join$struct$m_E$(source_address, write)
  fold acc(OwnedNonAliased$struct$m_E$(target_place, target_address), write)
}

method move_place$struct$m_T$(target_place: PlaceOption, target_address: Address,
  source_place: PlaceOption, source_address: Address, source_snapshot: Snap$struct$m_T$)
  requires acc(MemoryBlock(target_address, constructor$Snap$Usize$(0)), write)
  requires acc(OwnedNonAliased$struct$m_T$(source_place, source_address), write) &&
    source_snapshot ==
    snap_owned_non_aliased$struct$m_T$(source_place, source_address)
  ensures acc(OwnedNonAliased$struct$m_T$(target_place, target_address), write) &&
    source_snapshot ==
    snap_owned_non_aliased$struct$m_T$(target_place, target_address)
  ensures acc(MemoryBlock(source_address, constructor$Snap$Usize$(0)), write)
  ensures valid$Snap$struct$m_T$(source_snapshot)
{
  unfold acc(OwnedNonAliased$struct$m_T$(source_place, source_address), write)
  memory_block_split$struct$m_T$(target_address, write)
  memory_block_join$struct$m_T$(source_address, write)
  fold acc(OwnedNonAliased$struct$m_T$(target_place, target_address), write)
}

method write_place_constant$Tuple$(target_place: PlaceOption, target_address: Address,
  source_snapshot: Snap$Tuple$)
  requires acc(MemoryBlock(target_address, constructor$Snap$Usize$(0)), write)
  requires valid$Snap$Tuple$(source_snapshot)
  ensures acc(OwnedNonAliased$Tuple$(target_place, target_address), write) &&
    source_snapshot ==
    snap_owned_non_aliased$Tuple$(target_place, target_address)
{
  memory_block_split$Tuple$(target_address, write)
  fold acc(OwnedNonAliased$Tuple$(target_place, target_address), write)
