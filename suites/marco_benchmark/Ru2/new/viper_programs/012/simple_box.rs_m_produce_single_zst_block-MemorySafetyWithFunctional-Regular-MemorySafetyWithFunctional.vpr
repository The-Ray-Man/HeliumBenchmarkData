  function get_index$(_0: Address, _1: Snap$Usize): Int 
  
  function address_range_contains$(_0: Address, _1: Int, _2: Int, _3: Snap$Usize,
  _4: Address): Bool 
  
  function offset_address$(_0: Address, _1: Int, _2: Snap$Usize): Address 
  
  axiom address_constructor$injectivity1 {
    (forall allocation: Allocation, index: Int, element_size: Snap$Usize ::
      { address_constructor$(allocation, index, element_size) }
      get_allocation$(address_constructor$(allocation, index, element_size)) ==
      allocation &&
