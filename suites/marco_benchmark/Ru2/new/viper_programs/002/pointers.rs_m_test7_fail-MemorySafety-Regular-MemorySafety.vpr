  axiom constructor$Snap$Bool$$snapshot_equality_axiom {
    (forall left: Snap$Bool, right: Snap$Bool, gas$: FunctionGas ::
      { snapshot_equality$Snap$Bool$(left, right, function_gas_level$(gas$)) }
