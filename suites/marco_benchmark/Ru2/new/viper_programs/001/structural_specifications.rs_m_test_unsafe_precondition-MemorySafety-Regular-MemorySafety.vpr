function snap_owned_non_aliased$I32(place: PlaceOption, address: Address): Snap$I32
  requires acc(OwnedNonAliased$I32(place, address), wildcard)
  ensures valid$Snap$I32(result)
  ensures (unfolding acc(OwnedNonAliased$I32(place, address), wildcard) in
      MemoryBlock$bytes(address, constructor$Snap$Usize$(4)) ==
      to_bytes$I32(result))


