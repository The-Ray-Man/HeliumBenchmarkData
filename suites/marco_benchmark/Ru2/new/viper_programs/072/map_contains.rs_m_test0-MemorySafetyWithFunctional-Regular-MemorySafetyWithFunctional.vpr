  requires acc(MemoryBlock(address, constructor$Snap$Usize$(0)), write)
  ensures acc(MemoryBlock(address, PaddingSize$Tuple$$()), permission_amount)
  ensures true


method write_address_constant$Bool(target_address: Address, source_snapshot: Snap$Bool)
  requires acc(MemoryBlock(target_address, constructor$Snap$Usize$(1)), write)
  ensures acc(MemoryBlock(target_address, constructor$Snap$Usize$(1)), write)
  ensures MemoryBlock$bytes(target_address, constructor$Snap$Usize$(1)) ==
    to_bytes$Bool(source_snapshot)


method write_place_constant$Bool(target_place: PlaceOption, target_address: Address,
  source_snapshot: Snap$Bool)
  requires acc(MemoryBlock(target_address, constructor$Snap$Usize$(1)), write)
  requires valid$Snap$Bool(source_snapshot)
  ensures acc(OwnedNonAliased$Bool(target_place, target_address), write) &&
    source_snapshot ==
    snap_owned_non_aliased$Bool(target_place, target_address)
{
  write_address_constant$Bool(target_address, source_snapshot)
  fold acc(OwnedNonAliased$Bool(target_place, target_address), write)
}

method write_place_constant$Tuple$(target_place: PlaceOption, target_address: Address,
  source_snapshot: Snap$Tuple$)
  requires acc(MemoryBlock(target_address, constructor$Snap$Usize$(0)), write)
  requires valid$Snap$Tuple$(source_snapshot)
  ensures acc(OwnedNonAliased$Tuple$(target_place, target_address), write) &&
    source_snapshot ==
    snap_owned_non_aliased$Tuple$(target_place, target_address)
{
  memory_block_split$Tuple$(target_address, write)
  fold acc(OwnedNonAliased$Tuple$(target_place, target_address), write)
}