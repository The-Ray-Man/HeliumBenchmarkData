function MemoryBlock$bytes(address: Address, size: Snap$Usize): Bytes
  requires acc(MemoryBlock(address, size), wildcard)


function snap_owned_non_aliased$Bool(place: PlaceOption, address: Address): Snap$Bool
  requires acc(OwnedNonAliased$Bool(place, address), wildcard)
  ensures valid$Snap$Bool(result)
  ensures (unfolding acc(OwnedNonAliased$Bool(place, address), wildcard) in
      MemoryBlock$bytes(address, constructor$Snap$Usize$(1)) ==
      to_bytes$Bool(result))


function snap_owned_non_aliased$I32(place: PlaceOption, address: Address): Snap$I32
  requires acc(OwnedNonAliased$I32(place, address), wildcard)
  ensures valid$Snap$I32(result)
  ensures (unfolding acc(OwnedNonAliased$I32(place, address), wildcard) in
      MemoryBlock$bytes(address, constructor$Snap$Usize$(4)) ==
      to_bytes$I32(result))


function snap_owned_non_aliased$Tuple$(place: PlaceOption, address: Address): Snap$Tuple$
  requires acc(OwnedNonAliased$Tuple$(place, address), wildcard)
  ensures valid$Snap$Tuple$(result)
  ensures (unfolding acc(OwnedNonAliased$Tuple$(place, address), wildcard) in
      true)


function snap_owned_non_aliased$struct$m_T$(place: PlaceOption, address: Address): Snap$struct$m_T$
  requires acc(OwnedNonAliased$struct$m_T$(place, address), wildcard)
  ensures valid$Snap$struct$m_T$(result)
  ensures (unfolding acc(OwnedNonAliased$struct$m_T$(place, address), wildcard) in
      destructor$Snap$struct$m_T$$$f$f(result) ==
      snap_owned_non_aliased$I32(field_placeoption$$struct$m_T$$$f$f(place),
      field_address$$struct$m_T$$$f$f(address)) &&
      destructor$Snap$struct$m_T$$$f$g(result) ==
      snap_owned_non_aliased$I32(field_placeoption$$struct$m_T$$$f$g(place),
      field_address$$struct$m_T$$$f$g(address)))


