  }
  
  axiom inhabited_naive$col$$col$time$col$$col$NaiveTime {
    inhabited(s_naive$col$$col$time$col$$col$NaiveTime_type()) ==
    (inhabited(s_UInt_u32_type()) && inhabited(s_UInt_u32_type()))
  }
  
  axiom inhabited_UInt_u32 {
    inhabited(s_UInt_u32_type()) == true
  }
  
  axiom inhabited_Int_i64 {
    inhabited(s_Int_i64_type()) == true
  }
  
