{
  (unfolding acc(p_Errno(self), write) in
    s_Errno_cons(p_Int_i32_snap(s_Errno_field_0(self))))
}

function p_Int_i32_snap(self: Ref): s_Int_i32
  requires acc(p_Int_i32(self), write)
{
  (unfolding acc(p_Int_i32(self), write) in self.p_Int_i32_val)
}

predicate p_Errno(self: Ref) {
  inhabited(s_Int_i32_type()) &&
  acc(p_Int_i32(s_Errno_field_0(self)), write)
}

predicate p_Int_i32(self: Ref) {
