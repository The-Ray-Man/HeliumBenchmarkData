    (forall x: s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA ::
      { make_generic_s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA(x) }
      s_Param_typ(make_generic_s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA(x)) ==
      s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA {
    (forall p: s_Param ::
      { p.make_concrete_s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA_type() ==>
      make_generic_s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA(p.make_concrete_s_nfa$col$$col$thompson$col$$col$nfa$col$$col$NFA) ==
      p)
  }
}

