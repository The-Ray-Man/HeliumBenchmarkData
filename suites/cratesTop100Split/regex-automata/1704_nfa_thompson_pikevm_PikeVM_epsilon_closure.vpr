domain s_UInt_usize  {
  
  function s_UInt_usize_cons(arg0: Int): s_UInt_usize 
  
  function s_UInt_usize_value(arg0: s_UInt_usize): Int 
  
  axiom s_UInt_usize_ax_cons {
    (forall s: s_UInt_usize ::
      { s_UInt_usize_value(s) }
      s_UInt_usize_cons(s_UInt_usize_value(s)) == s)
