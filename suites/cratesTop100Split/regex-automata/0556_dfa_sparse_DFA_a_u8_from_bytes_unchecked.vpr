  axiom s_Param_typ_variant_make_generic_s_2_Tuple {
    (forall p: s_Param ::
      { p.make_concrete_s_2_Tuple, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_2_Tuple_type(s_Param_typ(p).s_2_Tuple_typaram_T$0, s_Param_typ(p).s_2_Tuple_typaram_U$1) ==>
