  axiom inhabited_nfa$col$$col$thompson$col$$col$compiler$col$$col$Config$col$$col$overwrite$col$$col$$lc$closure$oc$0$rc$ {
    inhabited(s_nfa$col$$col$thompson$col$$col$compiler$col$$col$Config$col$$col$overwrite$col$$col$$lc$closure$oc$0$rc$_type()) ==
    inhabited(s_Ref_immutable_type(s_nfa$col$$col$thompson$col$$col$compiler$col$$col$Config_type()))
