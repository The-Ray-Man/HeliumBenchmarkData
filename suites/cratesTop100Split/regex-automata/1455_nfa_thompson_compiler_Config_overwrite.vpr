  axiom inhabited_nfa$col$$col$thompson$col$$col$compiler$col$$col$Config {
    inhabited(s_nfa$col$$col$thompson$col$$col$compiler$col$$col$Config_type()) ==
    (inhabited(s_core$col$$col$option$col$$col$Option_type(s_Bool_type())) &&
    (inhabited(s_core$col$$col$option$col$$col$Option_type(s_Bool_type())) &&
    inhabited(s_core$col$$col$option$col$$col$Option_type(s_core$col$$col$option$col$$col$Option_type(s_UInt_usize_type())))) &&
    (inhabited(s_core$col$$col$option$col$$col$Option_type(s_Bool_type())) &&
    (inhabited(s_core$col$$col$option$col$$col$Option_type(s_nfa$col$$col$thompson$col$$col$compiler$col$$col$WhichCaptures_type())) &&
    inhabited(s_core$col$$col$option$col$$col$Option_type(s_util$col$$col$look$col$$col$LookMatcher_type())))))
