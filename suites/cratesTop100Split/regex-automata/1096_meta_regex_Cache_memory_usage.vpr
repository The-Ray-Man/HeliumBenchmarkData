    inhabited(s_util$col$$col$captures$col$$col$Captures_type()) ==
    (inhabited(s_util$col$$col$captures$col$$col$GroupInfo_type()) &&
    (inhabited(s_core$col$$col$option$col$$col$Option_type(s_util$col$$col$primitives$col$$col$PatternID_type())) &&
    inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_core$col$$col$option$col$$col$Option_type(s_util$col$$col$primitives$col$$col$NonMaxUsize_type()), s_std$col$$col$alloc$col$$col$Global_type()))))
  }
  
