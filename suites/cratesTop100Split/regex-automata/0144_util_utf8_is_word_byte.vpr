domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_Bool  {
  
  axiom s_Param_typ_def_make_generic_s_Bool {
    (forall x: Bool ::
      { make_generic_s_Bool(x) }
      s_Param_typ(make_generic_s_Bool(x)) == s_Bool_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_Bool {
    (forall p: s_Param ::
      { p.make_concrete_s_Bool, s_Param_typ(p) }
      s_Param_typ(p) == s_Bool_type() ==>
      make_generic_s_Bool(p.make_concrete_s_Bool) == p)
  }
}

domain s_UInt_u8  {
  
  function s_UInt_u8_cons(arg0: Int): s_UInt_u8 
  
  function s_UInt_u8_value(arg0: s_UInt_u8): Int 
  
  axiom s_UInt_u8_ax_cons {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      s_UInt_u8_cons(s_UInt_u8_value(s)) == s)
  }
  
  axiom s_UInt_u8_ax_bounds {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      0 <= s_UInt_u8_value(s) && s_UInt_u8_value(s) <= 255)
  }
  
  axiom s_UInt_u8_ax_value {
    (forall value: Int ::
      { s_UInt_u8_cons(value) }
      0 <= value && value <= 255 ==>
      s_UInt_u8_value(s_UInt_u8_cons(value)) == value)
  }
}

