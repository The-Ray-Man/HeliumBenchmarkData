  function s_Int_isize_cons(arg0: Int): s_Int_isize 
  
  function s_Int_isize_value(arg0: s_Int_isize): Int 
  
  axiom s_Int_isize_ax_cons {
    (forall s: s_Int_isize ::
      { s_Int_isize_value(s) }
      s_Int_isize_cons(s_Int_isize_value(s)) == s)
  }
  
  axiom s_Int_isize_ax_bounds {
    (forall s: s_Int_isize ::
      { s_Int_isize_value(s) }
      -9223372036854775808 <= s_Int_isize_value(s) &&
      s_Int_isize_value(s) <= 9223372036854775807)
  }
  
  axiom s_Int_isize_ax_value {
    (forall value: Int ::
      { s_Int_isize_cons(value) }
      -9223372036854775808 <= value && value <= 9223372036854775807 ==>
      s_Int_isize_value(s_Int_isize_cons(value)) == value)
  }
}

