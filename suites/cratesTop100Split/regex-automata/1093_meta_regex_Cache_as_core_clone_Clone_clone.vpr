      s_Param_typ(make_generic_s_std$col$$col$alloc$col$$col$Global(x)) ==
      s_std$col$$col$alloc$col$$col$Global_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_std$col$$col$alloc$col$$col$Global {
    (forall p: s_Param ::
      { s_Param_has_typ(p, s_std$col$$col$alloc$col$$col$Global_type()) }
      s_Param_typ(p) == s_std$col$$col$alloc$col$$col$Global_type() ==>
      make_generic_s_std$col$$col$alloc$col$$col$Global(s_std$col$$col$alloc$col$$col$Global_cons()) ==
      p)
  }
  
  axiom make_generic_s_std$col$$col$alloc$col$$col$Global_unit {
    (forall p: s_Param ::
      { p.make_concrete_s_std$col$$col$alloc$col$$col$Global }
      p.make_concrete_s_std$col$$col$alloc$col$$col$Global ==
      s_std$col$$col$alloc$col$$col$Global_cons())
  }
}

