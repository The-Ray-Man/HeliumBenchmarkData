      (inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(s_alloc$col$$col$sync$col$$col$ArcInner_type(T$0))) &&
      (inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(s_alloc$col$$col$sync$col$$col$ArcInner_type(T$0))) &&
      inhabited(A$1))))
  }
  
  axiom inhabited_core$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
