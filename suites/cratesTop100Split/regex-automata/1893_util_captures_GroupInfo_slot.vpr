    inhabited(s_util$col$$col$captures$col$$col$GroupInfo_type()) ==
    inhabited(s_std$col$$col$sync$col$$col$Arc_type(s_util$col$$col$captures$col$$col$GroupInfoInner_type(), s_std$col$$col$alloc$col$$col$Global_type()))
  }
  
