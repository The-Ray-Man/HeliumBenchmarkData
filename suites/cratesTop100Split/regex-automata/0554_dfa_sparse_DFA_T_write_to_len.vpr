domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_dfa$col$$col$sparse$col$$col$DFA {
    (forall T$0: Type ::
      { inhabited(s_dfa$col$$col$sparse$col$$col$DFA_type(T$0)) }
      inhabited(s_dfa$col$$col$sparse$col$$col$DFA_type(T$0)) ==
      (inhabited(s_dfa$col$$col$sparse$col$$col$Transitions_type(T$0)) &&
      (inhabited(s_dfa$col$$col$sparse$col$$col$StartTable_type(T$0)) &&
      inhabited(s_dfa$col$$col$special$col$$col$Special_type())) &&
      (inhabited(s_core$col$$col$option$col$$col$Option_type(s_util$col$$col$prefilter$col$$col$Prefilter_type())) &&
      (inhabited(s_util$col$$col$alphabet$col$$col$ByteSet_type()) &&
      inhabited(s_dfa$col$$col$dense$col$$col$Flags_type())))))
  }
  
  axiom inhabited_dfa$col$$col$sparse$col$$col$Transitions {
    (forall T$0: Type ::
      { inhabited(s_dfa$col$$col$sparse$col$$col$Transitions_type(T$0)) }
      inhabited(s_dfa$col$$col$sparse$col$$col$Transitions_type(T$0)) ==
      (inhabited(T$0) &&
      inhabited(s_util$col$$col$alphabet$col$$col$ByteClasses_type()) &&
      (inhabited(s_UInt_usize_type()) && inhabited(s_UInt_usize_type()))))
  }
  
  axiom inhabited_util$col$$col$alphabet$col$$col$ByteClasses {
    inhabited(s_util$col$$col$alphabet$col$$col$ByteClasses_type()) ==
    inhabited(s_Array_type(s_UInt_u8_type(), s_UInt_usize_cons(256)))
  }
  
  axiom inhabited_Array {
    (forall U$1: Type, M$0: s_UInt_usize ::
      { inhabited(s_Array_type(U$1, M$0)) }
      inhabited(s_Array_type(U$1, M$0)) ==
      (M$0 == s_UInt_usize_cons(0) || inhabited(U$1)))
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
