domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_UInt_usize  {
  
  axiom s_Param_typ_def_make_generic_s_UInt_usize {
    (forall x: s_UInt_usize ::
      { make_generic_s_UInt_usize(x) }
      s_Param_typ(make_generic_s_UInt_usize(x)) == s_UInt_usize_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_UInt_usize {
    (forall p: s_Param ::
      { p.make_concrete_s_UInt_usize, s_Param_typ(p) }
      s_Param_typ(p) == s_UInt_usize_type() ==>
      make_generic_s_UInt_usize(p.make_concrete_s_UInt_usize) == p)
  }
}

