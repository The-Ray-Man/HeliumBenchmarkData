domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_core$col$$col$iter$col$$col$Enumerate {
    (forall I$0: Type ::
      { inhabited(s_core$col$$col$iter$col$$col$Enumerate_type(I$0)) }
      inhabited(s_core$col$$col$iter$col$$col$Enumerate_type(I$0)) ==
      (inhabited(I$0) && inhabited(s_UInt_usize_type())))
  }
  
  axiom inhabited_core$col$$col$slice$col$$col$Iter {
    (forall T$1: Type ::
      { inhabited(s_core$col$$col$slice$col$$col$Iter_type(T$1)) }
      inhabited(s_core$col$$col$slice$col$$col$Iter_type(T$1)) ==
      (inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$1)) &&
      (inhabited(s_RawPtr_immutable_type(T$1)) &&
      inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(s_Ref_immutable_type(T$1))))))
  }
  
  axiom inhabited_core$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_core$col$$col$marker$col$$col$PhantomData {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(T$0)) }
      inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(T$0)) ==
      true)
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_util$col$$col$search$col$$col$PatternSetIter {
    inhabited(s_util$col$$col$search$col$$col$PatternSetIter_type()) ==
    inhabited(s_core$col$$col$iter$col$$col$Enumerate_type(s_core$col$$col$slice$col$$col$Iter_type(s_Bool_type())))
  }
  
  axiom inhabited_util$col$$col$search$col$$col$PatternSet {
    inhabited(s_util$col$$col$search$col$$col$PatternSet_type()) ==
    (inhabited(s_UInt_usize_type()) &&
    inhabited(s_std$col$$col$boxed$col$$col$Box_type(s_Slice_type(s_Bool_type()), s_std$col$$col$alloc$col$$col$Global_type())))
  }
  
  axiom inhabited_std$col$$col$boxed$col$$col$Box {
    (forall T$0: Type, A$1: Type ::
      { inhabited(s_std$col$$col$boxed$col$$col$Box_type(T$0, A$1)) }
      inhabited(s_std$col$$col$boxed$col$$col$Box_type(T$0, A$1)) ==
      (inhabited(s_core$col$$col$ptr$col$$col$Unique_type(T$0)) &&
      (inhabited(A$1) && inhabited(T$0))))
  }
  
  axiom inhabited_core$col$$col$ptr$col$$col$Unique {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$ptr$col$$col$Unique_type(T$0)) }
      inhabited(s_core$col$$col$ptr$col$$col$Unique_type(T$0)) ==
      (inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) &&
      inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_std$col$$col$alloc$col$$col$Global {
    inhabited(s_std$col$$col$alloc$col$$col$Global_type()) == true
  }
}

