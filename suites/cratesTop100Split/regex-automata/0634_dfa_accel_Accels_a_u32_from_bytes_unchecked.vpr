  axiom inhabited_dfa$col$$col$accel$col$$col$Accels {
    (forall A$0: Type ::
      { inhabited(s_dfa$col$$col$accel$col$$col$Accels_type(A$0)) }
      inhabited(s_dfa$col$$col$accel$col$$col$Accels_type(A$0)) ==
      inhabited(A$0))
