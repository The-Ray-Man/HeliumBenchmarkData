      { make_generic_s_2_Tuple(x, T$0, U$1) }
      s_Param_typ(make_generic_s_2_Tuple(x, T$0, U$1)) ==
      s_2_Tuple_type(T$0, U$1))
  }
  
  axiom s_Param_typ_variant_make_generic_s_2_Tuple {
    (forall p: s_Param ::
      { p.make_concrete_s_2_Tuple, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_2_Tuple_type(s_Param_typ(p).s_2_Tuple_typaram_T$0, s_Param_typ(p).s_2_Tuple_typaram_U$1) ==>
      make_generic_s_2_Tuple(p.make_concrete_s_2_Tuple, s_Param_typ(p).s_2_Tuple_typaram_T$0, s_Param_typ(p).s_2_Tuple_typaram_U$1) ==
