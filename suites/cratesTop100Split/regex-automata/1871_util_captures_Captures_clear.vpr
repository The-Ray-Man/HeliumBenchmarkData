  axiom s_Param_typ_def_make_generic_s_util$col$$col$captures$col$$col$Captures {
    (forall x: s_util$col$$col$captures$col$$col$Captures ::
      { make_generic_s_util$col$$col$captures$col$$col$Captures(x) }
      s_Param_typ(make_generic_s_util$col$$col$captures$col$$col$Captures(x)) ==
      s_util$col$$col$captures$col$$col$Captures_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_util$col$$col$captures$col$$col$Captures {
    (forall p: s_Param ::
      { p.make_concrete_s_util$col$$col$captures$col$$col$Captures, s_Param_typ(p) }
      s_Param_typ(p) == s_util$col$$col$captures$col$$col$Captures_type() ==>
      make_generic_s_util$col$$col$captures$col$$col$Captures(p.make_concrete_s_util$col$$col$captures$col$$col$Captures) ==
      p)
  }
}

