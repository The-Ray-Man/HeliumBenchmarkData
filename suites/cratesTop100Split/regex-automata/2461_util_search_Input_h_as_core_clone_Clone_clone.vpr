    inhabited(s_util$col$$col$primitives$col$$col$PatternID_type()) ==
    inhabited(s_util$col$$col$primitives$col$$col$SmallIndex_type())
  }
  
  axiom inhabited_util$col$$col$search$col$$col$Anchored {
    inhabited(s_util$col$$col$search$col$$col$Anchored_type()) ==
    (true ||
    (true ||
    inhabited(s_util$col$$col$primitives$col$$col$PatternID_type())))
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_util$col$$col$search$col$$col$Input {
    inhabited(s_util$col$$col$search$col$$col$Input_type()) ==
    (inhabited(s_Ref_immutable_type(s_Slice_type(s_UInt_u8_type()))) &&
    inhabited(s_util$col$$col$search$col$$col$Span_type()) &&
    (inhabited(s_util$col$$col$search$col$$col$Anchored_type()) &&
    inhabited(s_Bool_type())))
