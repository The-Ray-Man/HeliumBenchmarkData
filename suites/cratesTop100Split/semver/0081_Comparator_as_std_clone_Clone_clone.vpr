domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_Op {
    inhabited(s_Op_type()) ==
    (true || true || (true || true) || (true || true || (true || true)))
  }
  
  axiom inhabited_UInt_u64 {
    inhabited(s_UInt_u64_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_Array {
    (forall U$1: Type, M$0: s_UInt_usize ::
      { inhabited(s_Array_type(U$1, M$0)) }
      inhabited(s_Array_type(U$1, M$0)) ==
      (M$0 == s_UInt_usize_cons(0) || inhabited(U$1)))
  }
  
  axiom inhabited_identifier$col$$col$Identifier {
    inhabited(s_identifier$col$$col$Identifier_type()) ==
    (inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(s_UInt_u8_type())) &&
    inhabited(s_Array_type(s_UInt_u8_type(), s_UInt_usize_cons(0))))
  }
  
  axiom inhabited_Prerelease {
    inhabited(s_Prerelease_type()) ==
    inhabited(s_identifier$col$$col$Identifier_type())
  }
  
  axiom inhabited_Comparator {
    inhabited(s_Comparator_type()) ==
    (inhabited(s_Op_type()) && inhabited(s_UInt_u64_type()) &&
    (inhabited(s_std$col$$col$option$col$$col$Option_type(s_UInt_u64_type())) &&
    (inhabited(s_std$col$$col$option$col$$col$Option_type(s_UInt_u64_type())) &&
    inhabited(s_Prerelease_type()))))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
}

