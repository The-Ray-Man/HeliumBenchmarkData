domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$result$col$$col$Result {
    (forall T$0: Type, E$1: Type ::
      { inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) }
      inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) ==
      (inhabited(T$0) || inhabited(E$1)))
  }
  
  axiom inhabited_2_Tuple {
    (forall T$0: Type, U$1: Type ::
      { inhabited(s_2_Tuple_type(T$0, U$1)) }
      inhabited(s_2_Tuple_type(T$0, U$1)) ==
      (inhabited(T$0) && inhabited(U$1)))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_parse$col$$col$Error {
    inhabited(s_parse$col$$col$Error_type()) ==
    inhabited(s_error$col$$col$ErrorKind_type())
  }
  
  axiom inhabited_error$col$$col$ErrorKind {
    inhabited(s_error$col$$col$ErrorKind_type()) ==
    (true ||
    (inhabited(s_error$col$$col$Position_type()) ||
    inhabited(s_error$col$$col$Position_type()) && inhabited(s_Char_type())) ||
    (inhabited(s_error$col$$col$Position_type()) &&
    inhabited(s_Char_type()) ||
    (inhabited(s_error$col$$col$Position_type()) &&
    inhabited(s_Char_type()) ||
    inhabited(s_error$col$$col$Position_type()))) ||
    (inhabited(s_error$col$$col$Position_type()) ||
    (inhabited(s_error$col$$col$Position_type()) ||
    inhabited(s_error$col$$col$Position_type())) ||
    (inhabited(s_Char_type()) || (true || true))))
  }
  
  axiom inhabited_error$col$$col$Position {
    inhabited(s_error$col$$col$Position_type()) ==
    (true || true || (true || (true || true)))
  }
  
  axiom inhabited_Char {
    inhabited(s_Char_type()) == true
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
