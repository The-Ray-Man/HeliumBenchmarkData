function p_Never_field_discr(self: Ref): Ref
  ensures (self == null) == (result == null)


function p_Never_snap(self: Ref): s_Never
  requires acc(p_Never(self), write)
{
  (unfolding acc(p_Never(self), write) in s_Never_unreachable())
}

function p_Int_isize_snap(self: Ref): s_Int_isize
  requires acc(p_Int_isize(self), write)
{
  (unfolding acc(p_Int_isize(self), write) in self.p_Int_isize_val)
}

predicate p_Never(self: Ref) {
  inhabited(s_Int_isize_type()) &&
  acc(p_Int_isize(p_Never_field_discr(self)), write) &&
  (false && true)
}

predicate p_Int_isize(self: Ref) {
  acc(self.p_Int_isize_val, write)
}

