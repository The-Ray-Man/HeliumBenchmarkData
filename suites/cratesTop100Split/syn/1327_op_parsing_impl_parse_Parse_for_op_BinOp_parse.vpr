      s_Param_typ(make_generic_s_op$col$$col$BinOp(x)) ==
      s_op$col$$col$BinOp_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_op$col$$col$BinOp {
    (forall p: s_Param ::
      { p.make_concrete_s_op$col$$col$BinOp, s_Param_typ(p) }
      s_Param_typ(p) == s_op$col$$col$BinOp_type() ==>
      make_generic_s_op$col$$col$BinOp(p.make_concrete_s_op$col$$col$BinOp) ==
