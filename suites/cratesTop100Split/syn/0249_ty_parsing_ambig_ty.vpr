domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_ty$col$$col$Type  {
  
  axiom s_Param_typ_def_make_generic_s_ty$col$$col$Type {
    (forall x: s_ty$col$$col$Type ::
      { make_generic_s_ty$col$$col$Type(x) }
      s_Param_typ(make_generic_s_ty$col$$col$Type(x)) ==
      s_ty$col$$col$Type_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_ty$col$$col$Type {
    (forall p: s_Param ::
      { p.make_concrete_s_ty$col$$col$Type, s_Param_typ(p) }
      s_Param_typ(p) == s_ty$col$$col$Type_type() ==>
      make_generic_s_ty$col$$col$Type(p.make_concrete_s_ty$col$$col$Type) ==
      p)
  }
}

