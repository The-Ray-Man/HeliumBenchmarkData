  axiom s_Param_typ_def_make_generic_s_lit$col$$col$LitStr {
    (forall x: s_lit$col$$col$LitStr ::
      { make_generic_s_lit$col$$col$LitStr(x) }
      s_Param_typ(make_generic_s_lit$col$$col$LitStr(x)) ==
      s_lit$col$$col$LitStr_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_lit$col$$col$LitStr {
    (forall p: s_Param ::
      { p.make_concrete_s_lit$col$$col$LitStr, s_Param_typ(p) }
      s_Param_typ(p) == s_lit$col$$col$LitStr_type() ==>
      make_generic_s_lit$col$$col$LitStr(p.make_concrete_s_lit$col$$col$LitStr) ==
      p)
  }
}

