method make_generic_Str(self: Ref)
  requires acc(p_Str(self), write)
  ensures acc(p_Param(self, s_Str_type()), write)
  ensures old(make_generic_s_Str(p_Str_snap(self))) ==
    p_Param_snap(self, s_Str_type())


method make_concrete_Str(self: Ref)
  requires acc(p_Param(self, s_Str_type()), write)
  ensures acc(p_Str(self), write)
  ensures old(p_Param_snap(self, s_Str_type())) ==
    make_generic_s_Str(p_Str_snap(self))


method make_generic_Bool(self: Ref)
  requires acc(p_Bool(self), write)
  ensures acc(p_Param(self, s_Bool_type()), write)
  ensures old(make_generic_s_Bool(p_Bool_snap(self))) ==
    p_Param_snap(self, s_Bool_type())


method make_concrete_Bool(self: Ref)
  requires acc(p_Param(self, s_Bool_type()), write)
  ensures acc(p_Bool(self), write)
  ensures old(p_Param_snap(self, s_Bool_type())) ==
    make_generic_s_Bool(p_Bool_snap(self))


method make_generic_UInt_usize(self: Ref)
