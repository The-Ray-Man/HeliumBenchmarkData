field p_UInt_usize_val: s_UInt_usize

function s_Level_unreachable(): s_Level
  ensures false


function s_Level_discr(self: s_Level): s_UInt_usize
{
  (self.iss_Level_4_cons ?
    s_UInt_usize_cons(5) :
    (self.iss_Level_3_cons ?
      s_UInt_usize_cons(4) :
      (self.iss_Level_2_cons ?
        s_UInt_usize_cons(3) :
        (self.iss_Level_1_cons ?
          s_UInt_usize_cons(2) :
          s_UInt_usize_cons(1)))))
}

function s_UInt_usize_unreachable(): s_UInt_usize
  ensures false


function p_Level_field_discr(self: Ref): Ref
  ensures (self == null) == (result == null)


function p_Level_snap(self: Ref): s_Level
  requires acc(p_Level(self), write)
{
  (unfolding acc(p_Level(self), write) in
    (p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(5) ?
      (unfolding acc(p_Level_4_owned(self), write) in s_Level_4_cons()) :
      (p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(4) ?
        (unfolding acc(p_Level_3_owned(self), write) in s_Level_3_cons()) :
        (p_UInt_usize_snap(p_Level_field_discr(self)) ==
        s_UInt_usize_cons(3) ?
          (unfolding acc(p_Level_2_owned(self), write) in s_Level_2_cons()) :
          (p_UInt_usize_snap(p_Level_field_discr(self)) ==
          s_UInt_usize_cons(2) ?
            (unfolding acc(p_Level_1_owned(self), write) in
              s_Level_1_cons()) :
            (p_UInt_usize_snap(p_Level_field_discr(self)) ==
            s_UInt_usize_cons(1) ?
              (unfolding acc(p_Level_0_owned(self), write) in
                s_Level_0_cons()) :
              s_Level_unreachable()))))))
}

function p_UInt_usize_snap(self: Ref): s_UInt_usize
  requires acc(p_UInt_usize(self), write)
{
  (unfolding acc(p_UInt_usize(self), write) in self.p_UInt_usize_val)
}

predicate p_Level_0_owned(self: Ref) {
  true
}

predicate p_Level_1_owned(self: Ref) {
  true
}

predicate p_Level_2_owned(self: Ref) {
  true
}

predicate p_Level_3_owned(self: Ref) {
  true
}

predicate p_Level_4_owned(self: Ref) {
  true
}

predicate p_Level(self: Ref) {
  inhabited(s_UInt_usize_type()) &&
  acc(p_UInt_usize(p_Level_field_discr(self)), write) &&
  ((p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(1) ||
  p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(2) ||
  (p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(3) ||
  (p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(4) ||
  p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(5)))) &&
  ((p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(1) ==>
  true && acc(p_Level_0_owned(self), write)) &&
  (p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(2) ==>
  true && acc(p_Level_1_owned(self), write)) &&
  ((p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(3) ==>
  true && acc(p_Level_2_owned(self), write)) &&
  ((p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(4) ==>
  true && acc(p_Level_3_owned(self), write)) &&
  (p_UInt_usize_snap(p_Level_field_discr(self)) == s_UInt_usize_cons(5) ==>
  true && acc(p_Level_4_owned(self), write))))))
}

predicate p_UInt_usize(self: Ref) {
  acc(self.p_UInt_usize_val, write)
}

method m_Level$col$$col$max(_0p: Ref)
  ensures inhabited(s_Level_type()) && acc(p_Level(_0p), write)
{
  label start
  goto bb_0
  label bb_0
  label _before_0_0
  p_Level_assign(_0p, s_Level_4_cons())
  label _before_0_1
  label package_post0
  goto end
  label end
}

method p_Level_assign(self: Ref, value: s_Level)
  ensures acc(p_Level(self), write)
  ensures p_Level_snap(self) == value


method p_UInt_usize_assign(self: Ref, value: s_UInt_usize)
  ensures acc(p_UInt_usize(self), write)
  ensures p_UInt_usize_snap(self) == value


