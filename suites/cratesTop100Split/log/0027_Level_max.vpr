  axiom s_UInt_usize_Sized {
    core$col$$col$marker$col$$col$Sized_impl(s_UInt_usize_type())
  }
  
  axiom s_UInt_usize_MetaSized {
    core$col$$col$marker$col$$col$MetaSized_impl(s_UInt_usize_type())
