  ensures acc(p_Param(self, s_Str_type()), write)
  ensures old(make_generic_s_Str(p_Str_snap(self))) ==
    p_Param_snap(self, s_Str_type())


method make_concrete_Str(self: Ref)
  requires acc(p_Param(self, s_Str_type()), write)
  ensures acc(p_Str(self), write)
  ensures old(p_Param_snap(self, s_Str_type())) ==
    make_generic_s_Str(p_Str_snap(self))


