  ensures old(p_Param_snap(self, s_Array_type(U$1, M$0))) ==
    make_generic_s_Array(p_Array_snap(self, U$1, M$0), U$1, M$0)


method make_generic_Ref_immutable(self: Ref, U$1: Type)
  requires acc(p_Ref_immutable(self, U$1), write)
  ensures acc(p_Param(self, s_Ref_immutable_type(U$1)), write)
  ensures old(make_generic_s_Ref_immutable(p_Ref_immutable_snap(self, U$1), U$1)) ==
    p_Param_snap(self, s_Ref_immutable_type(U$1))


method make_concrete_Ref_immutable(self: Ref, U$1: Type)
  requires acc(p_Param(self, s_Ref_immutable_type(U$1)), write)
  ensures acc(p_Ref_immutable(self, U$1), write)
  ensures old(p_Param_snap(self, s_Ref_immutable_type(U$1))) ==
    make_generic_s_Ref_immutable(p_Ref_immutable_snap(self, U$1), U$1)


method p_Ref_immutable_assign(self: Ref, U$1: Type, value: s_Ref_immutable)
  ensures acc(p_Ref_immutable(self, U$1), write)
  ensures p_Ref_immutable_snap(self, U$1) == value


method p_Param_assign(self: Ref, T$0: Type, value: s_Param)
  ensures acc(p_Param(self, T$0), write)
  ensures p_Param_snap(self, T$0) == value


method p_Str_assign(self: Ref, value: s_Str)
  ensures acc(p_Str(self), write)
  ensures p_Str_snap(self) == value


method p_Level_assign(self: Ref, value: s_Level)
  ensures acc(p_Level(self), write)
  ensures p_Level_snap(self) == value


method p_UInt_usize_assign(self: Ref, value: s_UInt_usize)
  ensures acc(p_UInt_usize(self), write)
  ensures p_UInt_usize_snap(self) == value


method p_Array_assign(self: Ref, U$1: Type, M$0: s_UInt_usize, value: s_Array)
  ensures acc(p_Array(self, U$1, M$0), write)
  ensures p_Array_snap(self, U$1, M$0) == value


method p_Array_fold_index(index: Int, self: Ref, U$1: Type, M$0: s_UInt_usize)
  requires inhabited(U$1) &&
    acc(p_Param(s_Array_index_ref(self, index, U$1), U$1), write)
  requires acc(p_Array_index(self, index, U$1, M$0), write)
  ensures acc(p_Array(self, U$1, M$0), write)
  ensures (forall idx: Int ::
      { s_Array_index(p_Array_snap(self, U$1, M$0), idx) }
      s_Array_index(p_Array_snap(self, U$1, M$0), idx) ==
      (idx == index ?
        old(p_Param_snap(s_Array_index_ref(self, index, U$1), U$1)) :
        old(s_Array_index(p_Array_index_frame(self, index, U$1, M$0), idx))))


method p_Array_unfold_index(index: Int, self: Ref, U$1: Type, M$0: s_UInt_usize)
  requires acc(p_Array(self, U$1, M$0), write)
  ensures inhabited(U$1) &&
    acc(p_Param(s_Array_index_ref(self, index, U$1), U$1), write)
  ensures acc(p_Array_index(self, index, U$1, M$0), write)
  ensures p_Param_snap(s_Array_index_ref(self, index, U$1), U$1) ==
    old(s_Array_index(p_Array_snap(self, U$1, M$0), index))
  ensures p_Array_index_frame(self, index, U$1, M$0) ==
    old(p_Array_snap(self, U$1, M$0))


method p_Bool_assign(self: Ref, value: Bool)
  ensures acc(p_Bool(self), write)
  ensures p_Bool_snap(self) == value


adt s_Param {
  make_generic_s_Str(make_concrete_s_Str: s_Str)
  make_generic_s_UInt_usize(make_concrete_s_UInt_usize: s_UInt_usize)
  make_generic_s_Level(make_concrete_s_Level: s_Level)
  make_generic_s_0_Tuple(make_concrete_s_0_Tuple: s_0_Tuple)
  make_generic_s_Array(make_concrete_s_Array: s_Array, make_generic_s_Array_typaram_U$1: Type,
  make_generic_s_Array_constparam_M$0: s_UInt_usize)
  make_generic_s_Ref_immutable(make_concrete_s_Ref_immutable: s_Ref_immutable,
  make_generic_s_Ref_immutable_typaram_U$1: Type)
  s_Param_Unknown(s_Param_Unknown_id: Int)
}

adt s_Ref_immutable {
  s_Ref_immutable_cons(s_Ref_immutable_0: Ref, s_Ref_immutable_1: s_Param, s_Ref_immutable_2: s_Param)
}

adt s_Level {
  s_Level_0_cons()
  s_Level_1_cons()
  s_Level_2_cons()
  s_Level_3_cons()
  s_Level_4_cons()
}

adt s_0_Tuple {
  s_0_Tuple_cons()
}

adt Type {
  s_Ref_immutable_type(s_Ref_immutable_typaram_U$1: Type)
  s_Str_type()
  s_UInt_usize_type()
  s_Level_type()
  s_0_Tuple_type()
  s_Array_type(s_Array_typaram_U$1: Type, s_Array_constparam_M$0: s_UInt_usize)
  s_Bool_type()
  Unknown_type(id: Int)
}