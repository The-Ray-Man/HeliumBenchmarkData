  ensures old(make_generic_s_Array(p_Array_snap(self, U$1, M$0), U$1, M$0)) ==
    p_Param_snap(self, s_Array_type(U$1, M$0))


method make_concrete_Array(self: Ref, U$1: Type, M$0: s_UInt_usize)
