    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_Str  {
  
  axiom s_Param_typ_def_make_generic_s_Str {
    (forall x: s_Str ::
      { make_generic_s_Str(x) }
