domain MetadataCast  {
  
  function metadata_cast(arg0: s_Param, arg1: Type, arg2: Type): s_Param 
  
  axiom metadata_cast_eq {
    (forall input: s_Param, same: Type ::
      { metadata_cast(input, same, same) }
      metadata_cast(input, same, same) == input)
  }
}

domain UnsizeValueCast  {
  
  function unsize_value_cast(arg0: s_Param, arg1: Type, arg2: Type): s_Param 
  
  axiom unsize_value_cast_eq {
    (forall input: s_Param, same: Type ::
      { unsize_value_cast(input, same, same) }
      unsize_value_cast(input, same, same) == input)
  }
}

domain MetadataCastArraySlice  {
  
  axiom metadata_cast_array_slice {
    (forall input: s_Param, U$1: Type, M$0: s_UInt_usize ::
      { metadata_cast(input, s_Array_type(U$1, M$0), s_Slice_type(U$1)) }
      metadata_cast(input, s_Array_type(U$1, M$0), s_Slice_type(U$1)) ==
      make_generic_s_UInt_usize(M$0))
  }
}

domain UnsizeValueCastArraySlice  {
  
  axiom unsize_value_cast_array_slice {
    (forall arr: s_Array, U$1: Type, M$0: s_UInt_usize ::
      { unsize_value_cast(make_generic_s_Array(arr, U$1, M$0), s_Array_type(U$1, M$0),
      s_Slice_type(U$1)) }
      (forall idx: Int ::
        { s_Array_index(arr, idx) }
        s_Array_index(arr, idx) ==
        s_Slice_index(unsize_value_cast(make_generic_s_Array(arr, U$1, M$0),
        s_Array_type(U$1, M$0), s_Slice_type(U$1)).make_concrete_s_Slice, idx)))
  }
}

domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_8_Tuple  {
  
  axiom s_Param_typ_def_make_generic_s_8_Tuple {
    (forall x: s_8_Tuple, T$0: Type, U$1: Type, V$2: Type, T3$3: Type, T4$4: Type,
    T5$5: Type, T6$6: Type, T7$7: Type ::
      { make_generic_s_8_Tuple(x, T$0, U$1, V$2, T3$3, T4$4, T5$5, T6$6, T7$7) }
      s_Param_typ(make_generic_s_8_Tuple(x, T$0, U$1, V$2, T3$3, T4$4, T5$5, T6$6, T7$7)) ==
      s_8_Tuple_type(T$0, U$1, V$2, T3$3, T4$4, T5$5, T6$6, T7$7))
  }
  
  axiom s_Param_typ_variant_make_generic_s_8_Tuple {
    (forall p: s_Param ::
      { p.make_concrete_s_8_Tuple, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_8_Tuple_type(s_Param_typ(p).s_8_Tuple_typaram_T$0, s_Param_typ(p).s_8_Tuple_typaram_U$1, s_Param_typ(p).s_8_Tuple_typaram_V$2, s_Param_typ(p).s_8_Tuple_typaram_T3$3, s_Param_typ(p).s_8_Tuple_typaram_T4$4, s_Param_typ(p).s_8_Tuple_typaram_T5$5, s_Param_typ(p).s_8_Tuple_typaram_T6$6, s_Param_typ(p).s_8_Tuple_typaram_T7$7) ==>
      make_generic_s_8_Tuple(p.make_concrete_s_8_Tuple, s_Param_typ(p).s_8_Tuple_typaram_T$0, s_Param_typ(p).s_8_Tuple_typaram_U$1, s_Param_typ(p).s_8_Tuple_typaram_V$2, s_Param_typ(p).s_8_Tuple_typaram_T3$3, s_Param_typ(p).s_8_Tuple_typaram_T4$4, s_Param_typ(p).s_8_Tuple_typaram_T5$5, s_Param_typ(p).s_8_Tuple_typaram_T6$6, s_Param_typ(p).s_8_Tuple_typaram_T7$7) ==
      p)
  }
}

