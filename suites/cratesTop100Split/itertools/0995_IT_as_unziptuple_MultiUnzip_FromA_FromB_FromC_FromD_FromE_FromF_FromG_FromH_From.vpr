  }
  
  axiom s_Param_typ_variant_make_generic_s_10_Tuple {
    (forall p: s_Param ::
      { p.make_concrete_s_10_Tuple, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_10_Tuple_type(s_Param_typ(p).s_10_Tuple_typaram_T$0, s_Param_typ(p).s_10_Tuple_typaram_U$1, s_Param_typ(p).s_10_Tuple_typaram_V$2, s_Param_typ(p).s_10_Tuple_typaram_T3$3, s_Param_typ(p).s_10_Tuple_typaram_T4$4, s_Param_typ(p).s_10_Tuple_typaram_T5$5, s_Param_typ(p).s_10_Tuple_typaram_T6$6, s_Param_typ(p).s_10_Tuple_typaram_T7$7, s_Param_typ(p).s_10_Tuple_typaram_T8$8, s_Param_typ(p).s_10_Tuple_typaram_T9$9) ==>
