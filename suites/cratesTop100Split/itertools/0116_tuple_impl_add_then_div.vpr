  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_core$col$$col$panicking$col$$col$AssertKind {
    inhabited(s_core$col$$col$panicking$col$$col$AssertKind_type()) ==
    (true || (true || true))
  }
  
  axiom inhabited_std$col$$col$fmt$col$$col$Arguments {
    inhabited(s_std$col$$col$fmt$col$$col$Arguments_type()) ==
    (inhabited(s_Ref_immutable_type(s_Slice_type(s_Ref_immutable_type(s_Str_type())))) &&
    (inhabited(s_std$col$$col$option$col$$col$Option_type(s_Ref_immutable_type(s_Slice_type(s_core$col$$col$fmt$col$$col$rt$col$$col$Placeholder_type())))) &&
    inhabited(s_Ref_immutable_type(s_Slice_type(s_core$col$$col$fmt$col$$col$rt$col$$col$Argument_type())))))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_core$col$$col$fmt$col$$col$rt$col$$col$Placeholder {
    inhabited(s_core$col$$col$fmt$col$$col$rt$col$$col$Placeholder_type()) ==
    (inhabited(s_UInt_usize_type()) && inhabited(s_UInt_u32_type()) &&
    (inhabited(s_core$col$$col$fmt$col$$col$rt$col$$col$Count_type()) &&
    inhabited(s_core$col$$col$fmt$col$$col$rt$col$$col$Count_type())))
  }
  
  axiom inhabited_UInt_u32 {
    inhabited(s_UInt_u32_type()) == true
  }
  
  axiom inhabited_core$col$$col$fmt$col$$col$rt$col$$col$Count {
    inhabited(s_core$col$$col$fmt$col$$col$rt$col$$col$Count_type()) ==
    (inhabited(s_UInt_u16_type()) ||
    (inhabited(s_UInt_usize_type()) || true))
  }
  
  axiom inhabited_UInt_u16 {
    inhabited(s_UInt_u16_type()) == true
  }
  
  axiom inhabited_core$col$$col$fmt$col$$col$rt$col$$col$Argument {
    inhabited(s_core$col$$col$fmt$col$$col$rt$col$$col$Argument_type()) ==
    inhabited(s_core$col$$col$fmt$col$$col$rt$col$$col$ArgumentType_type())
