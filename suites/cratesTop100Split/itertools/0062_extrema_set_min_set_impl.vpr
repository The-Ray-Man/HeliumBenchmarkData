  axiom inhabited_std$col$$col$marker$col$$col$PhantomData {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) }
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) ==
      true)
