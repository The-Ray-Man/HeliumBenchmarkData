domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_5_Tuple {
    (forall T$0: Type, U$1: Type, V$2: Type, T3$3: Type, T4$4: Type ::
      { inhabited(s_5_Tuple_type(T$0, U$1, V$2, T3$3, T4$4)) }
      inhabited(s_5_Tuple_type(T$0, U$1, V$2, T3$3, T4$4)) ==
      (inhabited(T$0) && inhabited(U$1) &&
      (inhabited(V$2) && (inhabited(T3$3) && inhabited(T4$4)))))
  }
  
  axiom inhabited_std$col$$col$ops$col$$col$ControlFlow {
    (forall B$0: Type, C$1: Type ::
      { inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) }
      inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) ==
      (inhabited(C$1) || inhabited(B$0)))
  }
  
  axiom inhabited_std$col$$col$convert$col$$col$Infallible {
    inhabited(s_std$col$$col$convert$col$$col$Infallible_type()) == false
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Item {
    (forall A$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)) }
      inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)) ==
      inhabited(s_std$col$$col$option$col$$col$Option_type(A$0)))
  }
  
  axiom inhabited_std$col$$col$option$col$$col$IntoIter {
    (forall A$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$IntoIter_type(A$0)) }
      inhabited(s_std$col$$col$option$col$$col$IntoIter_type(A$0)) ==
      inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)))
  }
  
  axiom inhabited_std$col$$col$option$col$$col$IterMut {
    (forall A$1: Type ::
      { inhabited(s_std$col$$col$option$col$$col$IterMut_type(A$1)) }
      inhabited(s_std$col$$col$option$col$$col$IterMut_type(A$1)) ==
      inhabited(s_std$col$$col$option$col$$col$Item_type(s_Ref_mutable_type(A$1))))
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_std$col$$col$ops$col$$col$index_range$col$$col$IndexRange {
    inhabited(s_std$col$$col$ops$col$$col$index_range$col$$col$IndexRange_type()) ==
    (inhabited(s_UInt_usize_type()) && inhabited(s_UInt_usize_type()))
  }
  
  axiom inhabited_std$col$$col$array$col$$col$iter$col$$col$iter_inner$col$$col$PolymorphicIter {
    (forall DATA$0: Type ::
      { inhabited(s_std$col$$col$array$col$$col$iter$col$$col$iter_inner$col$$col$PolymorphicIter_type(DATA$0)) }
      inhabited(s_std$col$$col$array$col$$col$iter$col$$col$iter_inner$col$$col$PolymorphicIter_type(DATA$0)) ==
      (inhabited(s_std$col$$col$ops$col$$col$index_range$col$$col$IndexRange_type()) &&
      inhabited(DATA$0)))
  }
  
  axiom inhabited_Array {
    (forall U$1: Type, M$0: s_UInt_usize ::
      { inhabited(s_Array_type(U$1, M$0)) }
      inhabited(s_Array_type(U$1, M$0)) ==
      (M$0 == s_UInt_usize_cons(0) || inhabited(U$1)))
  }
  
  axiom inhabited_std$col$$col$mem$col$$col$MaybeUninit {
