domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_12_Tuple {
    (forall T$0: Type, U$1: Type, V$2: Type, T3$3: Type, T4$4: Type, T5$5: Type,
    T6$6: Type, T7$7: Type, T8$8: Type, T9$9: Type, T10$10: Type, T11$11: Type ::
      { inhabited(s_12_Tuple_type(T$0, U$1, V$2, T3$3, T4$4, T5$5, T6$6, T7$7, T8$8, T9$9, T10$10, T11$11)) }
      inhabited(s_12_Tuple_type(T$0, U$1, V$2, T3$3, T4$4, T5$5, T6$6, T7$7, T8$8, T9$9, T10$10, T11$11)) ==
      (inhabited(T$0) && (inhabited(U$1) && inhabited(V$2)) &&
      (inhabited(T3$3) && (inhabited(T4$4) && inhabited(T5$5))) &&
      (inhabited(T6$6) && (inhabited(T7$7) && inhabited(T8$8)) &&
      (inhabited(T9$9) && (inhabited(T10$10) && inhabited(T11$11))))))
  }
  
  axiom inhabited_std$col$$col$ops$col$$col$ControlFlow {
    (forall B$0: Type, C$1: Type ::
      { inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) }
      inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) ==
      (inhabited(C$1) || inhabited(B$0)))
  }
  
  axiom inhabited_std$col$$col$convert$col$$col$Infallible {
    inhabited(s_std$col$$col$convert$col$$col$Infallible_type()) == false
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Item {
    (forall A$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)) }
      inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)) ==
      inhabited(s_std$col$$col$option$col$$col$Option_type(A$0)))
  }
  
  axiom inhabited_std$col$$col$option$col$$col$IntoIter {
    (forall A$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$IntoIter_type(A$0)) }
      inhabited(s_std$col$$col$option$col$$col$IntoIter_type(A$0)) ==
