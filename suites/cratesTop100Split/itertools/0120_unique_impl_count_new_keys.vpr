      s_Param_typ(make_generic_s_std$col$$col$collections$col$$col$HashMap(x, K$0, V$1, S$2)) ==
      s_std$col$$col$collections$col$$col$HashMap_type(K$0, V$1, S$2))
  }
  
  axiom s_Param_typ_variant_make_generic_s_std$col$$col$collections$col$$col$HashMap {
    (forall p: s_Param ::
      { p.make_concrete_s_std$col$$col$collections$col$$col$HashMap, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_std$col$$col$collections$col$$col$HashMap_type(s_Param_typ(p).s_std$col$$col$collections$col$$col$HashMap_typaram_K$0, s_Param_typ(p).s_std$col$$col$collections$col$$col$HashMap_typaram_V$1, s_Param_typ(p).s_std$col$$col$collections$col$$col$HashMap_typaram_S$2) ==>
