domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_Array {
    (forall U$1: Type, M$0: s_UInt_usize ::
      { inhabited(s_Array_type(U$1, M$0)) }
      inhabited(s_Array_type(U$1, M$0)) ==
      (M$0 == s_UInt_usize_cons(0) || inhabited(U$1)))
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_std$col$$col$mem$col$$col$MaybeUninit {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$mem$col$$col$MaybeUninit_type(T$0)) }
      inhabited(s_std$col$$col$mem$col$$col$MaybeUninit_type(T$0)) == true)
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_next_array$col$$col$ArrayBuilder {
    (forall T$0: Type, N$1: s_UInt_usize ::
      { inhabited(s_next_array$col$$col$ArrayBuilder_type(T$0, N$1)) }
      inhabited(s_next_array$col$$col$ArrayBuilder_type(T$0, N$1)) ==
      (inhabited(s_Array_type(s_std$col$$col$mem$col$$col$MaybeUninit_type(T$0), N$1)) &&
      inhabited(s_UInt_usize_type())))
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
