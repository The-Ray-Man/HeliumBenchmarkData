domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_Ref_immutable  {
  
  axiom s_Param_typ_def_make_generic_s_Ref_immutable {
    (forall x: s_Ref_immutable, U$1: Type ::
      { make_generic_s_Ref_immutable(x, U$1) }
      s_Param_typ(make_generic_s_Ref_immutable(x, U$1)) ==
      s_Ref_immutable_type(U$1))
  }
  
  axiom s_Param_typ_variant_make_generic_s_Ref_immutable {
    (forall p: s_Param ::
      { p.make_concrete_s_Ref_immutable, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_Ref_immutable_type(s_Param_typ(p).s_Ref_immutable_typaram_U$1) ==>
      make_generic_s_Ref_immutable(p.make_concrete_s_Ref_immutable, s_Param_typ(p).s_Ref_immutable_typaram_U$1) ==
      p)
  }
}

