      { inhabited(s_pad_tail$col$$col$PadUsing_type(I$0, F$1)) }
      inhabited(s_pad_tail$col$$col$PadUsing_type(I$0, F$1)) ==
      (inhabited(s_std$col$$col$iter$col$$col$Fuse_type(I$0)) &&
      inhabited(s_UInt_usize_type()) &&
