domain MetadataCast  {
  
  function metadata_cast(arg0: s_Param, arg1: Type, arg2: Type): s_Param 
  
  axiom metadata_cast_eq {
    (forall input: s_Param, same: Type ::
      { metadata_cast(input, same, same) }
      metadata_cast(input, same, same) == input)
  }
}

domain UnsizeValueCast  {
  
  function unsize_value_cast(arg0: s_Param, arg1: Type, arg2: Type): s_Param 
  
  axiom unsize_value_cast_eq {
    (forall input: s_Param, same: Type ::
      { unsize_value_cast(input, same, same) }
      unsize_value_cast(input, same, same) == input)
  }
}

domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_0_Tuple  {
  
  axiom s_Param_typ_def_make_generic_s_0_Tuple {
    (forall x: s_0_Tuple ::
      { make_generic_s_0_Tuple(x) }
      s_Param_typ(make_generic_s_0_Tuple(x)) == s_0_Tuple_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_0_Tuple {
    (forall p: s_Param ::
      { s_Param_has_typ(p, s_0_Tuple_type()) }
      s_Param_typ(p) == s_0_Tuple_type() ==>
      make_generic_s_0_Tuple(s_0_Tuple_cons()) == p)
  }
  
  axiom make_generic_s_0_Tuple_unit {
    (forall p: s_Param ::
      { p.make_concrete_s_0_Tuple }
      p.make_concrete_s_0_Tuple == s_0_Tuple_cons())
  }
}

