  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_std$col$$col$iter$col$$col$Take {
    (forall I$0: Type ::
      { inhabited(s_std$col$$col$iter$col$$col$Take_type(I$0)) }
      inhabited(s_std$col$$col$iter$col$$col$Take_type(I$0)) ==
      (inhabited(I$0) && inhabited(s_UInt_usize_type())))
