domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_2_Tuple {
    (forall T$0: Type, U$1: Type ::
      { inhabited(s_2_Tuple_type(T$0, U$1)) }
      inhabited(s_2_Tuple_type(T$0, U$1)) ==
      (inhabited(T$0) && inhabited(U$1)))
  }
  
  axiom inhabited_std$col$$col$ops$col$$col$ControlFlow {
    (forall B$0: Type, C$1: Type ::
      { inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) }
      inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) ==
      (inhabited(C$1) || inhabited(B$0)))
  }
  
  axiom inhabited_std$col$$col$convert$col$$col$Infallible {
    inhabited(s_std$col$$col$convert$col$$col$Infallible_type()) == false
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_std$col$$col$iter$col$$col$Enumerate {
    (forall I$0: Type ::
      { inhabited(s_std$col$$col$iter$col$$col$Enumerate_type(I$0)) }
      inhabited(s_std$col$$col$iter$col$$col$Enumerate_type(I$0)) ==
      (inhabited(I$0) && inhabited(s_UInt_usize_type())))
  }
  
  axiom inhabited_std$col$$col$iter$col$$col$Cloned {
    (forall I$0: Type ::
      { inhabited(s_std$col$$col$iter$col$$col$Cloned_type(I$0)) }
      inhabited(s_std$col$$col$iter$col$$col$Cloned_type(I$0)) ==
      inhabited(I$0))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
