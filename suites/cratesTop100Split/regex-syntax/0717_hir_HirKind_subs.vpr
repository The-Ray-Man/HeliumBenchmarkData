    inhabited(s_hir$col$$col$HirKind_type()) ==
    (true || inhabited(s_hir$col$$col$Literal_type()) ||
    (inhabited(s_hir$col$$col$Class_type()) ||
    inhabited(s_hir$col$$col$Look_type())) ||
    (inhabited(s_hir$col$$col$Repetition_type()) ||
    inhabited(s_hir$col$$col$Capture_type()) ||
    (inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_hir$col$$col$Hir_type(), s_std$col$$col$alloc$col$$col$Global_type())) ||
    inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_hir$col$$col$Hir_type(), s_std$col$$col$alloc$col$$col$Global_type())))))
  }
  
  axiom inhabited_hir$col$$col$Literal {
    inhabited(s_hir$col$$col$Literal_type()) ==
    inhabited(s_std$col$$col$boxed$col$$col$Box_type(s_Slice_type(s_UInt_u8_type()), s_std$col$$col$alloc$col$$col$Global_type()))
  }
  
