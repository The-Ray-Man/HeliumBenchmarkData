    (forall T$0: Type, A$1: Type ::
      { inhabited(s_std$col$$col$vec$col$$col$Vec_type(T$0, A$1)) }
      inhabited(s_std$col$$col$vec$col$$col$Vec_type(T$0, A$1)) ==
