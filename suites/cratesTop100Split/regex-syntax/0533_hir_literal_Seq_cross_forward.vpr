    (forall x: s_hir$col$$col$literal$col$$col$Seq ::
      { make_generic_s_hir$col$$col$literal$col$$col$Seq(x) }
      s_Param_typ(make_generic_s_hir$col$$col$literal$col$$col$Seq(x)) ==
      s_hir$col$$col$literal$col$$col$Seq_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_hir$col$$col$literal$col$$col$Seq {
    (forall p: s_Param ::
      { p.make_concrete_s_hir$col$$col$literal$col$$col$Seq, s_Param_typ(p) }
      s_Param_typ(p) == s_hir$col$$col$literal$col$$col$Seq_type() ==>
      make_generic_s_hir$col$$col$literal$col$$col$Seq(p.make_concrete_s_hir$col$$col$literal$col$$col$Seq) ==
      p)
  }
}

