  axiom s_Param_typ_def_make_generic_s_ast$col$$col$ClassBracketed {
    (forall x: s_ast$col$$col$ClassBracketed ::
      { make_generic_s_ast$col$$col$ClassBracketed(x) }
      s_Param_typ(make_generic_s_ast$col$$col$ClassBracketed(x)) ==
      s_ast$col$$col$ClassBracketed_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_ast$col$$col$ClassBracketed {
    (forall p: s_Param ::
      { p.make_concrete_s_ast$col$$col$ClassBracketed, s_Param_typ(p) }
      s_Param_typ(p) == s_ast$col$$col$ClassBracketed_type() ==>
      make_generic_s_ast$col$$col$ClassBracketed(p.make_concrete_s_ast$col$$col$ClassBracketed) ==
      p)
  }
}

