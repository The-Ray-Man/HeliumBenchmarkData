domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_ast$col$$col$parse$col$$col$ParserI {
    (forall P$1: Type ::
      { inhabited(s_ast$col$$col$parse$col$$col$ParserI_type(P$1)) }
      inhabited(s_ast$col$$col$parse$col$$col$ParserI_type(P$1)) ==
      (inhabited(P$1) && inhabited(s_Ref_immutable_type(s_Str_type()))))
