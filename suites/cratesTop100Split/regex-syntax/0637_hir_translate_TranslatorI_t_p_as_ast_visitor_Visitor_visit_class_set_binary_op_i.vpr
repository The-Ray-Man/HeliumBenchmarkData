domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_core$col$$col$result$col$$col$Result {
    (forall T$0: Type, E$1: Type ::
      { inhabited(s_core$col$$col$result$col$$col$Result_type(T$0, E$1)) }
      inhabited(s_core$col$$col$result$col$$col$Result_type(T$0, E$1)) ==
      (inhabited(T$0) || inhabited(E$1)))
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_hir$col$$col$Error {
    inhabited(s_hir$col$$col$Error_type()) ==
    (inhabited(s_hir$col$$col$ErrorKind_type()) &&
    (inhabited(s_std$col$$col$string$col$$col$String_type()) &&
    inhabited(s_ast$col$$col$Span_type())))
