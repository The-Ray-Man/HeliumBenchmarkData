      { inhabited(s_ast$col$$col$parse$col$$col$ParserI_type(P$1)) }
      inhabited(s_ast$col$$col$parse$col$$col$ParserI_type(P$1)) ==
      (inhabited(P$1) && inhabited(s_Ref_immutable_type(s_Str_type()))))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_2_Tuple {
    (forall T$0: Type, U$1: Type ::
      { inhabited(s_2_Tuple_type(T$0, U$1)) }
      inhabited(s_2_Tuple_type(T$0, U$1)) ==
      (inhabited(T$0) && inhabited(U$1)))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
