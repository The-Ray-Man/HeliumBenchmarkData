  axiom inhabited_core$col$$col$ops$col$$col$ControlFlow {
    (forall B$0: Type, C$1: Type ::
      { inhabited(s_core$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) }
      inhabited(s_core$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) ==
