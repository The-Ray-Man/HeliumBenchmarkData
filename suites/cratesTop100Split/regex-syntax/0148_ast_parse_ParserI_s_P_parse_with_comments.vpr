domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_ast$col$$col$WithComments  {
  
  axiom s_Param_typ_def_make_generic_s_ast$col$$col$WithComments {
    (forall x: s_ast$col$$col$WithComments ::
      { make_generic_s_ast$col$$col$WithComments(x) }
      s_Param_typ(make_generic_s_ast$col$$col$WithComments(x)) ==
      s_ast$col$$col$WithComments_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_ast$col$$col$WithComments {
    (forall p: s_Param ::
      { p.make_concrete_s_ast$col$$col$WithComments, s_Param_typ(p) }
      s_Param_typ(p) == s_ast$col$$col$WithComments_type() ==>
      make_generic_s_ast$col$$col$WithComments(p.make_concrete_s_ast$col$$col$WithComments) ==
      p)
  }
}

