    inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_ast$col$$col$Ast_type(), s_std$col$$col$alloc$col$$col$Global_type())))
  }
  
  axiom inhabited_ast$col$$col$Span {
    inhabited(s_ast$col$$col$Span_type()) ==
    (inhabited(s_ast$col$$col$Position_type()) &&
    inhabited(s_ast$col$$col$Position_type()))
  }
  
  axiom inhabited_ast$col$$col$Position {
