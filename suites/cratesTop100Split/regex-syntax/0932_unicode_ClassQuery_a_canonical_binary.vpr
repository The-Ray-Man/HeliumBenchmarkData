  axiom inhabited_unicode$col$$col$ClassQuery {
    inhabited(s_unicode$col$$col$ClassQuery_type()) ==
    (inhabited(s_Char_type()) ||
    (inhabited(s_Ref_immutable_type(s_Str_type())) ||
    inhabited(s_Ref_immutable_type(s_Str_type())) &&
    inhabited(s_Ref_immutable_type(s_Str_type()))))
  }
  
  axiom inhabited_Char {
    inhabited(s_Char_type()) == true
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
