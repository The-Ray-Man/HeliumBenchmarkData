domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_UInt_u32  {
  
  axiom s_Param_typ_def_make_generic_s_UInt_u32 {
    (forall x: s_UInt_u32 ::
      { make_generic_s_UInt_u32(x) }
      s_Param_typ(make_generic_s_UInt_u32(x)) == s_UInt_u32_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_UInt_u32 {
    (forall p: s_Param ::
      { p.make_concrete_s_UInt_u32, s_Param_typ(p) }
      s_Param_typ(p) == s_UInt_u32_type() ==>
      make_generic_s_UInt_u32(p.make_concrete_s_UInt_u32) == p)
  }
}

