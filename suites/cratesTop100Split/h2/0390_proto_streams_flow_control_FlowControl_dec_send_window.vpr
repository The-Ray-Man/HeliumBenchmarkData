domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$result$col$$col$Result {
    (forall T$0: Type, E$1: Type ::
      { inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) }
      inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) ==
      (inhabited(T$0) || inhabited(E$1)))
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_frame$col$$col$reason$col$$col$Reason {
    inhabited(s_frame$col$$col$reason$col$$col$Reason_type()) ==
    inhabited(s_UInt_u32_type())
  }
  
  axiom inhabited_UInt_u32 {
    inhabited(s_UInt_u32_type()) == true
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_proto$col$$col$streams$col$$col$flow_control$col$$col$FlowControl {
    inhabited(s_proto$col$$col$streams$col$$col$flow_control$col$$col$FlowControl_type()) ==
    (inhabited(s_proto$col$$col$streams$col$$col$flow_control$col$$col$Window_type()) &&
    inhabited(s_proto$col$$col$streams$col$$col$flow_control$col$$col$Window_type()))
  }
  
  axiom inhabited_proto$col$$col$streams$col$$col$flow_control$col$$col$Window {
    inhabited(s_proto$col$$col$streams$col$$col$flow_control$col$$col$Window_type()) ==
    inhabited(s_Int_i32_type())
  }
  
  axiom inhabited_Int_i32 {
    inhabited(s_Int_i32_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_std$col$$col$ops$col$$col$ControlFlow {
    (forall B$0: Type, C$1: Type ::
      { inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) }
      inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) ==
      (inhabited(C$1) || inhabited(B$0)))
  }
  
  axiom inhabited_std$col$$col$convert$col$$col$Infallible {
    inhabited(s_std$col$$col$convert$col$$col$Infallible_type()) == false
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
}

