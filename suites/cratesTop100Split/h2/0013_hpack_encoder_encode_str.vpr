domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_Slice  {
  
  axiom s_Param_typ_def_make_generic_s_Slice {
    (forall x: s_Slice, T$0: Type ::
      { make_generic_s_Slice(x, T$0) }
      s_Param_typ(make_generic_s_Slice(x, T$0)) == s_Slice_type(T$0))
  }
  
  axiom s_Param_typ_variant_make_generic_s_Slice {
    (forall p: s_Param ::
      { p.make_concrete_s_Slice, s_Param_typ(p) }
      s_Param_typ(p) == s_Slice_type(s_Param_typ(p).s_Slice_typaram_T$0) ==>
      make_generic_s_Slice(p.make_concrete_s_Slice, s_Param_typ(p).s_Slice_typaram_T$0) ==
      p)
  }
}

