domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_hpack$col$$col$table$col$$col$Table  {
  
  axiom s_Param_typ_def_make_generic_s_hpack$col$$col$table$col$$col$Table {
    (forall x: s_hpack$col$$col$table$col$$col$Table ::
      { make_generic_s_hpack$col$$col$table$col$$col$Table(x) }
      s_Param_typ(make_generic_s_hpack$col$$col$table$col$$col$Table(x)) ==
      s_hpack$col$$col$table$col$$col$Table_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_hpack$col$$col$table$col$$col$Table {
    (forall p: s_Param ::
      { p.make_concrete_s_hpack$col$$col$table$col$$col$Table, s_Param_typ(p) }
      s_Param_typ(p) == s_hpack$col$$col$table$col$$col$Table_type() ==>
      make_generic_s_hpack$col$$col$table$col$$col$Table(p.make_concrete_s_hpack$col$$col$table$col$$col$Table) ==
      p)
  }
}

