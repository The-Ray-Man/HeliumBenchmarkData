domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_header$col$$col$value$col$$col$HeaderValue  {
  
  axiom s_Param_typ_def_make_generic_s_header$col$$col$value$col$$col$HeaderValue {
    (forall x: s_header$col$$col$value$col$$col$HeaderValue ::
      { make_generic_s_header$col$$col$value$col$$col$HeaderValue(x) }
      s_Param_typ(make_generic_s_header$col$$col$value$col$$col$HeaderValue(x)) ==
      s_header$col$$col$value$col$$col$HeaderValue_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_header$col$$col$value$col$$col$HeaderValue {
    (forall p: s_Param ::
      { p.make_concrete_s_header$col$$col$value$col$$col$HeaderValue, s_Param_typ(p) }
      s_Param_typ(p) == s_header$col$$col$value$col$$col$HeaderValue_type() ==>
      make_generic_s_header$col$$col$value$col$$col$HeaderValue(p.make_concrete_s_header$col$$col$value$col$$col$HeaderValue) ==
      p)
  }
}

