domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_method$col$$col$Method {
    inhabited(s_method$col$$col$Method_type()) ==
    inhabited(s_method$col$$col$Inner_type())
  }
  
  axiom inhabited_method$col$$col$Inner {
    inhabited(s_method$col$$col$Inner_type()) ==
    (true || (true || true) || (true || (true || true)) ||
    (true || (true || true) ||
    (true ||
    (inhabited(s_method$col$$col$extension$col$$col$InlineExtension_type()) ||
    inhabited(s_method$col$$col$extension$col$$col$AllocatedExtension_type())))))
  }
  
  axiom inhabited_method$col$$col$extension$col$$col$InlineExtension {
    inhabited(s_method$col$$col$extension$col$$col$InlineExtension_type()) ==
    (inhabited(s_Array_type(s_UInt_u8_type(), s_UInt_usize_cons(15))) &&
    inhabited(s_UInt_u8_type()))
  }
  
  axiom inhabited_Array {
    (forall U$1: Type, M$0: s_UInt_usize ::
      { inhabited(s_Array_type(U$1, M$0)) }
      inhabited(s_Array_type(U$1, M$0)) ==
      (M$0 == s_UInt_usize_cons(0) || inhabited(U$1)))
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_method$col$$col$extension$col$$col$AllocatedExtension {
    inhabited(s_method$col$$col$extension$col$$col$AllocatedExtension_type()) ==
    inhabited(s_std$col$$col$boxed$col$$col$Box_type(s_Slice_type(s_UInt_u8_type()), s_std$col$$col$alloc$col$$col$Global_type()))
  }
  
  axiom inhabited_std$col$$col$boxed$col$$col$Box {
    (forall T$0: Type, A$1: Type ::
      { inhabited(s_std$col$$col$boxed$col$$col$Box_type(T$0, A$1)) }
      inhabited(s_std$col$$col$boxed$col$$col$Box_type(T$0, A$1)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) &&
      (inhabited(A$1) && inhabited(T$0))))
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$Unique {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) &&
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_std$col$$col$marker$col$$col$PhantomData {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) }
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) ==
      true)
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_std$col$$col$alloc$col$$col$Global {
    inhabited(s_std$col$$col$alloc$col$$col$Global_type()) == true
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
}

