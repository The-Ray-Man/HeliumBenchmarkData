  axiom s_Param_typ_def_make_generic_s_method$col$$col$Method {
    (forall x: s_method$col$$col$Method ::
      { make_generic_s_method$col$$col$Method(x) }
      s_Param_typ(make_generic_s_method$col$$col$Method(x)) ==
      s_method$col$$col$Method_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_method$col$$col$Method {
    (forall p: s_Param ::
      { p.make_concrete_s_method$col$$col$Method, s_Param_typ(p) }
      s_Param_typ(p) == s_method$col$$col$Method_type() ==>
      make_generic_s_method$col$$col$Method(p.make_concrete_s_method$col$$col$Method) ==
      p)
  }
}

