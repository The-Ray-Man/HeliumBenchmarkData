domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_uri$col$$col$Uri {
    inhabited(s_uri$col$$col$Uri_type()) ==
    (inhabited(s_uri$col$$col$scheme$col$$col$Scheme_type()) &&
    (inhabited(s_uri$col$$col$authority$col$$col$Authority_type()) &&
    inhabited(s_uri$col$$col$path$col$$col$PathAndQuery_type())))
