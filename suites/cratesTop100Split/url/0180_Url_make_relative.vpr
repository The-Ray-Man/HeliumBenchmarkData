domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_std$col$$col$string$col$$col$String  {
  
  axiom s_Param_typ_def_make_generic_s_std$col$$col$string$col$$col$String {
    (forall x: s_std$col$$col$string$col$$col$String ::
      { make_generic_s_std$col$$col$string$col$$col$String(x) }
      s_Param_typ(make_generic_s_std$col$$col$string$col$$col$String(x)) ==
      s_std$col$$col$string$col$$col$String_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_std$col$$col$string$col$$col$String {
    (forall p: s_Param ::
      { p.make_concrete_s_std$col$$col$string$col$$col$String, s_Param_typ(p) }
      s_Param_typ(p) == s_std$col$$col$string$col$$col$String_type() ==>
      make_generic_s_std$col$$col$string$col$$col$String(p.make_concrete_s_std$col$$col$string$col$$col$String) ==
      p)
  }
}

