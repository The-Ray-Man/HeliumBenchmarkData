method p_Bool_assign(self: Ref, value: Bool)
  ensures acc(p_Bool(self), write)
  ensures p_Bool_snap(self) == value


method p_Char_assign(self: Ref, value: s_Char)
  ensures acc(p_Char(self), write)
  ensures p_Char_snap(self) == value


adt s_Param {
  s_Param_Unknown(s_Param_Unknown_id: Int)
}

adt Type {
  s_Bool_type()
  s_Char_type()
  Unknown_type(id: Int)
}