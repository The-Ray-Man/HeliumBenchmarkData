domain s_Char  {
  
  function s_Char_cons(arg0: Int): s_Char 
  
  function s_Char_value(arg0: s_Char): Int 
  
  axiom s_Char_ax_cons {
    (forall s: s_Char ::
      { s_Char_value(s) }
      s_Char_cons(s_Char_value(s)) == s)
  }
  
  axiom s_Char_ax_value {
    (forall value: Int ::
      { s_Char_cons(value) }
      s_Char_value(s_Char_cons(value)) == value)
  }
}

domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Char {
    inhabited(s_Char_type()) == true
  }
}

domain trait_core$col$$col$marker$col$$col$Sized  {
  
  function core$col$$col$marker$col$$col$Sized_impl(arg0: Type): Bool 
}

domain trait_core$col$$col$marker$col$$col$MetaSized  {
  
  function core$col$$col$marker$col$$col$MetaSized_impl(arg0: Type): Bool 
}

domain sizedness_Bool  {
  
  axiom s_Bool_Sized {
    core$col$$col$marker$col$$col$Sized_impl(s_Bool_type())
  }
  
  axiom s_Bool_MetaSized {
    core$col$$col$marker$col$$col$MetaSized_impl(s_Bool_type())
  }
}

domain sizedness_Char  {
  
  axiom s_Char_Sized {
    core$col$$col$marker$col$$col$Sized_impl(s_Char_type())
  }
  
  axiom s_Char_MetaSized {
    core$col$$col$marker$col$$col$MetaSized_impl(s_Char_type())
  }
}

field p_Bool_val: Bool

field p_Char_val: s_Char

function s_Bool_unreachable(): Bool
  ensures false


function s_Char_unreachable(): s_Char
  ensures false


function p_Bool_snap(self: Ref): Bool
  requires acc(p_Bool(self), write)
{
  (unfolding acc(p_Bool(self), write) in self.p_Bool_val)
}

function p_Char_snap(self: Ref): s_Char
  requires acc(p_Char(self), write)
{
  (unfolding acc(p_Char(self), write) in self.p_Char_val)
}

predicate p_Bool(self: Ref) {
  acc(self.p_Bool_val, write)
}

predicate p_Char(self: Ref) {
  acc(self.p_Char_val, write)
}

