domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Url {
    inhabited(s_Url_type()) ==
    (inhabited(s_std$col$$col$string$col$$col$String_type()) &&
    inhabited(s_UInt_u32_type()) &&
    (inhabited(s_UInt_u32_type()) &&
    (inhabited(s_UInt_u32_type()) && inhabited(s_UInt_u32_type()))) &&
    (inhabited(s_host$col$$col$HostInternal_type()) &&
    inhabited(s_core$col$$col$option$col$$col$Option_type(s_UInt_u16_type())) &&
    (inhabited(s_UInt_u32_type()) &&
    (inhabited(s_core$col$$col$option$col$$col$Option_type(s_UInt_u32_type())) &&
    inhabited(s_core$col$$col$option$col$$col$Option_type(s_UInt_u32_type()))))))
