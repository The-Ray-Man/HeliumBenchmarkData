domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_MZStatus  {
  
  axiom s_Param_typ_def_make_generic_s_MZStatus {
    (forall x: s_MZStatus ::
      { make_generic_s_MZStatus(x) }
      s_Param_typ(make_generic_s_MZStatus(x)) == s_MZStatus_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_MZStatus {
    (forall p: s_Param ::
      { p.make_concrete_s_MZStatus, s_Param_typ(p) }
      s_Param_typ(p) == s_MZStatus_type() ==>
      make_generic_s_MZStatus(p.make_concrete_s_MZStatus) == p)
  }
}

