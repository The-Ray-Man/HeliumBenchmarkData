domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_Slab  {
  
  axiom s_Param_typ_def_make_generic_s_Slab {
    (forall x: s_Slab, T$0: Type ::
      { make_generic_s_Slab(x, T$0) }
      s_Param_typ(make_generic_s_Slab(x, T$0)) == s_Slab_type(T$0))
  }
  
  axiom s_Param_typ_variant_make_generic_s_Slab {
    (forall p: s_Param ::
      { p.make_concrete_s_Slab, s_Param_typ(p) }
      s_Param_typ(p) == s_Slab_type(s_Param_typ(p).s_Slab_typaram_T$0) ==>
      make_generic_s_Slab(p.make_concrete_s_Slab, s_Param_typ(p).s_Slab_typaram_T$0) ==
      p)
  }
}

domain ParamTyp_make_generic_s_0_Tuple  {
  
