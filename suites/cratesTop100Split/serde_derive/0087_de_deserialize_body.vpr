method p_Slice_fold_index(index: Int, self: Ref, T$0: Type)
  requires inhabited(T$0) &&
    acc(p_Param(s_Slice_index_ref(self, index, T$0), T$0), write)
  requires acc(p_Slice_index(self, index, T$0), write)
  ensures acc(p_Slice(self, T$0), write)
  ensures (forall idx: Int ::
      { s_Slice_index(p_Slice_snap(self, T$0), idx) }
      s_Slice_index(p_Slice_snap(self, T$0), idx) ==
      (idx == index ?
        old(p_Param_snap(s_Slice_index_ref(self, index, T$0), T$0)) :
        old(s_Slice_index(p_Slice_index_frame(self, index, T$0), idx))))


method p_Slice_unfold_index(index: Int, self: Ref, T$0: Type)
  requires acc(p_Slice(self, T$0), write)
  ensures inhabited(T$0) &&
    acc(p_Param(s_Slice_index_ref(self, index, T$0), T$0), write)
  ensures acc(p_Slice_index(self, index, T$0), write)
  ensures p_Param_snap(s_Slice_index_ref(self, index, T$0), T$0) ==
    old(s_Slice_index(p_Slice_snap(self, T$0), index))
  ensures p_Slice_index_frame(self, index, T$0) ==
    old(p_Slice_snap(self, T$0))


