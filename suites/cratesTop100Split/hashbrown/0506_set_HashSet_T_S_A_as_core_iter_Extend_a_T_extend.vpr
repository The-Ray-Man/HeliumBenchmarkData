domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_set$col$$col$HashSet  {
  
  axiom s_Param_typ_def_make_generic_s_set$col$$col$HashSet {
    (forall x: s_set$col$$col$HashSet, T$0: Type, S$1: Type, A$2: Type ::
      { make_generic_s_set$col$$col$HashSet(x, T$0, S$1, A$2) }
      s_Param_typ(make_generic_s_set$col$$col$HashSet(x, T$0, S$1, A$2)) ==
      s_set$col$$col$HashSet_type(T$0, S$1, A$2))
  }
  
  axiom s_Param_typ_variant_make_generic_s_set$col$$col$HashSet {
    (forall p: s_Param ::
      { p.make_concrete_s_set$col$$col$HashSet, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_set$col$$col$HashSet_type(s_Param_typ(p).s_set$col$$col$HashSet_typaram_T$0, s_Param_typ(p).s_set$col$$col$HashSet_typaram_S$1, s_Param_typ(p).s_set$col$$col$HashSet_typaram_A$2) ==>
      make_generic_s_set$col$$col$HashSet(p.make_concrete_s_set$col$$col$HashSet, s_Param_typ(p).s_set$col$$col$HashSet_typaram_T$0, s_Param_typ(p).s_set$col$$col$HashSet_typaram_S$1, s_Param_typ(p).s_set$col$$col$HashSet_typaram_A$2) ==
      p)
  }
}

domain ParamTyp_make_generic_s_0_Tuple  {
  
  axiom s_Param_typ_def_make_generic_s_0_Tuple {
    (forall x: s_0_Tuple ::
      { make_generic_s_0_Tuple(x) }
      s_Param_typ(make_generic_s_0_Tuple(x)) == s_0_Tuple_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_0_Tuple {
    (forall p: s_Param ::
      { s_Param_has_typ(p, s_0_Tuple_type()) }
      s_Param_typ(p) == s_0_Tuple_type() ==>
      make_generic_s_0_Tuple(s_0_Tuple_cons()) == p)
  }
  
  axiom make_generic_s_0_Tuple_unit {
    (forall p: s_Param ::
      { p.make_concrete_s_0_Tuple }
      p.make_concrete_s_0_Tuple == s_0_Tuple_cons())
  }
}

