domain s_UInt_u16  {
  
  function s_UInt_u16_cons(arg0: Int): s_UInt_u16 
  
  function s_UInt_u16_value(arg0: s_UInt_u16): Int 
  
  axiom s_UInt_u16_ax_cons {
    (forall s: s_UInt_u16 ::
      { s_UInt_u16_value(s) }
      s_UInt_u16_cons(s_UInt_u16_value(s)) == s)
  }
  
  axiom s_UInt_u16_ax_bounds {
    (forall s: s_UInt_u16 ::
      { s_UInt_u16_value(s) }
      0 <= s_UInt_u16_value(s) && s_UInt_u16_value(s) <= 65535)
  }
  
  axiom s_UInt_u16_ax_value {
    (forall value: Int ::
      { s_UInt_u16_cons(value) }
      0 <= value && value <= 65535 ==>
      s_UInt_u16_value(s_UInt_u16_cons(value)) == value)
  }
}

