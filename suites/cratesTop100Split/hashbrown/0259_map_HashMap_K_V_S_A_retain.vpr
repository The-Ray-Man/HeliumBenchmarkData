domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_map$col$$col$HashMap  {
  
  axiom s_Param_typ_def_make_generic_s_map$col$$col$HashMap {
    (forall x: s_map$col$$col$HashMap, K$0: Type, V$1: Type, S$2: Type, A$3: Type ::
      { make_generic_s_map$col$$col$HashMap(x, K$0, V$1, S$2, A$3) }
      s_Param_typ(make_generic_s_map$col$$col$HashMap(x, K$0, V$1, S$2, A$3)) ==
      s_map$col$$col$HashMap_type(K$0, V$1, S$2, A$3))
  }
  
  axiom s_Param_typ_variant_make_generic_s_map$col$$col$HashMap {
    (forall p: s_Param ::
      { p.make_concrete_s_map$col$$col$HashMap, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_map$col$$col$HashMap_type(s_Param_typ(p).s_map$col$$col$HashMap_typaram_K$0, s_Param_typ(p).s_map$col$$col$HashMap_typaram_V$1, s_Param_typ(p).s_map$col$$col$HashMap_typaram_S$2, s_Param_typ(p).s_map$col$$col$HashMap_typaram_A$3) ==>
