      { s_Int_isize_value(s) }
      -9223372036854775808 <= s_Int_isize_value(s) &&
      s_Int_isize_value(s) <= 9223372036854775807)
  }
  
  axiom s_Int_isize_ax_value {
    (forall value: Int ::
      { s_Int_isize_cons(value) }
      -9223372036854775808 <= value && value <= 9223372036854775807 ==>
      s_Int_isize_value(s_Int_isize_cons(value)) == value)
  }
}

domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_raw$col$$col$RawIter {
    (forall T$0: Type ::
      { inhabited(s_raw$col$$col$RawIter_type(T$0)) }
      inhabited(s_raw$col$$col$RawIter_type(T$0)) ==
      (inhabited(s_raw$col$$col$RawIterRange_type(T$0)) &&
      inhabited(s_UInt_usize_type())))
  }
  
  axiom inhabited_raw$col$$col$RawIterRange {
    (forall T$0: Type ::
      { inhabited(s_raw$col$$col$RawIterRange_type(T$0)) }
      inhabited(s_raw$col$$col$RawIterRange_type(T$0)) ==
      (inhabited(s_control$col$$col$bitmask$col$$col$BitMaskIter_type()) &&
      inhabited(s_raw$col$$col$Bucket_type(T$0)) &&
      (inhabited(s_RawPtr_immutable_type(s_UInt_u8_type())) &&
      inhabited(s_RawPtr_immutable_type(s_UInt_u8_type())))))
  }
  
  axiom inhabited_control$col$$col$bitmask$col$$col$BitMaskIter {
    inhabited(s_control$col$$col$bitmask$col$$col$BitMaskIter_type()) ==
    inhabited(s_control$col$$col$bitmask$col$$col$BitMask_type())
  }
  
  axiom inhabited_control$col$$col$bitmask$col$$col$BitMask {
    inhabited(s_control$col$$col$bitmask$col$$col$BitMask_type()) ==
    inhabited(s_UInt_u16_type())
  }
  
  axiom inhabited_UInt_u16 {
    inhabited(s_UInt_u16_type()) == true
  }
  
  axiom inhabited_raw$col$$col$Bucket {
    (forall T$0: Type ::
      { inhabited(s_raw$col$$col$Bucket_type(T$0)) }
      inhabited(s_raw$col$$col$Bucket_type(T$0)) ==
      inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)))
  }
  
  axiom inhabited_core$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Item {
    (forall A$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$Item_type(A$0)) }
      inhabited(s_core$col$$col$option$col$$col$Item_type(A$0)) ==
      inhabited(s_core$col$$col$option$col$$col$Option_type(A$0)))
  }
  
  axiom inhabited_core$col$$col$option$col$$col$IntoIter {
    (forall A$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$IntoIter_type(A$0)) }
      inhabited(s_core$col$$col$option$col$$col$IntoIter_type(A$0)) ==
      inhabited(s_core$col$$col$option$col$$col$Item_type(A$0)))
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Iter {
    (forall A$1: Type ::
      { inhabited(s_core$col$$col$option$col$$col$Iter_type(A$1)) }
      inhabited(s_core$col$$col$option$col$$col$Iter_type(A$1)) ==
      inhabited(s_core$col$$col$option$col$$col$Item_type(s_Ref_immutable_type(A$1))))
  }
  
  axiom inhabited_core$col$$col$option$col$$col$IterMut {
    (forall A$1: Type ::
      { inhabited(s_core$col$$col$option$col$$col$IterMut_type(A$1)) }
      inhabited(s_core$col$$col$option$col$$col$IterMut_type(A$1)) ==
