}

domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_std$col$$col$marker$col$$col$PhantomData {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) }
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) ==
      true)
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$Unique {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) &&
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit {
    inhabited(s_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit_type()) ==
    inhabited(s_UInt_usize_type())
  }
  
  axiom inhabited_alloc$col$$col$raw_vec$col$$col$RawVecInner {
    (forall A$0: Type ::
      { inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVecInner_type(A$0)) }
      inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVecInner_type(A$0)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$Unique_type(s_UInt_u8_type())) &&
      (inhabited(s_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit_type()) &&
      inhabited(A$0))))
  }
  
  axiom inhabited_alloc$col$$col$raw_vec$col$$col$RawVec {
    (forall T$0: Type, A$1: Type ::
      { inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVec_type(T$0, A$1)) }
      inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVec_type(T$0, A$1)) ==
      (inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVecInner_type(A$1)) &&
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_std$col$$col$vec$col$$col$Vec {
    (forall T$0: Type, A$1: Type ::
      { inhabited(s_std$col$$col$vec$col$$col$Vec_type(T$0, A$1)) }
      inhabited(s_std$col$$col$vec$col$$col$Vec_type(T$0, A$1)) ==
      (inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVec_type(T$0, A$1)) &&
      inhabited(s_UInt_usize_type())))
  }
  
  axiom inhabited_std$col$$col$alloc$col$$col$Global {
    inhabited(s_std$col$$col$alloc$col$$col$Global_type()) == true
  }
  
  axiom inhabited_std$col$$col$string$col$$col$String {
    inhabited(s_std$col$$col$string$col$$col$String_type()) ==
    inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_UInt_u8_type(), s_std$col$$col$alloc$col$$col$Global_type()))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
}

