domain s_UInt_usize  {
  
  function s_UInt_usize_cons(arg0: Int): s_UInt_usize 
  
  function s_UInt_usize_value(arg0: s_UInt_usize): Int 
  
  axiom s_UInt_usize_ax_cons {
    (forall s: s_UInt_usize ::
      { s_UInt_usize_value(s) }
      s_UInt_usize_cons(s_UInt_usize_value(s)) == s)
  }
  
  axiom s_UInt_usize_ax_bounds {
    (forall s: s_UInt_usize ::
      { s_UInt_usize_value(s) }
      0 <= s_UInt_usize_value(s) &&
      s_UInt_usize_value(s) <= 18446744073709551615)
  }
  
  axiom s_UInt_usize_ax_value {
    (forall value: Int ::
      { s_UInt_usize_cons(value) }
      0 <= value && value <= 18446744073709551615 ==>
      s_UInt_usize_value(s_UInt_usize_cons(value)) == value)
  }
}

domain s_UInt_u8  {
  
  function s_UInt_u8_cons(arg0: Int): s_UInt_u8 
  
  function s_UInt_u8_value(arg0: s_UInt_u8): Int 
  
  axiom s_UInt_u8_ax_cons {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      s_UInt_u8_cons(s_UInt_u8_value(s)) == s)
  }
  
  axiom s_UInt_u8_ax_bounds {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      0 <= s_UInt_u8_value(s) && s_UInt_u8_value(s) <= 255)
  }
  
  axiom s_UInt_u8_ax_value {
    (forall value: Int ::
      { s_UInt_u8_cons(value) }
      0 <= value && value <= 255 ==>
      s_UInt_u8_value(s_UInt_u8_cons(value)) == value)
  }
}

domain s_Int_isize  {
  
  function s_Int_isize_cons(arg0: Int): s_Int_isize 
  
  function s_Int_isize_value(arg0: s_Int_isize): Int 
  
  axiom s_Int_isize_ax_cons {
    (forall s: s_Int_isize ::
      { s_Int_isize_value(s) }
      s_Int_isize_cons(s_Int_isize_value(s)) == s)
  }
  
  axiom s_Int_isize_ax_bounds {
    (forall s: s_Int_isize ::
      { s_Int_isize_value(s) }
      -9223372036854775808 <= s_Int_isize_value(s) &&
      s_Int_isize_value(s) <= 9223372036854775807)
  }
  
  axiom s_Int_isize_ax_value {
    (forall value: Int ::
      { s_Int_isize_cons(value) }
      -9223372036854775808 <= value && value <= 9223372036854775807 ==>
      s_Int_isize_value(s_Int_isize_cons(value)) == value)
  }
}

domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Array {
    (forall U$1: Type, M$0: s_UInt_usize ::
      { inhabited(s_Array_type(U$1, M$0)) }
      inhabited(s_Array_type(U$1, M$0)) ==
      (M$0 == s_UInt_usize_cons(0) || inhabited(U$1)))
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_alphabet$col$$col$Symbol {
    inhabited(s_alphabet$col$$col$Symbol_type()) ==
    inhabited(s_UInt_u8_type())
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_engine$col$$col$DecodePaddingMode {
    inhabited(s_engine$col$$col$DecodePaddingMode_type()) ==
    (true || (true || true))
  }
  
  axiom inhabited_engine$col$$col$general_purpose$col$$col$GeneralPurposeConfig {
    inhabited(s_engine$col$$col$general_purpose$col$$col$GeneralPurposeConfig_type()) ==
    (inhabited(s_Bool_type()) &&
    (inhabited(s_Bool_type()) &&
    inhabited(s_engine$col$$col$DecodePaddingMode_type())))
  }
  
  axiom inhabited_engine$col$$col$general_purpose$col$$col$GeneralPurpose {
    inhabited(s_engine$col$$col$general_purpose$col$$col$GeneralPurpose_type()) ==
    (inhabited(s_Array_type(s_UInt_u8_type(), s_UInt_usize_cons(64))) &&
    inhabited(s_Array_type(s_UInt_u8_type(), s_UInt_usize_cons(256))) &&
    (inhabited(s_alphabet$col$$col$Symbol_type()) &&
    inhabited(s_engine$col$$col$general_purpose$col$$col$GeneralPurposeConfig_type())))
  }
  
  axiom inhabited_engine$col$$col$simd$col$$col$SimdKind {
    inhabited(s_engine$col$$col$simd$col$$col$SimdKind_type()) ==
    (true || true)
  }
  
  axiom inhabited_engine$col$$col$simd$col$$col$Backend {
    inhabited(s_engine$col$$col$simd$col$$col$Backend_type()) ==
    (true || true)
  }
  
  axiom inhabited_engine$col$$col$simd$col$$col$Simd {
    inhabited(s_engine$col$$col$simd$col$$col$Simd_type()) ==
    (inhabited(s_engine$col$$col$general_purpose$col$$col$GeneralPurpose_type()) &&
    (inhabited(s_engine$col$$col$simd$col$$col$SimdKind_type()) &&
    inhabited(s_engine$col$$col$simd$col$$col$Backend_type())))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
}

