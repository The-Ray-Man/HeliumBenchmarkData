domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_ShortFlags {
    inhabited(s_ShortFlags_type()) ==
    (inhabited(s_Ref_immutable_type(s_std$col$$col$ffi$col$$col$OsStr_type())) &&
    (inhabited(s_std$col$$col$str$col$$col$CharIndices_type()) &&
    inhabited(s_std$col$$col$option$col$$col$Option_type(s_Ref_immutable_type(s_std$col$$col$ffi$col$$col$OsStr_type())))))
  }
  
  axiom inhabited_std$col$$col$ffi$col$$col$OsStr {
    inhabited(s_std$col$$col$ffi$col$$col$OsStr_type()) ==
    inhabited(s_std$col$$col$sys$col$$col$os_str$col$$col$wtf8$col$$col$Slice_type())
  }
  
  axiom inhabited_std$col$$col$sys$col$$col$os_str$col$$col$wtf8$col$$col$Slice {
    inhabited(s_std$col$$col$sys$col$$col$os_str$col$$col$wtf8$col$$col$Slice_type()) ==
    inhabited(s_core$col$$col$wtf8$col$$col$Wtf8_type())
  }
  
  axiom inhabited_core$col$$col$wtf8$col$$col$Wtf8 {
    inhabited(s_core$col$$col$wtf8$col$$col$Wtf8_type()) ==
    inhabited(s_Slice_type(s_UInt_u8_type()))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_std$col$$col$str$col$$col$CharIndices {
    inhabited(s_std$col$$col$str$col$$col$CharIndices_type()) ==
    (inhabited(s_UInt_usize_type()) &&
    inhabited(s_std$col$$col$str$col$$col$Chars_type()))
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_std$col$$col$str$col$$col$Chars {
    inhabited(s_std$col$$col$str$col$$col$Chars_type()) ==
    inhabited(s_std$col$$col$slice$col$$col$Iter_type(s_UInt_u8_type()))
  }
  
  axiom inhabited_std$col$$col$slice$col$$col$Iter {
    (forall T$1: Type ::
      { inhabited(s_std$col$$col$slice$col$$col$Iter_type(T$1)) }
      inhabited(s_std$col$$col$slice$col$$col$Iter_type(T$1)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$1)) &&
      (inhabited(s_RawPtr_immutable_type(T$1)) &&
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(s_Ref_immutable_type(T$1))))))
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_std$col$$col$marker$col$$col$PhantomData {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) }
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) ==
      true)
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
}

