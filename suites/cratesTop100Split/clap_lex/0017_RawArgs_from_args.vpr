      s_Param_typ(p) == s_std$col$$col$env$col$$col$ArgsOs_type() ==>
      make_generic_s_std$col$$col$env$col$$col$ArgsOs(p.make_concrete_s_std$col$$col$env$col$$col$ArgsOs) ==
