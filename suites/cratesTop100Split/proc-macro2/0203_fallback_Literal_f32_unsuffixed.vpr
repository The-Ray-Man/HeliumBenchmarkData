  function s_Float_f32_mul(arg0: s_Float_f32, arg1: s_Float_f32): s_Float_f32 interpretation "fp.mul RNE"
  
  function s_Float_f32_div(arg0: s_Float_f32, arg1: s_Float_f32): s_Float_f32 interpretation "fp.div RNE"
  
  function s_Float_f32_trunc(arg0: s_Float_f32): s_Float_f32 interpretation "fp.roundToIntegral RTZ"
  
  function s_Float_f32_is_nan(arg0: s_Float_f32): Bool interpretation "fp.isNaN"
  
  function s_Float_f32_is_infinite(arg0: s_Float_f32): Bool interpretation "fp.isInfinite"
  
  function s_Float_f32_lt(arg0: s_Float_f32, arg1: s_Float_f32): Bool interpretation "fp.lt"
  
  function s_Float_f32_leq(arg0: s_Float_f32, arg1: s_Float_f32): Bool interpretation "fp.leq"
  
  function s_Float_f32_geq(arg0: s_Float_f32, arg1: s_Float_f32): Bool interpretation "fp.geq"
  
  function s_Float_f32_gt(arg0: s_Float_f32, arg1: s_Float_f32): Bool interpretation "fp.gt"
  
  function s_Float_f32_neg(arg0: s_Float_f32): s_Float_f32 interpretation "fp.neg"
  
  function s_Float_f32_abs(arg0: s_Float_f32): s_Float_f32 interpretation "fp.abs"
  
  function s_Float_f32_from_bv(arg0: s_BitVec_32): s_Float_f32 interpretation "(_ to_fp 8 24)"
  
  function s_Float_f32_to_real(arg0: s_Float_f32): Perm interpretation "fp.to_real"
  
  axiom s_Float_f32_ax_prim_to_snap {
    (forall i: Int ::
      { s_Float_f32_cons(i) }
      s_Float_f32_cons(i) == s_Float_f32_from_bv(s_BitVec_32_from_int(i)) &&
