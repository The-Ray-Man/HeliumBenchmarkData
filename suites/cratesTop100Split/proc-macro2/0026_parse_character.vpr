domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_core$col$$col$result$col$$col$Result {
    (forall T$0: Type, E$1: Type ::
      { inhabited(s_core$col$$col$result$col$$col$Result_type(T$0, E$1)) }
      inhabited(s_core$col$$col$result$col$$col$Result_type(T$0, E$1)) ==
      (inhabited(T$0) || inhabited(E$1)))
  }
  
  axiom inhabited_parse$col$$col$Cursor {
    inhabited(s_parse$col$$col$Cursor_type()) ==
    inhabited(s_Ref_immutable_type(s_Str_type()))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_parse$col$$col$Reject {
    inhabited(s_parse$col$$col$Reject_type()) == true
  }
  
  axiom inhabited_core$col$$col$ops$col$$col$ControlFlow {
