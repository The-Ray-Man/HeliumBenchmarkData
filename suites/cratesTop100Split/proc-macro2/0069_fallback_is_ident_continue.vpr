  requires inhabited(s_Char_type()) && acc(p_Char(_1p), write)
  ensures inhabited(s_Bool_type()) && acc(p_Bool(_0p), write)
{
  var _2p: Ref
  var _from_bb0_to_bb1: Bool
  var _tmp0: s_Char
  label start
  _from_bb0_to_bb1 := false
  goto bb_0
  label bb_0
  label _before_0_0
  label _before_0_1
  _tmp0 := p_Char_snap(_1p)
  p_Char_assign(_2p, _tmp0)
  label _before_0_2
  goto bb_term_0
  label bb_term_0
  label pre0
  m_unicode_ident$col$$col$is_xid_continue(_0p, _2p)
  label post1
  label _after_0
  _from_bb0_to_bb1 := true
  goto bb_1
  label bb_1
  label _before_1_0
  label _before_1_1
  label package_post2
