function p_Bool_snap(self: Ref): Bool
  requires acc(p_Bool(self), write)
{
  (unfolding acc(p_Bool(self), write) in self.p_Bool_val)
}

function p_Char_snap(self: Ref): s_Char
  requires acc(p_Char(self), write)
{
  (unfolding acc(p_Char(self), write) in self.p_Char_val)
}

predicate p_Bool(self: Ref) {
  acc(self.p_Bool_val, write)
}

predicate p_Char(self: Ref) {
  acc(self.p_Char_val, write)
}

