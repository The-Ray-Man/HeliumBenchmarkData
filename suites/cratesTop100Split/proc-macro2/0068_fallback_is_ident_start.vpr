field p_Char_val: s_Char

function mir_binop_Eq_Char_Char(arg1: s_Char, arg2: s_Char): Bool
{
  s_Char_value(arg1) == s_Char_value(arg2)
}

function s_Bool_unreachable(): Bool
  ensures false


function s_Char_unreachable(): s_Char
