domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$task$col$$col$Poll {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$task$col$$col$Poll_type(T$0)) }
      inhabited(s_std$col$$col$task$col$$col$Poll_type(T$0)) ==
      (inhabited(T$0) || true))
