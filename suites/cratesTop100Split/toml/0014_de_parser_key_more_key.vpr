  axiom inhabited_toml_parser$col$$col$parser$col$$col$EventKind {
    inhabited(s_toml_parser$col$$col$parser$col$$col$EventKind_type()) ==
    (true || true || (true || true) || (true || true || (true || true)) ||
    (true || true || (true || true) ||
    (true || true || (true || (true || true)))))
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_toml_parser$col$$col$decoder$col$$col$Encoding {
