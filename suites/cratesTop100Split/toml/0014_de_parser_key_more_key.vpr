  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_de$col$$col$parser$col$$col$key$col$$col$more_key$col$$col$$lc$closure$oc$0$rc$ {
    inhabited(s_de$col$$col$parser$col$$col$key$col$$col$more_key$col$$col$$lc$closure$oc$0$rc$_type()) ==
