domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
}

domain trait_std$col$$col$marker$col$$col$Sized  {
  
  function std$col$$col$marker$col$$col$Sized_impl(arg0: Type): Bool 
}

domain trait_std$col$$col$marker$col$$col$MetaSized  {
  
  function std$col$$col$marker$col$$col$MetaSized_impl(arg0: Type): Bool 
}

domain sizedness_0_Tuple  {
  
  axiom s_0_Tuple_Sized {
    std$col$$col$marker$col$$col$Sized_impl(s_0_Tuple_type())
  }
  
  axiom s_0_Tuple_MetaSized {
    std$col$$col$marker$col$$col$MetaSized_impl(s_0_Tuple_type())
  }
}

domain sizedness_Bool  {
  
  axiom s_Bool_Sized {
    std$col$$col$marker$col$$col$Sized_impl(s_Bool_type())
  }
  
  axiom s_Bool_MetaSized {
    std$col$$col$marker$col$$col$MetaSized_impl(s_Bool_type())
  }
}

field p_Bool_val: Bool

function s_0_Tuple_unreachable(): s_0_Tuple
  ensures false


function s_Bool_unreachable(): Bool
  ensures false


function p_0_Tuple_snap(self: Ref): s_0_Tuple
  requires acc(p_0_Tuple(self), write)
{
  (unfolding acc(p_0_Tuple(self), write) in s_0_Tuple_cons())
}

function p_Bool_snap(self: Ref): Bool
  requires acc(p_Bool(self), write)
{
  (unfolding acc(p_Bool(self), write) in self.p_Bool_val)
}

predicate p_0_Tuple(self: Ref) {
  true
}

predicate p_Bool(self: Ref) {
  acc(self.p_Bool_val, write)
}

method m_runtime$col$$col$driver$col$$col$create_clock(_0p: Ref, _1p: Ref, _2p: Ref)
  requires inhabited(s_Bool_type()) && acc(p_Bool(_1p), write)
  requires inhabited(s_Bool_type()) && acc(p_Bool(_2p), write)
  ensures inhabited(s_0_Tuple_type()) && acc(p_0_Tuple(_0p), write)
{
  label start
  goto bb_0
  label bb_0
  label _before_0_0
  p_0_Tuple_assign(_0p, s_0_Tuple_cons())
  label _before_0_1
  label package_post0
  goto end
  label end
}

method p_0_Tuple_assign(self: Ref, value: s_0_Tuple)
  ensures acc(p_0_Tuple(self), write)
  ensures p_0_Tuple_snap(self) == value


method p_Bool_assign(self: Ref, value: Bool)
  ensures acc(p_Bool(self), write)
  ensures p_Bool_snap(self) == value


adt s_Param {
  s_Param_Unknown(s_Param_Unknown_id: Int)
}

adt s_0_Tuple {
  s_0_Tuple_cons()
}

adt Type {
  s_0_Tuple_type()
  s_Bool_type()
  Unknown_type(id: Int)
}