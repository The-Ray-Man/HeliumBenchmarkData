  axiom s_Param_typ_def_make_generic_s_read$col$$col$SliceRead {
    (forall x: s_read$col$$col$SliceRead ::
      { make_generic_s_read$col$$col$SliceRead(x) }
      s_Param_typ(make_generic_s_read$col$$col$SliceRead(x)) ==
      s_read$col$$col$SliceRead_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_read$col$$col$SliceRead {
    (forall p: s_Param ::
