domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_error$col$$col$Error  {
  
  axiom s_Param_typ_def_make_generic_s_error$col$$col$Error {
    (forall x: s_error$col$$col$Error ::
      { make_generic_s_error$col$$col$Error(x) }
      s_Param_typ(make_generic_s_error$col$$col$Error(x)) ==
      s_error$col$$col$Error_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_error$col$$col$Error {
    (forall p: s_Param ::
      { p.make_concrete_s_error$col$$col$Error, s_Param_typ(p) }
      s_Param_typ(p) == s_error$col$$col$Error_type() ==>
      make_generic_s_error$col$$col$Error(p.make_concrete_s_error$col$$col$Error) ==
