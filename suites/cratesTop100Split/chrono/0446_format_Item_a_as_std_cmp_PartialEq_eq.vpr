  }
  
  axiom inhabited_format$col$$col$Item {
    inhabited(s_format$col$$col$Item_type()) ==
    (inhabited(s_Ref_immutable_type(s_Str_type())) ||
    (inhabited(s_std$col$$col$boxed$col$$col$Box_type(s_Str_type(), s_std$col$$col$alloc$col$$col$Global_type())) ||
    inhabited(s_Ref_immutable_type(s_Str_type()))) ||
    (inhabited(s_std$col$$col$boxed$col$$col$Box_type(s_Str_type(), s_std$col$$col$alloc$col$$col$Global_type())) ||
    inhabited(s_format$col$$col$Numeric_type()) &&
    inhabited(s_format$col$$col$Pad_type()) ||
    (inhabited(s_format$col$$col$Fixed_type()) || true)))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
