  axiom inhabited_std$col$$col$boxed$col$$col$Box {
    (forall T$0: Type, A$1: Type ::
      { inhabited(s_std$col$$col$boxed$col$$col$Box_type(T$0, A$1)) }
      inhabited(s_std$col$$col$boxed$col$$col$Box_type(T$0, A$1)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) &&
      (inhabited(A$1) && inhabited(T$0))))
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$Unique {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) &&
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
