  axiom inhabited_format$col$$col$parsed$col$$col$Parsed$col$$col$to_naive_date$col$$col$resolve_year$col$$col$$lc$closure$oc$0$rc$ {
    inhabited(s_format$col$$col$parsed$col$$col$Parsed$col$$col$to_naive_date$col$$col$resolve_year$col$$col$$lc$closure$oc$0$rc$_type()) ==
    inhabited(s_Ref_immutable_type(s_Int_i32_type()))
  }
  
  axiom inhabited_std$col$$col$ops$col$$col$ControlFlow {
    (forall B$0: Type, C$1: Type ::
      { inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) }
      inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) ==
      (inhabited(C$1) || inhabited(B$0)))
  }
  
  axiom inhabited_std$col$$col$convert$col$$col$Infallible {
    inhabited(s_std$col$$col$convert$col$$col$Infallible_type()) == false
  }
  
