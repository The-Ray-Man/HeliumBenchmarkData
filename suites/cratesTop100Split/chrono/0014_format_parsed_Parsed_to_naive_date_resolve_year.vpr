  axiom inhabited_Int_i32 {
    inhabited(s_Int_i32_type()) == true
  }
  
  axiom inhabited_format$col$$col$ParseError {
    inhabited(s_format$col$$col$ParseError_type()) ==
    inhabited(s_format$col$$col$ParseErrorKind_type())
