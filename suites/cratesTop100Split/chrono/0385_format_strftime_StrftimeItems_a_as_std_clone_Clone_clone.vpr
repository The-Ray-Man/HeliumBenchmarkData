      -9223372036854775808 <= s_Int_isize_value(s) &&
      s_Int_isize_value(s) <= 9223372036854775807)
  }
  
  axiom s_Int_isize_ax_value {
    (forall value: Int ::
      { s_Int_isize_cons(value) }
      -9223372036854775808 <= value && value <= 9223372036854775807 ==>
      s_Int_isize_value(s_Int_isize_cons(value)) == value)
  }
}

domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_Slice {
