      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_month$col$$col$Month {
    inhabited(s_month$col$$col$Month_type()) ==
    (true || (true || true) || (true || (true || true)) ||
    (true || (true || true) || (true || (true || true))))
  }
  
  axiom inhabited_Int_i32 {
    inhabited(s_Int_i32_type()) == true
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_naive$col$$col$date$col$$col$NaiveDate {
    inhabited(s_naive$col$$col$date$col$$col$NaiveDate_type()) ==
    inhabited(s_std$col$$col$num$col$$col$NonZero_type(s_Int_i32_type()))
  }
  
  axiom inhabited_std$col$$col$num$col$$col$NonZero {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$num$col$$col$NonZero_type(T$0)) }
      inhabited(s_std$col$$col$num$col$$col$NonZero_type(T$0)) ==
      inhabited(std$col$$col$num$col$$col$ZeroablePrimitive_assoc_type_std$col$$col$num$col$$col$ZeroablePrimitive$col$$col$NonZeroInner(T$0)))
  }
  
  axiom inhabited_std$col$$col$ops$col$$col$ControlFlow {
    (forall B$0: Type, C$1: Type ::
      { inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) }
      inhabited(s_std$col$$col$ops$col$$col$ControlFlow_type(B$0, C$1)) ==
      (inhabited(C$1) || inhabited(B$0)))
  }
  
  axiom inhabited_std$col$$col$convert$col$$col$Infallible {
    inhabited(s_std$col$$col$convert$col$$col$Infallible_type()) == false
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_UInt_u32 {
    inhabited(s_UInt_u32_type()) == true
  }
}

