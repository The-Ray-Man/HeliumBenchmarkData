domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_naive$col$$col$date$col$$col$NaiveDate {
    inhabited(s_naive$col$$col$date$col$$col$NaiveDate_type()) ==
    inhabited(s_std$col$$col$num$col$$col$NonZero_type(s_Int_i32_type()))
  }
  
  axiom inhabited_std$col$$col$num$col$$col$NonZero {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$num$col$$col$NonZero_type(T$0)) }
      inhabited(s_std$col$$col$num$col$$col$NonZero_type(T$0)) ==
      inhabited(std$col$$col$num$col$$col$ZeroablePrimitive_assoc_type_std$col$$col$num$col$$col$ZeroablePrimitive$col$$col$NonZeroInner(T$0)))
  }
  
  axiom inhabited_Int_i32 {
