  axiom s_UInt_u32_ax_bounds {
    (forall s: s_UInt_u32 ::
      { s_UInt_u32_value(s) }
      0 <= s_UInt_u32_value(s) && s_UInt_u32_value(s) <= 4294967295)
  }
  
  axiom s_UInt_u32_ax_value {
    (forall value: Int ::
      { s_UInt_u32_cons(value) }
      0 <= value && value <= 4294967295 ==>
      s_UInt_u32_value(s_UInt_u32_cons(value)) == value)
  }
}

