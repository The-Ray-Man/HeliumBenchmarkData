domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_Array  {
  
  axiom s_Param_typ_def_make_generic_s_Array {
    (forall x: s_Array, U$1: Type, M$0: s_UInt_usize ::
      { make_generic_s_Array(x, U$1, M$0) }
      s_Param_typ(make_generic_s_Array(x, U$1, M$0)) ==
      s_Array_type(U$1, M$0))
  }
  
  axiom s_Param_typ_variant_make_generic_s_Array {
    (forall p: s_Param ::
      { p.make_concrete_s_Array, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_Array_type(s_Param_typ(p).s_Array_typaram_U$1, s_Param_typ(p).s_Array_constparam_M$0) ==>
      make_generic_s_Array(p.make_concrete_s_Array, s_Param_typ(p).s_Array_typaram_U$1, s_Param_typ(p).s_Array_constparam_M$0) ==
      p)
