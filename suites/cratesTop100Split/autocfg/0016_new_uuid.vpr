domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_UInt_u64  {
  
  axiom s_Param_typ_def_make_generic_s_UInt_u64 {
    (forall x: s_UInt_u64 ::
      { make_generic_s_UInt_u64(x) }
      s_Param_typ(make_generic_s_UInt_u64(x)) == s_UInt_u64_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_UInt_u64 {
    (forall p: s_Param ::
      { p.make_concrete_s_UInt_u64, s_Param_typ(p) }
      s_Param_typ(p) == s_UInt_u64_type() ==>
      make_generic_s_UInt_u64(p.make_concrete_s_UInt_u64) == p)
  }
}

