domain s_UInt_u64  {
  
  function s_UInt_u64_cons(arg0: Int): s_UInt_u64 
  
  function s_UInt_u64_value(arg0: s_UInt_u64): Int 
  
  axiom s_UInt_u64_ax_cons {
    (forall s: s_UInt_u64 ::
      { s_UInt_u64_value(s) }
      s_UInt_u64_cons(s_UInt_u64_value(s)) == s)
  }
  
  axiom s_UInt_u64_ax_bounds {
    (forall s: s_UInt_u64 ::
      { s_UInt_u64_value(s) }
      0 <= s_UInt_u64_value(s) &&
      s_UInt_u64_value(s) <= 18446744073709551615)
  }
  
  axiom s_UInt_u64_ax_value {
    (forall value: Int ::
      { s_UInt_u64_cons(value) }
      0 <= value && value <= 18446744073709551615 ==>
      s_UInt_u64_value(s_UInt_u64_cons(value)) == value)
  }
}

