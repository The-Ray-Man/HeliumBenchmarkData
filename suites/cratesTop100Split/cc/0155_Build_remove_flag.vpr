domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_Build  {
  
  axiom s_Param_typ_def_make_generic_s_Build {
    (forall x: s_Build ::
      { make_generic_s_Build(x) }
      s_Param_typ(make_generic_s_Build(x)) == s_Build_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_Build {
    (forall p: s_Param ::
      { p.make_concrete_s_Build, s_Param_typ(p) }
      s_Param_typ(p) == s_Build_type() ==>
      make_generic_s_Build(p.make_concrete_s_Build) == p)
  }
}

