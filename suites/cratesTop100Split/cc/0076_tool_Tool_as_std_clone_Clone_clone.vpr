  function s_UInt_u8_value(arg0: s_UInt_u8): Int 
  
  axiom s_UInt_u8_ax_cons {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      s_UInt_u8_cons(s_UInt_u8_value(s)) == s)
  }
  
  axiom s_UInt_u8_ax_bounds {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      0 <= s_UInt_u8_value(s) && s_UInt_u8_value(s) <= 255)
  }
  
  axiom s_UInt_u8_ax_value {
    (forall value: Int ::
      { s_UInt_u8_cons(value) }
      0 <= value && value <= 255 ==>
      s_UInt_u8_value(s_UInt_u8_cons(value)) == value)
  }
}

domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_std$col$$col$marker$col$$col$PhantomData {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) }
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0)) ==
      true)
  }
  
  axiom inhabited_std$col$$col$ptr$col$$col$Unique {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) }
      inhabited(s_std$col$$col$ptr$col$$col$Unique_type(T$0)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$NonNull_type(T$0)) &&
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit {
    inhabited(s_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit_type()) ==
    inhabited(s_UInt_usize_type())
  }
  
  axiom inhabited_alloc$col$$col$raw_vec$col$$col$RawVecInner {
    (forall A$0: Type ::
      { inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVecInner_type(A$0)) }
      inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVecInner_type(A$0)) ==
      (inhabited(s_std$col$$col$ptr$col$$col$Unique_type(s_UInt_u8_type())) &&
      (inhabited(s_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit_type()) &&
      inhabited(A$0))))
  }
  
  axiom inhabited_alloc$col$$col$raw_vec$col$$col$RawVec {
    (forall T$0: Type, A$1: Type ::
      { inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVec_type(T$0, A$1)) }
      inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVec_type(T$0, A$1)) ==
      (inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVecInner_type(A$1)) &&
      inhabited(s_std$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_std$col$$col$vec$col$$col$Vec {
    (forall T$0: Type, A$1: Type ::
      { inhabited(s_std$col$$col$vec$col$$col$Vec_type(T$0, A$1)) }
      inhabited(s_std$col$$col$vec$col$$col$Vec_type(T$0, A$1)) ==
      (inhabited(s_alloc$col$$col$raw_vec$col$$col$RawVec_type(T$0, A$1)) &&
      inhabited(s_UInt_usize_type())))
  }
  
  axiom inhabited_std$col$$col$alloc$col$$col$Global {
    inhabited(s_std$col$$col$alloc$col$$col$Global_type()) == true
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_alloc$col$$col$wtf8$col$$col$Wtf8Buf {
    inhabited(s_alloc$col$$col$wtf8$col$$col$Wtf8Buf_type()) ==
    (inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_UInt_u8_type(), s_std$col$$col$alloc$col$$col$Global_type())) &&
    inhabited(s_Bool_type()))
  }
  
  axiom inhabited_std$col$$col$sys$col$$col$os_str$col$$col$wtf8$col$$col$Buf {
    inhabited(s_std$col$$col$sys$col$$col$os_str$col$$col$wtf8$col$$col$Buf_type()) ==
    inhabited(s_alloc$col$$col$wtf8$col$$col$Wtf8Buf_type())
  }
  
  axiom inhabited_std$col$$col$ffi$col$$col$OsString {
    inhabited(s_std$col$$col$ffi$col$$col$OsString_type()) ==
    inhabited(s_std$col$$col$sys$col$$col$os_str$col$$col$wtf8$col$$col$Buf_type())
  }
  
  axiom inhabited_std$col$$col$path$col$$col$PathBuf {
    inhabited(s_std$col$$col$path$col$$col$PathBuf_type()) ==
    inhabited(s_std$col$$col$ffi$col$$col$OsString_type())
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_2_Tuple {
    (forall T$0: Type, U$1: Type ::
      { inhabited(s_2_Tuple_type(T$0, U$1)) }
      inhabited(s_2_Tuple_type(T$0, U$1)) ==
      (inhabited(T$0) && inhabited(U$1)))
  }
  
  axiom inhabited_tool$col$$col$ToolFamily {
    inhabited(s_tool$col$$col$ToolFamily_type()) ==
    (true || (inhabited(s_Bool_type()) || inhabited(s_Bool_type())))
  }
  
  axiom inhabited_tool$col$$col$Tool {
    inhabited(s_tool$col$$col$Tool_type()) ==
    (inhabited(s_std$col$$col$path$col$$col$PathBuf_type()) &&
    inhabited(s_std$col$$col$option$col$$col$Option_type(s_std$col$$col$path$col$$col$PathBuf_type())) &&
    (inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_std$col$$col$ffi$col$$col$OsString_type(), s_std$col$$col$alloc$col$$col$Global_type())) &&
    inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_std$col$$col$ffi$col$$col$OsString_type(), s_std$col$$col$alloc$col$$col$Global_type()))) &&
    (inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_2_Tuple_type(s_std$col$$col$ffi$col$$col$OsString_type(), s_std$col$$col$ffi$col$$col$OsString_type()), s_std$col$$col$alloc$col$$col$Global_type())) &&
    inhabited(s_tool$col$$col$ToolFamily_type()) &&
    (inhabited(s_Bool_type()) &&
    (inhabited(s_std$col$$col$vec$col$$col$Vec_type(s_std$col$$col$ffi$col$$col$OsString_type(), s_std$col$$col$alloc$col$$col$Global_type())) &&
    inhabited(s_Bool_type())))))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
}

