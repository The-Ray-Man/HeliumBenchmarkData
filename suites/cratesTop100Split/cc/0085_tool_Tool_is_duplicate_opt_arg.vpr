    (forall x: s_tool$col$$col$Tool ::
      { make_generic_s_tool$col$$col$Tool(x) }
      s_Param_typ(make_generic_s_tool$col$$col$Tool(x)) ==
      s_tool$col$$col$Tool_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_tool$col$$col$Tool {
    (forall p: s_Param ::
      { p.make_concrete_s_tool$col$$col$Tool, s_Param_typ(p) }
      s_Param_typ(p) == s_tool$col$$col$Tool_type() ==>
      make_generic_s_tool$col$$col$Tool(p.make_concrete_s_tool$col$$col$Tool) ==
      p)
  }
}

