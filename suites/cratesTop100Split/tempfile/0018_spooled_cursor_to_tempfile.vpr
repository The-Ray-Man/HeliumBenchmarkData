domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_std$col$$col$fs$col$$col$File  {
  
  axiom s_Param_typ_def_make_generic_s_std$col$$col$fs$col$$col$File {
    (forall x: s_std$col$$col$fs$col$$col$File ::
      { make_generic_s_std$col$$col$fs$col$$col$File(x) }
      s_Param_typ(make_generic_s_std$col$$col$fs$col$$col$File(x)) ==
      s_std$col$$col$fs$col$$col$File_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_std$col$$col$fs$col$$col$File {
    (forall p: s_Param ::
      { p.make_concrete_s_std$col$$col$fs$col$$col$File, s_Param_typ(p) }
      s_Param_typ(p) == s_std$col$$col$fs$col$$col$File_type() ==>
      make_generic_s_std$col$$col$fs$col$$col$File(p.make_concrete_s_std$col$$col$fs$col$$col$File) ==
      p)
  }
}

