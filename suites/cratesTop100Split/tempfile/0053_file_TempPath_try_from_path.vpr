      s_Param_typ(make_generic_s_file$col$$col$TempPath(x)) ==
      s_file$col$$col$TempPath_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_file$col$$col$TempPath {
    (forall p: s_Param ::
      { p.make_concrete_s_file$col$$col$TempPath, s_Param_typ(p) }
      s_Param_typ(p) == s_file$col$$col$TempPath_type() ==>
      make_generic_s_file$col$$col$TempPath(p.make_concrete_s_file$col$$col$TempPath) ==
      p)
  }
}

