domain UnsizeValueCastArraySlice  {
  
  axiom unsize_value_cast_array_slice {
    (forall arr: s_Array, U$1: Type, M$0: s_UInt_usize ::
      { unsize_value_cast(make_generic_s_Array(arr, U$1, M$0), s_Array_type(U$1, M$0),
      s_Slice_type(U$1)) }
      (forall idx: Int ::
        { s_Array_index(arr, idx) }
        s_Array_index(arr, idx) ==
        s_Slice_index(unsize_value_cast(make_generic_s_Array(arr, U$1, M$0),
        s_Array_type(U$1, M$0), s_Slice_type(U$1)).make_concrete_s_Slice, idx)))
  }
}

