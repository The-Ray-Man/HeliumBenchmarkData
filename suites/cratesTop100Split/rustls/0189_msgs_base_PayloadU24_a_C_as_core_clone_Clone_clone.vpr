  axiom inhabited_core$col$$col$ptr$col$$col$Unique {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$ptr$col$$col$Unique_type(T$0)) }
      inhabited(s_core$col$$col$ptr$col$$col$Unique_type(T$0)) ==
      (inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) &&
      inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(T$0))))
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit {
    inhabited(s_core$col$$col$num$col$$col$niche_types$col$$col$UsizeNoHighBit_type()) ==
