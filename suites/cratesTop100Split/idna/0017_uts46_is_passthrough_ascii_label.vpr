domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_2_Tuple {
    (forall T$0: Type, U$1: Type ::
      { inhabited(s_2_Tuple_type(T$0, U$1)) }
      inhabited(s_2_Tuple_type(T$0, U$1)) ==
      (inhabited(T$0) && inhabited(U$1)))
  }
  
  axiom inhabited_RawPtr_immutable {
    (forall T$0: Type ::
      { inhabited(s_RawPtr_immutable_type(T$0)) }
      inhabited(s_RawPtr_immutable_type(T$0)) == true)
  }
  
  axiom inhabited_core$col$$col$ptr$col$$col$NonNull {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) }
      inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$0)) ==
      inhabited(s_RawPtr_immutable_type(T$0)))
  }
  
  axiom inhabited_core$col$$col$marker$col$$col$PhantomData {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(T$0)) }
      inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(T$0)) ==
      true)
  }
  
  axiom inhabited_core$col$$col$slice$col$$col$Iter {
    (forall T$1: Type ::
      { inhabited(s_core$col$$col$slice$col$$col$Iter_type(T$1)) }
      inhabited(s_core$col$$col$slice$col$$col$Iter_type(T$1)) ==
      (inhabited(s_core$col$$col$ptr$col$$col$NonNull_type(T$1)) &&
      (inhabited(s_RawPtr_immutable_type(T$1)) &&
      inhabited(s_core$col$$col$marker$col$$col$PhantomData_type(s_Ref_immutable_type(T$1))))))
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Item {
    (forall A$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$Item_type(A$0)) }
      inhabited(s_core$col$$col$option$col$$col$Item_type(A$0)) ==
      inhabited(s_core$col$$col$option$col$$col$Option_type(A$0)))
  }
  
  axiom inhabited_core$col$$col$option$col$$col$IntoIter {
    (forall A$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$IntoIter_type(A$0)) }
      inhabited(s_core$col$$col$option$col$$col$IntoIter_type(A$0)) ==
      inhabited(s_core$col$$col$option$col$$col$Item_type(A$0)))
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Iter {
    (forall A$1: Type ::
