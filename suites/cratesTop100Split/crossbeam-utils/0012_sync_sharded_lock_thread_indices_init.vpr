      0 <= s_UInt_usize_value(s) &&
      s_UInt_usize_value(s) <= 18446744073709551615)
  }
  
  axiom s_UInt_usize_ax_value {
    (forall value: Int ::
      { s_UInt_usize_cons(value) }
      0 <= value && value <= 18446744073709551615 ==>
      s_UInt_usize_value(s_UInt_usize_cons(value)) == value)
  }
