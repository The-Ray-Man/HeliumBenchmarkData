domain s_UInt_u8  {
  
  function s_UInt_u8_cons(arg0: Int): s_UInt_u8 
  
  function s_UInt_u8_value(arg0: s_UInt_u8): Int 
  
  axiom s_UInt_u8_ax_cons {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      s_UInt_u8_cons(s_UInt_u8_value(s)) == s)
  }
  
  axiom s_UInt_u8_ax_bounds {
    (forall s: s_UInt_u8 ::
      { s_UInt_u8_value(s) }
      0 <= s_UInt_u8_value(s) && s_UInt_u8_value(s) <= 255)
  }
  
  axiom s_UInt_u8_ax_value {
    (forall value: Int ::
      { s_UInt_u8_cons(value) }
      0 <= value && value <= 255 ==>
      s_UInt_u8_value(s_UInt_u8_cons(value)) == value)
  }
}

domain s_Char  {
  
  function s_Char_cons(arg0: Int): s_Char 
  
  function s_Char_value(arg0: s_Char): Int 
  
  axiom s_Char_ax_cons {
    (forall s: s_Char ::
      { s_Char_value(s) }
      s_Char_cons(s_Char_value(s)) == s)
  }
  
  axiom s_Char_ax_value {
    (forall value: Int ::
      { s_Char_cons(value) }
      s_Char_value(s_Char_cons(value)) == value)
  }
}

