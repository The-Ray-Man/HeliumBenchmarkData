domain ParamTyp  {
  
  function s_Param_typ(arg0: s_Param): Type 
  
  function s_Param_has_typ(arg0: s_Param, arg1: Type): Bool 
  
  axiom s_Param_has_typ_own {
    (forall p: s_Param ::
      { s_Param_typ(p) }
      s_Param_has_typ(p, s_Param_typ(p)))
  }
}

domain ParamTyp_make_generic_s_std$col$$col$vec$col$$col$Vec  {
  
  axiom s_Param_typ_def_make_generic_s_std$col$$col$vec$col$$col$Vec {
    (forall x: s_std$col$$col$vec$col$$col$Vec, T$0: Type, A$1: Type ::
      { make_generic_s_std$col$$col$vec$col$$col$Vec(x, T$0, A$1) }
      s_Param_typ(make_generic_s_std$col$$col$vec$col$$col$Vec(x, T$0, A$1)) ==
      s_std$col$$col$vec$col$$col$Vec_type(T$0, A$1))
  }
  
  axiom s_Param_typ_variant_make_generic_s_std$col$$col$vec$col$$col$Vec {
    (forall p: s_Param ::
      { p.make_concrete_s_std$col$$col$vec$col$$col$Vec, s_Param_typ(p) }
      s_Param_typ(p) ==
      s_std$col$$col$vec$col$$col$Vec_type(s_Param_typ(p).s_std$col$$col$vec$col$$col$Vec_typaram_T$0, s_Param_typ(p).s_std$col$$col$vec$col$$col$Vec_typaram_A$1) ==>
      make_generic_s_std$col$$col$vec$col$$col$Vec(p.make_concrete_s_std$col$$col$vec$col$$col$Vec, s_Param_typ(p).s_std$col$$col$vec$col$$col$Vec_typaram_T$0, s_Param_typ(p).s_std$col$$col$vec$col$$col$Vec_typaram_A$1) ==
      p)
  }
}

