    (forall T$0: Type, E$1: Type ::
      { inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) }
      inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) ==
      (inhabited(T$0) || inhabited(E$1)))
  }
  
  axiom inhabited_std$col$$col$borrow$col$$col$Cow {
    (forall B$1: Type ::
      { inhabited(s_std$col$$col$borrow$col$$col$Cow_type(B$1)) }
      inhabited(s_std$col$$col$borrow$col$$col$Cow_type(B$1)) ==
      (inhabited(s_Ref_immutable_type(B$1)) ||
      inhabited(std$col$$col$borrow$col$$col$ToOwned_assoc_type_std$col$$col$borrow$col$$col$ToOwned$col$$col$Owned(B$1))))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
  
  axiom inhabited_QuoteError {
    inhabited(s_QuoteError_type()) == true
  }
  
  axiom inhabited_Quoter {
    inhabited(s_Quoter_type()) == inhabited(s_bytes$col$$col$Quoter_type())
  }
  
  axiom inhabited_bytes$col$$col$Quoter {
    inhabited(s_bytes$col$$col$Quoter_type()) == inhabited(s_Bool_type())
