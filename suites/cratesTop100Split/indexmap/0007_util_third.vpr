function s_3_Tuple_field_1(self: Ref, T$0: Type, U$1: Type, V$2: Type): Ref
  ensures (self == null) == (result == null)


function s_3_Tuple_field_2(self: Ref, T$0: Type, U$1: Type, V$2: Type): Ref
  ensures (self == null) == (result == null)


