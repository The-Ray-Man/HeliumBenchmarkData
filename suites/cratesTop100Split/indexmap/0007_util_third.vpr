predicate p_Param(self: Ref, T$0: Type) 

predicate p_3_Tuple(self: Ref, T$0: Type, U$1: Type, V$2: Type) {
  inhabited(T$0) &&
  acc(p_Param(s_3_Tuple_field_0(self, T$0, U$1, V$2), T$0), write) &&
