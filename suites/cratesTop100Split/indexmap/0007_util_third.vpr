    s_3_Tuple_cons(p_Param_snap(s_3_Tuple_field_0(self, T$0, U$1, V$2), T$0), p_Param_snap(s_3_Tuple_field_1(self,
    T$0, U$1, V$2), U$1), p_Param_snap(s_3_Tuple_field_2(self, T$0, U$1, V$2),
    V$2)))
