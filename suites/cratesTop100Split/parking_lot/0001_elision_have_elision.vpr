domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
}

domain trait_std$col$$col$marker$col$$col$Sized  {
  
  function std$col$$col$marker$col$$col$Sized_impl(arg0: Type): Bool 
}

domain trait_std$col$$col$marker$col$$col$MetaSized  {
  
  function std$col$$col$marker$col$$col$MetaSized_impl(arg0: Type): Bool 
}

domain sizedness_Bool  {
  
  axiom s_Bool_Sized {
    std$col$$col$marker$col$$col$Sized_impl(s_Bool_type())
  }
  
  axiom s_Bool_MetaSized {
    std$col$$col$marker$col$$col$MetaSized_impl(s_Bool_type())
  }
}

field p_Bool_val: Bool

function s_Bool_unreachable(): Bool
  ensures false


function p_Bool_snap(self: Ref): Bool
  requires acc(p_Bool(self), write)
{
  (unfolding acc(p_Bool(self), write) in self.p_Bool_val)
}

predicate p_Bool(self: Ref) {
  acc(self.p_Bool_val, write)
}

method m_elision$col$$col$have_elision(_0p: Ref)
  ensures inhabited(s_Bool_type()) && acc(p_Bool(_0p), write)
{
  label start
  goto bb_0
  label bb_0
  label _before_0_0
  p_Bool_assign(_0p, false)
  label _before_0_1
  label package_post0
  goto end
  label end
}

method p_Bool_assign(self: Ref, value: Bool)
  ensures acc(p_Bool(self), write)
  ensures p_Bool_snap(self) == value


adt s_Param {
  s_Param_Unknown(s_Param_Unknown_id: Int)
}

adt Type {
  s_Bool_type()
  Unknown_type(id: Int)
}