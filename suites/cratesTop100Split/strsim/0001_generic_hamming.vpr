      { s_UInt_usize_value(s) }
      0 <= s_UInt_usize_value(s) &&
      s_UInt_usize_value(s) <= 18446744073709551615)
  }
  
  axiom s_UInt_usize_ax_value {
    (forall value: Int ::
      { s_UInt_usize_cons(value) }
      0 <= value && value <= 18446744073709551615 ==>
      s_UInt_usize_value(s_UInt_usize_cons(value)) == value)
  }
}

domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_std$col$$col$result$col$$col$Result {
    (forall T$0: Type, E$1: Type ::
      { inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) }
      inhabited(s_std$col$$col$result$col$$col$Result_type(T$0, E$1)) ==
      (inhabited(T$0) || inhabited(E$1)))
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_StrSimError {
    inhabited(s_StrSimError_type()) == true
  }
  
  axiom inhabited_2_Tuple {
    (forall T$0: Type, U$1: Type ::
      { inhabited(s_2_Tuple_type(T$0, U$1)) }
      inhabited(s_2_Tuple_type(T$0, U$1)) ==
      (inhabited(T$0) && inhabited(U$1)))
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Item {
    (forall A$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)) }
      inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)) ==
      inhabited(s_std$col$$col$option$col$$col$Option_type(A$0)))
  }
  
  axiom inhabited_std$col$$col$option$col$$col$IntoIter {
    (forall A$0: Type ::
      { inhabited(s_std$col$$col$option$col$$col$IntoIter_type(A$0)) }
      inhabited(s_std$col$$col$option$col$$col$IntoIter_type(A$0)) ==
      inhabited(s_std$col$$col$option$col$$col$Item_type(A$0)))
  }
  
  axiom inhabited_std$col$$col$result$col$$col$IntoIter {
    (forall T$0: Type ::
      { inhabited(s_std$col$$col$result$col$$col$IntoIter_type(T$0)) }
      inhabited(s_std$col$$col$result$col$$col$IntoIter_type(T$0)) ==
      inhabited(s_std$col$$col$option$col$$col$Option_type(T$0)))
  }
  
  axiom inhabited_std$col$$col$option$col$$col$Iter {
    (forall A$1: Type ::
      { inhabited(s_std$col$$col$option$col$$col$Iter_type(A$1)) }
