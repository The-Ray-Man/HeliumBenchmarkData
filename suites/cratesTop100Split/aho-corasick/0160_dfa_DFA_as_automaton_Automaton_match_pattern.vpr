    (inhabited(s_core$col$$col$option$col$$col$Option_type(s_util$col$$col$prefilter$col$$col$Prefilter_type())) &&
    inhabited(s_util$col$$col$search$col$$col$MatchKind_type()))) &&
    (inhabited(s_UInt_usize_type()) &&
    (inhabited(s_UInt_usize_type()) && inhabited(s_UInt_usize_type())) &&
    (inhabited(s_util$col$$col$alphabet$col$$col$ByteClasses_type()) &&
