    (forall x: s_dfa$col$$col$DFA ::
      { make_generic_s_dfa$col$$col$DFA(x) }
      s_Param_typ(make_generic_s_dfa$col$$col$DFA(x)) ==
      s_dfa$col$$col$DFA_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_dfa$col$$col$DFA {
    (forall p: s_Param ::
      { p.make_concrete_s_dfa$col$$col$DFA, s_Param_typ(p) }
      s_Param_typ(p) == s_dfa$col$$col$DFA_type() ==>
      make_generic_s_dfa$col$$col$DFA(p.make_concrete_s_dfa$col$$col$DFA) ==
      p)
  }
}

