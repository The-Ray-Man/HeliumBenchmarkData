  }
  
  axiom inhabited_UInt_u16 {
    inhabited(s_UInt_u16_type()) == true
  }
  
  axiom inhabited_util$col$$col$prefilter$col$$col$RareBytesBuilder {
    inhabited(s_util$col$$col$prefilter$col$$col$RareBytesBuilder_type()) ==
