domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_core$col$$col$iter$col$$col$FromFn {
    (forall F$0: Type ::
      { inhabited(s_core$col$$col$iter$col$$col$FromFn_type(F$0)) }
      inhabited(s_core$col$$col$iter$col$$col$FromFn_type(F$0)) ==
      inhabited(F$0))
  }
  
  axiom inhabited_nfa$col$$col$contiguous$col$$col$State$col$$col$$lt$$sq$a$gt$$col$$col$transitions$col$$col$$lc$closure$oc$0$rc$ {
    inhabited(s_nfa$col$$col$contiguous$col$$col$State$col$$col$$lt$$sq$a$gt$$col$$col$transitions$col$$col$$lc$closure$oc$0$rc$_type()) ==
    (inhabited(s_Ref_immutable_type(s_nfa$col$$col$contiguous$col$$col$State_type())) &&
    inhabited(s_UInt_usize_type()))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_nfa$col$$col$contiguous$col$$col$State {
    inhabited(s_nfa$col$$col$contiguous$col$$col$State_type()) ==
    (inhabited(s_util$col$$col$primitives$col$$col$StateID_type()) &&
    (inhabited(s_UInt_usize_type()) &&
    inhabited(s_nfa$col$$col$contiguous$col$$col$StateTrans_type())))
  }
  
  axiom inhabited_util$col$$col$primitives$col$$col$StateID {
    inhabited(s_util$col$$col$primitives$col$$col$StateID_type()) ==
    inhabited(s_util$col$$col$primitives$col$$col$SmallIndex_type())
  }
  
  axiom inhabited_util$col$$col$primitives$col$$col$SmallIndex {
    inhabited(s_util$col$$col$primitives$col$$col$SmallIndex_type()) ==
    inhabited(s_UInt_u32_type())
  }
  
  axiom inhabited_UInt_u32 {
    inhabited(s_UInt_u32_type()) == true
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_nfa$col$$col$contiguous$col$$col$StateTrans {
    inhabited(s_nfa$col$$col$contiguous$col$$col$StateTrans_type()) ==
    (inhabited(s_Ref_immutable_type(s_Slice_type(s_UInt_u32_type()))) &&
    inhabited(s_Ref_immutable_type(s_Slice_type(s_UInt_u32_type()))) ||
    (inhabited(s_UInt_u8_type()) && inhabited(s_UInt_u32_type()) ||
    inhabited(s_Ref_immutable_type(s_Slice_type(s_UInt_u32_type())))))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_2_Tuple {
    (forall T$0: Type, U$1: Type ::
      { inhabited(s_2_Tuple_type(T$0, U$1)) }
      inhabited(s_2_Tuple_type(T$0, U$1)) ==
      (inhabited(T$0) && inhabited(U$1)))
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_0_Tuple {
    inhabited(s_0_Tuple_type()) == true
  }
  
  axiom inhabited_Bool {
    inhabited(s_Bool_type()) == true
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_Array {
    (forall U$1: Type, M$0: s_UInt_usize ::
      { inhabited(s_Array_type(U$1, M$0)) }
      inhabited(s_Array_type(U$1, M$0)) ==
      (M$0 == s_UInt_usize_cons(0) || inhabited(U$1)))
  }
}

