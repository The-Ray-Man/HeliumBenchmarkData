    (forall x: s_dfa$col$$col$Builder ::
      { make_generic_s_dfa$col$$col$Builder(x) }
      s_Param_typ(make_generic_s_dfa$col$$col$Builder(x)) ==
      s_dfa$col$$col$Builder_type())
