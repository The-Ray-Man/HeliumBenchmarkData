  axiom s_Param_typ_variant_make_generic_s_dfa$col$$col$Builder {
    (forall p: s_Param ::
      { p.make_concrete_s_dfa$col$$col$Builder, s_Param_typ(p) }
      s_Param_typ(p) == s_dfa$col$$col$Builder_type() ==>
      make_generic_s_dfa$col$$col$Builder(p.make_concrete_s_dfa$col$$col$Builder) ==
