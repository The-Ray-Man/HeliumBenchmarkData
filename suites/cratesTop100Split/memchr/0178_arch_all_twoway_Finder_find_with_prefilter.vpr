    inhabited(s_memmem$col$$col$searcher$col$$col$Pre_type()) ==
    (inhabited(s_Ref_mutable_type(s_memmem$col$$col$searcher$col$$col$PrefilterState_type())) &&
    inhabited(s_Ref_immutable_type(s_memmem$col$$col$searcher$col$$col$Prefilter_type())))
  }
  
  axiom inhabited_Ref_mutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_mutable_type(U$1)) }
      inhabited(s_Ref_mutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$PrefilterState {
    inhabited(s_memmem$col$$col$searcher$col$$col$PrefilterState_type()) ==
    (inhabited(s_UInt_u32_type()) && inhabited(s_UInt_u32_type()))
  }
  
  axiom inhabited_UInt_u32 {
    inhabited(s_UInt_u32_type()) == true
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$Prefilter {
    inhabited(s_memmem$col$$col$searcher$col$$col$Prefilter_type()) ==
    (inhabited(s_FnPtr_type()) &&
    inhabited(s_memmem$col$$col$searcher$col$$col$PrefilterKind_type()) &&
    (inhabited(s_UInt_u8_type()) && inhabited(s_UInt_u8_type())))
  }
  
  axiom inhabited_FnPtr {
    inhabited(s_FnPtr_type()) == true
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$PrefilterKind {
    inhabited(s_memmem$col$$col$searcher$col$$col$PrefilterKind_type()) ==
    true
  }
  
  axiom inhabited_UInt_u8 {
