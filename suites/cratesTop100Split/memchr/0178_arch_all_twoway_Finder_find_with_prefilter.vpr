  axiom inhabited_arch$col$$col$all$col$$col$twoway$col$$col$ApproximateByteSet {
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$ApproximateByteSet_type()) ==
    inhabited(s_UInt_u64_type())
  }
  
  axiom inhabited_UInt_u64 {
    inhabited(s_UInt_u64_type()) == true
  }
  
  axiom inhabited_arch$col$$col$all$col$$col$twoway$col$$col$Shift {
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$Shift_type()) ==
    (inhabited(s_UInt_usize_type()) || inhabited(s_UInt_usize_type()))
  }
  
