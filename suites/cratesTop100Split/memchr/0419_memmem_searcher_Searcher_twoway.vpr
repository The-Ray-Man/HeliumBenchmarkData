domain Inhabited  {
  
  function inhabited(arg0: Type): Bool 
  
  axiom inhabited_FnPtr {
    inhabited(s_FnPtr_type()) == true
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$SearcherKind {
    inhabited(s_memmem$col$$col$searcher$col$$col$SearcherKind_type()) ==
    true
  }
  
  axiom inhabited_UInt_u32 {
    inhabited(s_UInt_u32_type()) == true
  }
  
  axiom inhabited_arch$col$$col$all$col$$col$rabinkarp$col$$col$Hash {
    inhabited(s_arch$col$$col$all$col$$col$rabinkarp$col$$col$Hash_type()) ==
    inhabited(s_UInt_u32_type())
  }
  
  axiom inhabited_arch$col$$col$all$col$$col$rabinkarp$col$$col$Finder {
    inhabited(s_arch$col$$col$all$col$$col$rabinkarp$col$$col$Finder_type()) ==
    (inhabited(s_arch$col$$col$all$col$$col$rabinkarp$col$$col$Hash_type()) &&
    inhabited(s_UInt_u32_type()))
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$Searcher {
    inhabited(s_memmem$col$$col$searcher$col$$col$Searcher_type()) ==
    (inhabited(s_FnPtr_type()) &&
    (inhabited(s_memmem$col$$col$searcher$col$$col$SearcherKind_type()) &&
    inhabited(s_arch$col$$col$all$col$$col$rabinkarp$col$$col$Finder_type())))
  }
  
  axiom inhabited_Ref_immutable {
    (forall U$1: Type ::
      { inhabited(s_Ref_immutable_type(U$1)) }
      inhabited(s_Ref_immutable_type(U$1)) == inhabited(U$1))
  }
  
  axiom inhabited_Slice {
    (forall T$0: Type ::
      { inhabited(s_Slice_type(T$0)) }
      inhabited(s_Slice_type(T$0)) == true)
  }
  
  axiom inhabited_UInt_u8 {
    inhabited(s_UInt_u8_type()) == true
  }
  
  axiom inhabited_Int_isize {
    inhabited(s_Int_isize_type()) == true
  }
  
  axiom inhabited_core$col$$col$option$col$$col$Option {
    (forall T$0: Type ::
      { inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) }
      inhabited(s_core$col$$col$option$col$$col$Option_type(T$0)) ==
      (true || inhabited(T$0)))
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$Prefilter {
    inhabited(s_memmem$col$$col$searcher$col$$col$Prefilter_type()) ==
    (inhabited(s_FnPtr_type()) &&
    inhabited(s_memmem$col$$col$searcher$col$$col$PrefilterKind_type()) &&
    (inhabited(s_UInt_u8_type()) && inhabited(s_UInt_u8_type())))
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$PrefilterKind {
    inhabited(s_memmem$col$$col$searcher$col$$col$PrefilterKind_type()) ==
    true
  }
  
  axiom inhabited_UInt_u64 {
    inhabited(s_UInt_u64_type()) == true
  }
  
  axiom inhabited_arch$col$$col$all$col$$col$twoway$col$$col$ApproximateByteSet {
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$ApproximateByteSet_type()) ==
    inhabited(s_UInt_u64_type())
  }
  
  axiom inhabited_UInt_usize {
    inhabited(s_UInt_usize_type()) == true
  }
  
  axiom inhabited_arch$col$$col$all$col$$col$twoway$col$$col$Shift {
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$Shift_type()) ==
    (inhabited(s_UInt_usize_type()) || inhabited(s_UInt_usize_type()))
  }
  
  axiom inhabited_arch$col$$col$all$col$$col$twoway$col$$col$TwoWay {
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$TwoWay_type()) ==
    (inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$ApproximateByteSet_type()) &&
    (inhabited(s_UInt_usize_type()) &&
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$Shift_type())))
  }
  
  axiom inhabited_arch$col$$col$all$col$$col$twoway$col$$col$Finder {
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$Finder_type()) ==
    inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$TwoWay_type())
  }
  
  axiom inhabited_Never {
    inhabited(s_Never_type()) == false
  }
  
  axiom inhabited_memmem$col$$col$searcher$col$$col$TwoWayWithPrefilter {
    inhabited(s_memmem$col$$col$searcher$col$$col$TwoWayWithPrefilter_type()) ==
    (inhabited(s_arch$col$$col$all$col$$col$twoway$col$$col$Finder_type()) &&
    inhabited(s_memmem$col$$col$searcher$col$$col$Prefilter_type()))
  }
  
  axiom inhabited_Str {
    inhabited(s_Str_type()) == true
  }
}

