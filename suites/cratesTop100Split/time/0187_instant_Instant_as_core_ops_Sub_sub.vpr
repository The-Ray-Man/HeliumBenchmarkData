  axiom s_Param_typ_def_make_generic_s_Int_i32 {
    (forall x: s_Int_i32 ::
      { make_generic_s_Int_i32(x) }
      s_Param_typ(make_generic_s_Int_i32(x)) == s_Int_i32_type())
  }
  
  axiom s_Param_typ_variant_make_generic_s_Int_i32 {
    (forall p: s_Param ::
      { p.make_concrete_s_Int_i32, s_Param_typ(p) }
      s_Param_typ(p) == s_Int_i32_type() ==>
      make_generic_s_Int_i32(p.make_concrete_s_Int_i32) == p)
  }
}

