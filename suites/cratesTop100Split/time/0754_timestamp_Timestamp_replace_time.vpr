  axiom inhabited_time$col$$col$Time {
    inhabited(s_time$col$$col$Time_type()) ==
    (inhabited(s_deranged$col$$col$RangedU32_type(s_UInt_u32_cons(0), s_UInt_u32_cons(999999999))) &&
    inhabited(s_deranged$col$$col$RangedU8_type(s_UInt_u8_cons(0), s_UInt_u8_cons(59))) &&
    (inhabited(s_deranged$col$$col$RangedU8_type(s_UInt_u8_cons(0), s_UInt_u8_cons(59))) &&
