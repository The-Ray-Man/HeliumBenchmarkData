function mir_binop_AddWithOverflow_UInt_u16_UInt_u16(arg1: s_UInt_u16, arg2: s_UInt_u16): s_2_Tuple
{
  (let val ==
    (s_UInt_u16_value(arg1) + s_UInt_u16_value(arg2)) in
    (let wrapped_val ==
      (val % 65536) in
      s_2_Tuple_cons(make_generic_s_UInt_u16(s_UInt_u16_cons(wrapped_val)), make_generic_s_Bool(wrapped_val !=
      val))))
}

